# Block all PHP files — this is a static site (Astro SSG)
<FilesMatch "\.php$">
  Require all denied
</FilesMatch>

# Force index.php to 404 (remove PrestaShop traces)
RewriteEngine On
RewriteRule ^index\.php$ - [R=404,L]

# ==========================================
# Legacy PrestaShop URL redirects (GSC 404s)
# ==========================================

# Old blog URLs: /?post_url_alias=X&... → /blog/X
RewriteCond %{QUERY_STRING} ^post_url_alias=([^&]+)
RewriteRule ^$ /blog/%1? [R=301,L,NE]

# PS module blog listing: /?id_shop=1&rewrite=blog&fc=module → /blog
RewriteCond %{QUERY_STRING} rewrite=blog
RewriteRule ^$ /blog? [R=301,L]

# Latest posts: /?rewrite=dernier&latest=true → /blog
RewriteCond %{QUERY_STRING} rewrite=dernier
RewriteRule ^$ /blog? [R=301,L]

# Old PS search URLs: /?s=X&fc=module → 410 Gone (these are PS internal search garbage)
RewriteCond %{QUERY_STRING} ^s=
RewriteRule ^$ - [G,L]

# PS module ajax endpoints: /module/X/Y → 410 Gone
RewriteCond %{QUERY_STRING} fc=module
RewriteRule ^$ - [G,L]

# Any remaining ?fc=module on root → 410 Gone
RewriteRule ^module/ - [G,L]

# Missing files / paths → real 404 (was silently rewriting to /404.html
# with HTTP 200, which created a soft-404 trap: every typo URL got
# indexed by Google as a live page, and missing brand logos served the
# 404 page as text/html with 200).
ErrorDocument 404 /404.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [L,R=404]

# Security headers
<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# ==========================================
# Cache-Control + Expires for static assets
# ==========================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Images — 1 year (content-hashed paths)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts — 1 year
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # Astro hashed assets (_astro/*) — 1 year (filename contains content hash)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # HTML — short cache (always revalidate for SSG updates)
  ExpiresByType text/html "access plus 1 hour"

  # XML/JSON — short cache
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Immutable cache for hashed Astro assets
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "_astro/.*\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML: always revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# Enable gzip/brotli compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain text/xml application/xml
</IfModule>

# Remove PHP handler for this directory
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
