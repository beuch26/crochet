---
import Layout from '../layouts/Layout.astro'
import SchemaBreadcrumb from '../components/seo/SchemaBreadcrumb.astro'
---

<Layout title="Contactez-nous — Service client" description="Une question sur votre commande ou nos produits bebe et maman ? Contactez l'equipe Magic Crochet Kit. Reponse sous 24h.">
  <SchemaBreadcrumb slot="head" items={[{ name: 'Magic Crochet Kit', url: '/' }, { name: 'Contact', url: '/contact/' }]} />
  <section class="py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-8 text-sm text-text-muted flex items-center gap-2">
        <a href="/" class="hover:text-primary transition-colors">Magic Crochet Kit</a>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        <span class="text-text">Contact</span>
      </nav>
      <div class="text-center mb-12">
        <h1>Contactez-nous</h1>
        <p class="mt-4 text-text-light text-lg">Une question ? N'hésitez pas à nous écrire.</p>
      </div>

      <div id="contact-success" class="hidden mb-8 p-6 bg-success/10 border border-success/20 rounded-2xl text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-success mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-lg font-semibold text-text mb-1">Message envoyé !</h3>
        <p class="text-sm text-text-light">Nous vous répondrons dans les plus brefs délais.</p>
      </div>

      <div id="contact-error" class="hidden mb-6 p-4 bg-error/10 text-error text-sm rounded-xl"></div>

      <form id="contact-form" class="space-y-6">
        <div>
          <label for="subject" class="block text-sm font-medium text-text mb-2">Sujet</label>
          <select id="subject" name="subject" class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
            <option value="Service client">Service client</option>
            <option value="Question produit">Question sur un produit</option>
            <option value="Commande">Suivi de commande</option>
            <option value="Retour">Retour / Échange</option>
            <option value="Partenariat">Partenariat</option>
            <option value="Autre">Autre</option>
          </select>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-medium text-text mb-2">Nom</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-text mb-2">Email</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
          </div>
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-text mb-2">Message</label>
          <textarea id="message" name="message" rows="6" required class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all resize-none"></textarea>
        </div>
        <button type="submit" id="contact-btn" class="btn btn-primary w-full sm:w-auto px-10 py-3.5">
          Envoyer le message
        </button>
      </form>

      <div class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-bg-light text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mx-auto text-primary mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
          <h2 class="text-base font-semibold font-['DM_Sans'] mb-2">Adresse</h3>
          <p class="text-sm text-text-light">TN GROUP<br />6 Rue d'Armaille<br />75017 Paris</p>
        </div>
        <div class="p-6 rounded-2xl bg-bg-light text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mx-auto text-primary mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
          <h2 class="text-base font-semibold font-['DM_Sans'] mb-2">Email</h3>
          <a href="mailto:contact@magic-crochet-kit.com" class="text-primary hover:underline text-sm">contact@magic-crochet-kit.com</a>
        </div>
        <div class="p-6 rounded-2xl bg-bg-light text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mx-auto text-primary mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          <h2 class="text-base font-semibold font-['DM_Sans'] mb-2">Téléphone</h3>
          <a href="tel:0951761711" class="text-primary hover:underline text-sm">09 51 76 17 11</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const MEDUSA_URL = document.querySelector('meta[name="medusa-url"]')?.getAttribute('content') || ''
  const API_KEY = document.querySelector('meta[name="medusa-key"]')?.getAttribute('content') || ''

  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const btn = document.getElementById('contact-btn') as HTMLButtonElement
    const errorEl = document.getElementById('contact-error')!
    const successEl = document.getElementById('contact-success')!
    const form = document.getElementById('contact-form') as HTMLFormElement
    errorEl.classList.add('hidden')

    btn.disabled = true
    btn.textContent = 'Envoi en cours...'

    try {
      const res = await fetch(`${MEDUSA_URL}/store/contact`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-publishable-api-key': API_KEY,
        },
        body: JSON.stringify({
          name: (document.getElementById('name') as HTMLInputElement).value,
          email: (document.getElementById('email') as HTMLInputElement).value,
          subject: (document.getElementById('subject') as HTMLSelectElement).value,
          message: (document.getElementById('message') as HTMLTextAreaElement).value,
        }),
      })

      if (!res.ok) throw new Error('Erreur serveur')

      form.classList.add('hidden')
      successEl.classList.remove('hidden')
    } catch (err: any) {
      errorEl.textContent = 'Une erreur est survenue. Veuillez réessayer.'
      errorEl.classList.remove('hidden')
    } finally {
      btn.disabled = false
      btn.textContent = 'Envoyer le message'
    }
  })
</script>
