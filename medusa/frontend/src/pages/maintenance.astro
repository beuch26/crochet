---
/**
 * Password/maintenance page
 * Like Olympus theme's main-password section
 */
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bientôt disponible | Magic Crochet Kit</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'DM Sans', sans-serif;
      background: linear-gradient(135deg, #eff6ff 0%, #ffffff 50%, #f5f3ff 100%);
      color: #1e293b;
    }
    .container { max-width: 480px; padding: 2rem; text-align: center; }
    .logo { font-family: 'DM Serif Display', serif; font-size: 2.5rem; color: #2563eb; margin-bottom: 2rem; }
    h1 { font-family: 'DM Serif Display', serif; font-size: 2rem; margin-bottom: 1rem; }
    p { color: #64748b; line-height: 1.7; margin-bottom: 1.5rem; }
    .password-form { display: flex; gap: 0.5rem; margin-top: 2rem; }
    .password-form input {
      flex: 1; padding: 0.875rem 1.25rem; border: 1px solid #e2e8f0; border-radius: 0.75rem;
      font-size: 0.875rem; outline: none; transition: all 0.2s;
    }
    .password-form input:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
    .password-form button {
      padding: 0.875rem 1.5rem; background: #2563eb; color: white; border: none;
      border-radius: 0.75rem; font-weight: 600; font-size: 0.875rem; cursor: pointer;
      transition: all 0.2s;
    }
    .password-form button:hover { background: #1d4ed8; }
    .error { color: #dc2626; font-size: 0.875rem; margin-top: 0.75rem; display: none; }
    .social { display: flex; gap: 1rem; justify-content: center; margin-top: 3rem; }
    .social a {
      width: 2.5rem; height: 2.5rem; display: flex; align-items: center; justify-content: center;
      border-radius: 0.75rem; background: rgba(37,99,235,0.05); color: #64748b;
      transition: all 0.2s;
    }
    .social a:hover { background: #2563eb; color: white; }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">Magic Crochet Kit</div>
    <h1>Bientôt disponible</h1>
    <p>
      Nous travaillons dur pour vous proposer la meilleure expérience possible.
      Entrez le mot de passe pour accéder au site en avant-première.
    </p>

    <form class="password-form" id="pw-form">
      <input type="password" id="pw-input" placeholder="Mot de passe" required />
      <button type="submit">Entrer</button>
    </form>
    <p class="error" id="pw-error">Mot de passe incorrect</p>

    <p style="font-size: 0.75rem; color: #94a3b8; margin-top: 2rem;">
      contact@magic-crochet-kit.com — 09 51 76 17 11
    </p>

    <div class="social">
      <a href="#" aria-label="Facebook">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z"/></svg>
      </a>
      <a href="#" aria-label="Instagram">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
      </a>
    </div>
  </div>

  <script>
    document.getElementById('pw-form')?.addEventListener('submit', (e) => {
      e.preventDefault()
      const pw = (document.getElementById('pw-input') as HTMLInputElement).value
      if (pw === 'crochet2026') {
        sessionStorage.setItem('store_access', '1')
        window.location.href = '/'
      } else {
        document.getElementById('pw-error')!.style.display = 'block'
      }
    })
  </script>
</body>
</html>
