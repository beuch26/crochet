---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Panier" description="Votre panier — Magic Crochet Kit" noindex={true}>
  <section class="py-12 lg:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="mb-8">Votre panier</h1>

      <!-- Empty state -->
      <div id="page-cart-empty" class="text-center py-16">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 mx-auto text-text-muted/20 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <p class="text-text-light text-lg mb-2">Votre panier est vide</p>
        <p class="text-text-muted text-sm mb-6">Ajoutez des produits pour commencer</p>
        <a href="/collections/" class="btn btn-primary px-8 py-3">Découvrir la boutique</a>
      </div>

      <!-- Cart content -->
      <div id="page-cart-content" class="hidden">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_350px] gap-10">
          <!-- Items -->
          <div>
            <!-- Header -->
            <div class="hidden sm:grid grid-cols-[1fr_120px_120px_40px] gap-4 pb-4 border-b border-border-light text-xs font-semibold text-text-muted uppercase tracking-wider">
              <span>Produit</span>
              <span class="text-center">Quantité</span>
              <span class="text-right">Total</span>
              <span></span>
            </div>
            <div id="page-cart-items" class="divide-y divide-border-light"></div>
          </div>

          <!-- Summary -->
          <div>
            <div class="bg-bg-light rounded-2xl p-6 sticky top-24">
              <h3 class="text-base font-semibold font-['DM_Sans'] mb-5">Résumé</h3>

              <!-- Free shipping progress -->
              <div class="mb-5">
                <div class="flex items-center justify-between text-xs text-text-muted mb-1.5">
                  <span id="page-shipping-msg">Livraison gratuite dès 50€</span>
                </div>
                <div class="w-full h-1.5 bg-white rounded-full overflow-hidden">
                  <div id="page-shipping-bar" class="h-full bg-gradient-to-r from-primary to-secondary rounded-full transition-all duration-500" style="width: 0%"></div>
                </div>
              </div>

              <div class="space-y-3 mb-5">
                <div class="flex justify-between text-sm">
                  <span class="text-text-muted">Sous-total</span>
                  <span class="font-medium" id="page-cart-subtotal">0,00 €</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="text-text-muted">Livraison</span>
                  <span class="text-text-muted text-xs" id="page-cart-shipping">Calculé au checkout</span>
                </div>
              </div>

              <div class="flex justify-between text-lg font-bold pt-4 border-t border-border">
                <span>Total</span>
                <span id="page-cart-total" class="font-['DM_Sans']">0,00 €</span>
              </div>

              <a href="/checkout/" class="block w-full mt-5 py-3.5 bg-primary text-white font-semibold rounded-2xl hover:bg-primary-hover transition-all shadow-lg shadow-primary/20 text-base text-center">
                Passer commande
              </a>

              <a href="/collections/" class="block w-full mt-3 py-3 text-center text-sm text-text-muted hover:text-primary transition-colors">
                Continuer mes achats
              </a>

              <!-- Trust badges -->
              <div class="mt-5 pt-5 border-t border-border grid grid-cols-3 gap-2">
                <div class="text-center">
                  <svg class="w-5 h-5 mx-auto text-primary mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
                  <p class="text-[10px] text-text-muted">Livraison offerte</p>
                </div>
                <div class="text-center">
                  <svg class="w-5 h-5 mx-auto text-primary mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
                  <p class="text-[10px] text-text-muted">Paiement sécurisé</p>
                </div>
                <div class="text-center">
                  <svg class="w-5 h-5 mx-auto text-primary mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" /></svg>
                  <p class="text-[10px] text-text-muted">Retours 30 jours</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const MEDUSA_URL = document.querySelector('meta[name="medusa-url"]')?.getAttribute('content') || ''
  const API_KEY = document.querySelector('meta[name="medusa-key"]')?.getAttribute('content') || ''
  const FREE_THRESHOLD = parseInt(document.querySelector('meta[name="free-shipping-threshold"]')?.getAttribute('content') || '50')
  const cartId = localStorage.getItem('mck_cart_id') || ''

  const fmt = (a: number) => new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(a)

  async function loadPageCart() {
    if (!cartId) return

    try {
      const res = await fetch(`${MEDUSA_URL}/store/carts/${cartId}`, { headers: { 'x-publishable-api-key': API_KEY } })
      const { cart } = await res.json()
      const items = cart.items || []

      if (items.length === 0) return

      // GA4 view_cart + TikTok AddToCart
      const __cartPayload = {
        currency: cart.currency_code?.toUpperCase() || 'EUR',
        value: cart.total || 0,
        items: items.map((it: any) => ({
          item_id: it.variant?.product?.id || it.product_id,
          item_name: it.title,
          item_variant: it.variant?.title || undefined,
          price: it.unit_price,
          quantity: it.quantity,
        })),
      }
      if ((window as any).gaTrack) (window as any).gaTrack('view_cart', __cartPayload)
      if ((window as any).ttqTrack) (window as any).ttqTrack('view_cart', __cartPayload)

      document.getElementById('page-cart-empty')?.classList.add('hidden')
      document.getElementById('page-cart-content')?.classList.remove('hidden')

      const list = document.getElementById('page-cart-items')!
      list.innerHTML = items.map((item: any) => `
        <div class="grid grid-cols-1 sm:grid-cols-[1fr_120px_120px_40px] gap-4 py-5 items-center" data-line="${item.id}">
          <div class="flex items-center gap-4">
            <div class="w-20 h-20 rounded-xl bg-white border border-border-light overflow-hidden shrink-0">
              ${item.thumbnail ? `<img src="${item.thumbnail}" alt="${item.title}" class="w-full h-full object-contain p-2" />` : '<div class="w-full h-full bg-bg-light"></div>'}
            </div>
            <div class="min-w-0">
              <a href="/products/${item.variant?.product?.handle ? item.variant.product.handle + '/' : '#'}" class="text-sm font-medium text-text hover:text-primary transition-colors line-clamp-2">${item.title}</a>
              <p class="text-sm text-text-muted mt-0.5">${fmt(item.unit_price)}</p>
            </div>
          </div>
          <div class="flex items-center justify-center">
            <div class="flex items-center border border-border rounded-lg overflow-hidden">
              <button type="button" class="page-qty-btn px-3 py-1.5 text-text-muted hover:bg-bg-light text-sm" data-action="decrease" data-line-id="${item.id}">−</button>
              <span class="px-3 py-1.5 text-sm font-medium min-w-[2rem] text-center">${item.quantity}</span>
              <button type="button" class="page-qty-btn px-3 py-1.5 text-text-muted hover:bg-bg-light text-sm" data-action="increase" data-line-id="${item.id}">+</button>
            </div>
          </div>
          <div class="text-right">
            <span class="text-sm font-bold text-text">${fmt(item.unit_price * item.quantity)}</span>
          </div>
          <div class="text-right">
            <button type="button" class="page-remove p-1.5 text-text-muted hover:text-error transition-colors" data-line-id="${item.id}" aria-label="Supprimer">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </div>
      `).join('')

      // Totals
      const total = cart.total || 0
      document.getElementById('page-cart-subtotal')!.textContent = fmt(total)
      document.getElementById('page-cart-total')!.textContent = fmt(total)

      // Shipping progress
      const progress = Math.min(100, (total / FREE_THRESHOLD) * 100)
      document.getElementById('page-shipping-bar')!.style.width = progress + '%'
      const msg = document.getElementById('page-shipping-msg')!
      if (total >= FREE_THRESHOLD) {
        msg.innerHTML = '✓ <strong class="text-success">Livraison gratuite !</strong>'
      } else {
        msg.innerHTML = `Plus que <strong class="text-text">${fmt(FREE_THRESHOLD - total)}</strong> pour la livraison gratuite`
      }

      // Qty buttons
      list.querySelectorAll('.page-qty-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const lineId = btn.getAttribute('data-line-id')!
          const action = btn.getAttribute('data-action')
          const item = items.find((i: any) => i.id === lineId)
          if (!item) return
          const newQty = action === 'increase' ? item.quantity + 1 : item.quantity - 1
          if (newQty <= 0) {
            await fetch(`${MEDUSA_URL}/store/carts/${cartId}/line-items/${lineId}`, { method: 'DELETE', headers: { 'x-publishable-api-key': API_KEY } })
          } else {
            await fetch(`${MEDUSA_URL}/store/carts/${cartId}/line-items/${lineId}`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-publishable-api-key': API_KEY }, body: JSON.stringify({ quantity: newQty }) })
          }
          loadPageCart()
        })
      })

      // Remove buttons
      list.querySelectorAll('.page-remove').forEach(btn => {
        btn.addEventListener('click', async () => {
          const lineId = btn.getAttribute('data-line-id')!
          await fetch(`${MEDUSA_URL}/store/carts/${cartId}/line-items/${lineId}`, { method: 'DELETE', headers: { 'x-publishable-api-key': API_KEY } })
          loadPageCart()
        })
      })
    } catch (e) { console.error('Cart load error:', e) }
  }

  loadPageCart()
</script>
