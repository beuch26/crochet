---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Mot de passe oublie" description="Reinitialiser votre mot de passe" noindex={true}>
  <section class="py-16 lg:py-24">
    <div class="max-w-md mx-auto px-4">
      <div class="text-center mb-8">
        <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-primary/10 flex items-center justify-center">
          <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
        </div>
        <h1 style="font-size: 1.5rem;">Mot de passe oublie</h1>
        <p class="text-text-muted mt-2 text-sm">Entrez votre email pour recevoir un lien de reinitialisation</p>
      </div>

      <!-- Request form -->
      <div id="reset-request" class="bg-white rounded-2xl border border-border p-6">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1.5">Email</label>
            <input type="email" id="reset-email" required class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" placeholder="votre@email.fr" />
          </div>
          <div id="reset-error" class="hidden text-sm text-error bg-error/10 p-3 rounded-xl"></div>
          <div id="reset-success" class="hidden text-sm text-success bg-success/10 p-3 rounded-xl"></div>
          <button type="button" id="reset-submit" class="btn btn-primary w-full py-3">
            Envoyer le lien
          </button>
        </div>
        <p class="text-xs text-text-muted text-center mt-4">
          <a href="/account/" class="text-primary hover:underline">Retour a la connexion</a>
        </p>
      </div>

      <!-- Reset form (shown with token) -->
      <div id="reset-form" class="hidden bg-white rounded-2xl border border-border p-6">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-text mb-1.5">Nouveau mot de passe</label>
            <input type="password" id="new-password" required minlength="8" class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" placeholder="8 caracteres minimum" />
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-1.5">Confirmer le mot de passe</label>
            <input type="password" id="confirm-password" required class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
          </div>
          <div id="reset-form-error" class="hidden text-sm text-error bg-error/10 p-3 rounded-xl"></div>
          <div id="reset-form-success" class="hidden text-sm text-success bg-success/10 p-3 rounded-xl"></div>
          <button type="button" id="reset-password-submit" class="btn btn-primary w-full py-3">
            Reinitialiser le mot de passe
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const MEDUSA_URL = document.querySelector('meta[name="medusa-url"]')?.getAttribute('content') || ''

  // Check if we have a token in the URL
  const urlParams = new URLSearchParams(window.location.search)
  const token = urlParams.get('token')
  const email = urlParams.get('email')

  if (token && email) {
    document.getElementById('reset-request')!.classList.add('hidden')
    document.getElementById('reset-form')!.classList.remove('hidden')
  }

  // Request reset
  document.getElementById('reset-submit')?.addEventListener('click', async () => {
    const emailInput = document.getElementById('reset-email') as HTMLInputElement
    const emailVal = emailInput.value.trim()
    const errorEl = document.getElementById('reset-error')!
    const successEl = document.getElementById('reset-success')!
    errorEl.classList.add('hidden')
    successEl.classList.add('hidden')

    if (!emailVal) { errorEl.textContent = 'Veuillez entrer votre email'; errorEl.classList.remove('hidden'); return }

    const btn = document.getElementById('reset-submit') as HTMLButtonElement
    btn.disabled = true
    btn.textContent = 'Envoi...'

    try {
      await fetch(`${MEDUSA_URL}/auth/customer/emailpass/reset-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ identifier: emailVal }),
      })
      // Always show success (don't reveal if email exists)
      successEl.textContent = 'Si un compte existe avec cet email, vous recevrez un lien de reinitialisation.'
      successEl.classList.remove('hidden')
    } catch {
      successEl.textContent = 'Si un compte existe avec cet email, vous recevrez un lien de reinitialisation.'
      successEl.classList.remove('hidden')
    }

    btn.disabled = false
    btn.textContent = 'Envoyer le lien'
  })

  // Reset password with token
  document.getElementById('reset-password-submit')?.addEventListener('click', async () => {
    const newPw = (document.getElementById('new-password') as HTMLInputElement).value
    const confirmPw = (document.getElementById('confirm-password') as HTMLInputElement).value
    const errorEl = document.getElementById('reset-form-error')!
    const successEl = document.getElementById('reset-form-success')!
    errorEl.classList.add('hidden')
    successEl.classList.add('hidden')

    if (newPw.length < 8) { errorEl.textContent = 'Le mot de passe doit contenir au moins 8 caracteres'; errorEl.classList.remove('hidden'); return }
    if (newPw !== confirmPw) { errorEl.textContent = 'Les mots de passe ne correspondent pas'; errorEl.classList.remove('hidden'); return }

    const btn = document.getElementById('reset-password-submit') as HTMLButtonElement
    btn.disabled = true
    btn.textContent = 'Reinitialisation...'

    try {
      const res = await fetch(`${MEDUSA_URL}/auth/customer/emailpass/update`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({ password: newPw }),
      })

      if (res.ok) {
        successEl.textContent = 'Mot de passe reinitialise avec succes ! Redirection...'
        successEl.classList.remove('hidden')
        setTimeout(() => { window.location.href = '/account/' }, 2000)
      } else {
        errorEl.textContent = 'Le lien a expire ou est invalide. Demandez un nouveau lien.'
        errorEl.classList.remove('hidden')
      }
    } catch {
      errorEl.textContent = 'Erreur de connexion'
      errorEl.classList.remove('hidden')
    }

    btn.disabled = false
    btn.textContent = 'Reinitialiser le mot de passe'
  })
</script>
