---
import Layout from '../layouts/Layout.astro'
import { getCollections } from '../lib/medusa'

let collections: any[] = []
try {
  const data = await getCollections()
  collections = data.collections || []
} catch {}
---

<Layout title="Recherche" description="Rechercher un produit ou un article sur Magic Crochet Kit" noindex={true}>
  <section class="py-12 lg:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-center mb-8">Rechercher</h1>

      <!-- Search input -->
      <div class="relative max-w-xl mx-auto mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-text-muted absolute left-4 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="page-search-input"
          type="search"
          placeholder="Que cherchez-vous ?"
          autofocus
          class="w-full pl-12 pr-4 py-4 text-lg border border-border rounded-2xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
        />
      </div>

      <!-- Filter toolbar -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-border-light">
        <div class="flex items-center gap-2 flex-wrap">
          <select id="search-filter-collection" class="text-sm bg-white border border-border rounded-xl px-3 py-2 text-text focus:ring-2 focus:ring-primary/20 focus:border-primary cursor-pointer">
            <option value="">Toutes les categories</option>
            {collections.map((col: any) => (
              <option value={col.id}>{col.title}</option>
            ))}
          </select>

          <div class="flex items-center gap-1.5 bg-white border border-border rounded-xl px-3 py-2">
            <span class="text-xs text-text-muted">Prix</span>
            <input id="search-filter-min" type="number" placeholder="Min" class="w-14 text-sm bg-transparent focus:outline-none" />
            <span class="text-text-muted text-xs">-</span>
            <input id="search-filter-max" type="number" placeholder="Max" class="w-14 text-sm bg-transparent focus:outline-none" />
            <span class="text-xs text-text-muted">€</span>
          </div>

          <select id="search-filter-sort" class="text-sm bg-white border border-border rounded-xl px-3 py-2 text-text focus:ring-2 focus:ring-primary/20 focus:border-primary cursor-pointer">
            <option value="default">Pertinence</option>
            <option value="price-asc">Prix croissant</option>
            <option value="price-desc">Prix decroissant</option>
            <option value="name-asc">Nom A-Z</option>
          </select>

          <button id="search-filter-reset" type="button" class="text-xs text-primary hover:underline">Reinitialiser</button>
        </div>
        <span id="search-result-count" class="text-sm text-text-muted"></span>
      </div>

      <!-- Results -->
      <div id="page-search-loading" class="hidden text-center py-8 text-text-muted">Recherche en cours...</div>
      <div id="page-search-empty" class="hidden text-center py-12">
        <p class="text-text-light text-lg">Aucun résultat trouvé</p>
        <p class="text-text-muted mt-2">Essayez avec d'autres termes ou modifiez les filtres</p>
      </div>

      <div id="page-search-results" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"></div>
    </div>
  </section>
</Layout>

<script>
  const MEDUSA_URL = document.querySelector('meta[name="medusa-url"]')?.getAttribute('content') || ''
  const API_KEY = document.querySelector('meta[name="medusa-key"]')?.getAttribute('content') || ''
  const REGION_ID = document.querySelector('meta[name="medusa-region-id"]')?.getAttribute('content') || 'reg_01KNMDW1PJAW5BV63ARBR3V1XH'

  function formatPrice(amount: number) {
    return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(amount)
  }

  const input = document.getElementById('page-search-input') as HTMLInputElement
  const results = document.getElementById('page-search-results')!
  const loading = document.getElementById('page-search-loading')!
  const empty = document.getElementById('page-search-empty')!
  const filterCollection = document.getElementById('search-filter-collection') as HTMLSelectElement
  const filterMin = document.getElementById('search-filter-min') as HTMLInputElement
  const filterMax = document.getElementById('search-filter-max') as HTMLInputElement
  const filterSort = document.getElementById('search-filter-sort') as HTMLSelectElement
  const filterReset = document.getElementById('search-filter-reset')!
  const resultCount = document.getElementById('search-result-count')!

  let allResults: any[] = []

  // URL params
  const params = new URLSearchParams(window.location.search)
  const q = params.get('q')
  if (q && input) {
    input.value = q
    search(q)
  }
  if (params.get('collection')) filterCollection.value = params.get('collection') || ''
  if (params.get('min')) filterMin.value = params.get('min') || ''
  if (params.get('max')) filterMax.value = params.get('max') || ''
  if (params.get('sort')) filterSort.value = params.get('sort') || 'default'

  let timeout: any
  input?.addEventListener('input', () => {
    clearTimeout(timeout)
    const val = input.value.trim()
    if (val.length < 2) {
      results.innerHTML = ''
      empty.classList.add('hidden')
      resultCount.textContent = ''
      return
    }
    timeout = setTimeout(() => search(val), 300)
  })

  // Filter changes
  ;[filterCollection, filterMin, filterMax, filterSort].forEach(el => {
    el?.addEventListener('change', applyFilters)
    el?.addEventListener('input', () => {
      clearTimeout(timeout)
      timeout = setTimeout(applyFilters, 300)
    })
  })

  filterReset.addEventListener('click', () => {
    filterCollection.value = ''
    filterMin.value = ''
    filterMax.value = ''
    filterSort.value = 'default'
    applyFilters()
  })

  function syncURL() {
    const p = new URLSearchParams()
    if (input.value.trim()) p.set('q', input.value.trim())
    if (filterCollection.value) p.set('collection', filterCollection.value)
    if (filterMin.value) p.set('min', filterMin.value)
    if (filterMax.value) p.set('max', filterMax.value)
    if (filterSort.value && filterSort.value !== 'default') p.set('sort', filterSort.value)
    history.replaceState(null, '', p.toString() ? `?${p}` : window.location.pathname)
  }

  function applyFilters() {
    let filtered = [...allResults]

    if (filterCollection.value) {
      filtered = filtered.filter((p: any) =>
        p.collection_id === filterCollection.value || p.collection?.id === filterCollection.value
      )
    }

    const min = Number(filterMin.value) || 0
    const max = Number(filterMax.value) || Infinity
    if (min > 0 || max < Infinity) {
      filtered = filtered.filter((p: any) => {
        const price = (p.variants?.[0]?.calculated_price?.calculated_amount || 0)
        return price >= min && price <= max
      })
    }

    // Sort
    switch (filterSort.value) {
      case 'price-asc':
        filtered.sort((a, b) => (a.variants?.[0]?.calculated_price?.calculated_amount || 0) - (b.variants?.[0]?.calculated_price?.calculated_amount || 0))
        break
      case 'price-desc':
        filtered.sort((a, b) => (b.variants?.[0]?.calculated_price?.calculated_amount || 0) - (a.variants?.[0]?.calculated_price?.calculated_amount || 0))
        break
      case 'name-asc':
        filtered.sort((a, b) => (a.title || '').localeCompare(b.title || ''))
        break
    }

    renderResults(filtered)
    syncURL()
  }

  function renderResults(products: any[]) {
    if (products.length === 0) {
      empty.classList.remove('hidden')
      results.innerHTML = ''
      resultCount.textContent = '0 produit'
      return
    }
    empty.classList.add('hidden')
    resultCount.textContent = `${products.length} produit${products.length > 1 ? 's' : ''}`
    results.innerHTML = products.map((p: any) => {
      const price = p.variants?.[0]?.calculated_price?.calculated_amount || 0
      return `
        <a href="/products/${p.handle}/" class="group bg-white rounded-2xl overflow-hidden border border-border-light card-hover block">
          <div class="aspect-square bg-bg-light overflow-hidden">
            ${p.thumbnail ? `<img src="${p.thumbnail}" alt="${p.title}" loading="lazy" width="300" height="300" class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-500" />` : '<div class="w-full h-full flex items-center justify-center text-text-muted"><svg class="w-12 h-12 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>'}
          </div>
          <div class="p-3.5">
            <h3 class="product-card-title group-hover:text-primary transition-colors line-clamp-2">${p.title}</h3>
            <p class="mt-1.5 text-base font-bold text-text">${formatPrice(price)}</p>
          </div>
        </a>
      `
    }).join('')
  }

  async function search(query: string) {
    loading.classList.remove('hidden')
    empty.classList.add('hidden')
    results.innerHTML = ''
    syncURL()

    try {
      const res = await fetch(`${MEDUSA_URL}/store/products?q=${encodeURIComponent(query)}&limit=50&region_id=${REGION_ID}&fields=+variants.calculated_price,+collection_id,+collection`, {
        headers: { 'x-publishable-api-key': API_KEY },
      })
      const data = await res.json()
      allResults = data.products || []

      loading.classList.add('hidden')
      applyFilters()
    } catch (e) {
      loading.classList.add('hidden')
      console.error(e)
    }
  }
</script>
