---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Ma liste d'envies" description="Vos produits favoris — Magic Crochet Kit" noindex={true}>
  <section class="py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h1>Ma liste d'envies</h1>
        <p class="mt-3 text-text-light text-lg" id="wl-count">Chargement...</p>
      </div>

      <!-- Empty state -->
      <div id="wl-empty" class="hidden text-center py-16">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 mx-auto text-text-muted/20 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        <p class="text-text-light text-lg mb-2">Votre liste d'envies est vide</p>
        <p class="text-text-muted text-sm mb-6">Ajoutez des produits en cliquant sur le coeur</p>
        <a href="/collections/" class="btn btn-primary">Découvrir la boutique</a>
      </div>

      <!-- Products grid -->
      <div id="wl-grid" class="hidden grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-6"></div>
    </div>
  </section>
</Layout>

<script>
  const MEDUSA_URL = document.querySelector('meta[name="medusa-url"]')?.getAttribute('content') || ''
  const API_KEY = document.querySelector('meta[name="medusa-key"]')?.getAttribute('content') || ''
  const REGION_ID = document.querySelector('meta[name="medusa-region-id"]')?.getAttribute('content') || 'reg_01KNMDW1PJAW5BV63ARBR3V1XH'

  const grid = document.getElementById('wl-grid')!
  const empty = document.getElementById('wl-empty')!
  const countEl = document.getElementById('wl-count')!

  function getWishlist(): string[] {
    try { return JSON.parse(localStorage.getItem('mck_wishlist') || '[]') }
    catch { return [] }
  }

  function removeFromWishlist(handle: string) {
    const wl = getWishlist().filter(h => h !== handle)
    localStorage.setItem('mck_wishlist', JSON.stringify(wl))
    loadWishlist()
  }

  async function loadWishlist() {
    const handles = getWishlist()

    if (handles.length === 0) {
      empty.classList.remove('hidden')
      grid.classList.add('hidden')
      countEl.textContent = 'Aucun produit sauvegardé'
      return
    }

    countEl.textContent = `${handles.length} produit${handles.length > 1 ? 's' : ''}`

    try {
      // Fetch all products and filter by handles
      const res = await fetch(`${MEDUSA_URL}/store/products?limit=100&region_id=${REGION_ID}&fields=+variants.calculated_price`, {
        headers: { 'x-publishable-api-key': API_KEY },
      })
      const { products } = await res.json()

      const wishlistProducts = products.filter((p: any) => handles.includes(p.handle))

      if (wishlistProducts.length === 0) {
        empty.classList.remove('hidden')
        grid.classList.add('hidden')
        return
      }

      empty.classList.add('hidden')
      grid.classList.remove('hidden')

      grid.innerHTML = wishlistProducts.map((p: any) => {
        const price = p.variants?.[0]?.calculated_price?.calculated_amount || 0
        const formatted = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(price)
        return `
          <div class="group relative bg-white rounded-2xl overflow-hidden border border-border-light card-hover">
            <button type="button" data-remove-wl="${p.handle}" class="absolute top-3 right-3 z-10 w-9 h-9 rounded-full bg-white shadow-md flex items-center justify-center text-error hover:bg-error hover:text-white transition-all" aria-label="Retirer">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            <a href="/products/${p.handle}/" class="block">
              <div class="aspect-square overflow-hidden bg-bg-light">
                ${p.thumbnail
                  ? `<img src="${p.thumbnail}" alt="${p.title}" loading="lazy" class="h-full w-full object-contain p-4 group-hover:scale-105 transition-transform duration-500" />`
                  : '<div class="h-full w-full flex items-center justify-center text-text-muted"><svg class="h-14 w-14 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>'
                }
              </div>
              <div class="p-4">
                <h3 class="text-sm font-medium text-text group-hover:text-primary transition-colors line-clamp-2 min-h-[2.5rem]">${p.title}</h3>
                <div class="mt-2">
                  <span class="text-lg font-bold text-text">${formatted}</span>
                </div>
              </div>
            </a>
          </div>
        `
      }).join('')

      // Bind remove buttons
      grid.querySelectorAll('[data-remove-wl]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault()
          e.stopPropagation()
          const handle = (btn as HTMLElement).dataset.removeWl!
          removeFromWishlist(handle)
        })
      })
    } catch (e) {
      console.error('Failed to load wishlist products:', e)
      countEl.textContent = 'Erreur de chargement'
    }
  }

  loadWishlist()
</script>
