---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Mon compte" description="Connectez-vous à votre compte Magic Crochet Kit" noindex={true}>
  <section class="py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Auth forms (shown when not logged in) -->
      <div id="auth-section">
        <h1 class="text-center mb-10">Mon compte</h1>

        <div class="max-w-md mx-auto">
          <!-- Login form -->
          <div id="login-form" class="bg-white p-8 rounded-2xl border border-border-light">
            <h2 class="text-xl font-semibold font-['DM_Sans'] mb-6">Se connecter</h2>
            <div id="login-error" class="hidden mb-4 p-3 bg-error/10 text-error text-sm rounded-xl"></div>

            <!-- Google login -->
            <button type="button" id="google-login-btn" class="w-full flex items-center justify-center gap-3 py-3 mb-4 border border-border rounded-xl bg-white hover:bg-bg-light transition-colors text-sm font-medium text-text">
              <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
              Continuer avec Google
            </button>

            <!-- Divider -->
            <div class="relative mb-4">
              <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-border-light"></div></div>
              <div class="relative flex justify-center text-xs"><span class="px-3 bg-white text-text-muted">ou avec votre email</span></div>
            </div>

            <form id="login-submit" class="space-y-4">
              <div>
                <label for="login-email" class="block text-sm font-medium text-text mb-2">Email</label>
                <input type="email" id="login-email" required class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
              </div>
              <div>
                <label for="login-password" class="block text-sm font-medium text-text mb-2">Mot de passe</label>
                <input type="password" id="login-password" required class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
              </div>
              <button type="submit" class="btn btn-primary w-full py-3.5" id="login-btn">Se connecter</button>
              <div class="mt-3 text-right">
                <a href="/mot-de-passe-oublie/" class="text-xs text-text-muted hover:text-primary transition-colors">Mot de passe oublie ?</a>
              </div>
            </form>
            <div class="mt-6 text-center">
              <button type="button" id="show-register" class="text-sm text-primary hover:underline">
                Pas encore de compte ? Créer un compte
              </button>
            </div>
          </div>

          <!-- Register form -->
          <div id="register-form" class="hidden bg-white p-8 rounded-2xl border border-border-light">
            <h2 class="text-xl font-semibold font-['DM_Sans'] mb-6">Créer un compte</h2>
            <div id="register-error" class="hidden mb-4 p-3 bg-error/10 text-error text-sm rounded-xl"></div>
            <div id="register-success" class="hidden mb-4 p-3 bg-success/10 text-success text-sm rounded-xl"></div>
            <form id="register-submit" class="space-y-4">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label for="reg-first" class="block text-sm font-medium text-text mb-2">Prénom</label>
                  <input type="text" id="reg-first" required class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                </div>
                <div>
                  <label for="reg-last" class="block text-sm font-medium text-text mb-2">Nom</label>
                  <input type="text" id="reg-last" required class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                </div>
              </div>
              <div>
                <label for="reg-email" class="block text-sm font-medium text-text mb-2">Email</label>
                <input type="email" id="reg-email" required class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
              </div>
              <div>
                <label for="reg-password" class="block text-sm font-medium text-text mb-2">Mot de passe</label>
                <input type="password" id="reg-password" required minlength="8" class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                <p class="text-xs text-text-muted mt-1">Minimum 8 caractères</p>
              </div>
              <button type="submit" class="btn btn-primary w-full py-3.5" id="register-btn">Créer mon compte</button>
            </form>
            <div class="mt-6 text-center">
              <button type="button" id="show-login" class="text-sm text-primary hover:underline">
                Déjà un compte ? Se connecter
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Dashboard (shown when logged in) -->
      <div id="dashboard-section" class="hidden">
        <div class="flex items-center justify-between mb-10">
          <div>
            <h2 class="text-2xl lg:text-3xl">Bonjour <span id="dash-name" class="text-primary"></span></h2>
            <p class="text-text-muted mt-1" id="dash-email"></p>
          </div>
          <button type="button" id="logout-btn" class="btn btn-outline text-sm py-2 px-5">
            Déconnexion
          </button>
        </div>

        <!-- Tab nav -->
        <div class="flex gap-1 border-b border-border-light mb-8 overflow-x-auto">
          <button data-dash-tab="orders" class="dash-tab px-5 py-3 text-sm font-semibold border-b-2 border-primary text-primary transition-all whitespace-nowrap">
            Mes commandes
          </button>
          <button data-dash-tab="profile" class="dash-tab px-5 py-3 text-sm font-semibold border-b-2 border-transparent text-text-muted hover:text-text transition-all whitespace-nowrap">
            Mon profil
          </button>
          <button data-dash-tab="addresses" class="dash-tab px-5 py-3 text-sm font-semibold border-b-2 border-transparent text-text-muted hover:text-text transition-all whitespace-nowrap">
            Mes adresses
          </button>
        </div>

        <!-- Orders -->
        <div id="dash-orders" class="dash-content">
          <div id="orders-loading" class="text-center py-12 text-text-muted">Chargement...</div>
          <div id="orders-empty" class="hidden text-center py-12">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-text-muted/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <p class="text-text-muted mb-4">Vous n'avez pas encore passé de commande</p>
            <a href="/collections/" class="btn btn-primary">Découvrir la boutique</a>
          </div>
          <div id="orders-list" class="hidden space-y-4"></div>
        </div>

        <!-- Profile -->
        <div id="dash-profile" class="dash-content hidden">
          <div class="bg-white p-6 lg:p-8 rounded-2xl border border-border-light max-w-lg">
            <h3 class="text-lg font-semibold font-['DM_Sans'] mb-6">Informations personnelles</h3>
            <div id="profile-success" class="hidden mb-4 p-3 bg-success/10 text-success text-sm rounded-xl">Profil mis à jour !</div>
            <form id="profile-form" class="space-y-4">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-text mb-2">Prénom</label>
                  <input type="text" id="profile-first" class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-text mb-2">Nom</label>
                  <input type="text" id="profile-last" class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-2">Email</label>
                <input type="email" id="profile-email" disabled class="w-full px-4 py-3 border border-border rounded-xl bg-bg-light text-text-muted cursor-not-allowed" />
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-2">Téléphone</label>
                <input type="tel" id="profile-phone" class="w-full px-4 py-3 border border-border rounded-xl bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
              </div>
              <button type="submit" class="btn btn-primary py-3 px-8">Enregistrer</button>
            </form>
          </div>
        </div>

        <!-- Addresses -->
        <div id="dash-addresses" class="dash-content hidden">
          <div id="addresses-list" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
          <div id="addresses-empty" class="hidden text-center py-12">
            <p class="text-text-muted mb-4">Aucune adresse enregistrée</p>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
  const MEDUSA_URL = document.querySelector('meta[name="medusa-url"]')?.getAttribute('content') || ''
  const API_KEY = document.querySelector('meta[name="medusa-key"]')?.getAttribute('content') || ''

  // Helpers
  async function medusaAuth(endpoint: string, body?: any, method = 'POST') {
    const opts: RequestInit = {
      method,
      headers: { 'Content-Type': 'application/json', 'x-publishable-api-key': API_KEY },
      credentials: 'include',
    }
    if (body) opts.body = JSON.stringify(body)
    return fetch(`${MEDUSA_URL}${endpoint}`, opts)
  }

  function getToken() { return localStorage.getItem('mck_token') }
  function setToken(t: string) { localStorage.setItem('mck_token', t) }
  function clearToken() { localStorage.removeItem('mck_token') }

  async function authedFetch(endpoint: string, method = 'GET', body?: any) {
    const token = getToken()
    const opts: RequestInit = {
      method,
      headers: {
        'Content-Type': 'application/json',
        'x-publishable-api-key': API_KEY,
        ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
      },
    }
    if (body) opts.body = JSON.stringify(body)
    return fetch(`${MEDUSA_URL}${endpoint}`, opts)
  }

  // Toggle forms
  document.getElementById('show-register')?.addEventListener('click', () => {
    document.getElementById('login-form')?.classList.add('hidden')
    document.getElementById('register-form')?.classList.remove('hidden')
  })
  document.getElementById('show-login')?.addEventListener('click', () => {
    document.getElementById('register-form')?.classList.add('hidden')
    document.getElementById('login-form')?.classList.remove('hidden')
  })

  // Dashboard tabs
  document.querySelectorAll('.dash-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const target = (tab as HTMLElement).dataset.dashTab
      document.querySelectorAll('.dash-tab').forEach(t => {
        t.classList.remove('border-primary', 'text-primary')
        t.classList.add('border-transparent', 'text-text-muted')
      })
      tab.classList.add('border-primary', 'text-primary')
      tab.classList.remove('border-transparent', 'text-text-muted')
      document.querySelectorAll('.dash-content').forEach(c => c.classList.add('hidden'))
      document.getElementById('dash-' + target)?.classList.remove('hidden')
    })
  })

  // Register
  document.getElementById('register-submit')?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const btn = document.getElementById('register-btn') as HTMLButtonElement
    const errorEl = document.getElementById('register-error')!
    const successEl = document.getElementById('register-success')!
    errorEl.classList.add('hidden')
    successEl.classList.add('hidden')
    btn.disabled = true
    btn.textContent = 'Création...'

    try {
      const res = await medusaAuth('/auth/customer/emailpass/register', {
        email: (document.getElementById('reg-email') as HTMLInputElement).value,
        password: (document.getElementById('reg-password') as HTMLInputElement).value,
      })

      if (!res.ok) {
        const data = await res.json().catch(() => ({}))
        throw new Error(data.message || 'Erreur lors de la création du compte')
      }

      const { token } = await res.json()
      setToken(token)

      // Create customer profile
      await authedFetch('/store/customers', 'POST', {
        first_name: (document.getElementById('reg-first') as HTMLInputElement).value,
        last_name: (document.getElementById('reg-last') as HTMLInputElement).value,
      })

      successEl.textContent = 'Compte créé avec succès !'
      successEl.classList.remove('hidden')
      setTimeout(() => showDashboard(), 800)
    } catch (err: any) {
      errorEl.textContent = err.message || 'Erreur lors de la création du compte'
      errorEl.classList.remove('hidden')
    } finally {
      btn.disabled = false
      btn.textContent = 'Créer mon compte'
    }
  })

  // Google OAuth login
  document.getElementById('google-login-btn')?.addEventListener('click', async () => {
    try {
      const res = await fetch(`${MEDUSA_URL}/auth/customer/google`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ callback_url: window.location.origin + '/account/?google_callback=1' }),
      })
      const data = await res.json()
      if (data.location) {
        window.location.href = data.location
      } else {
        alert('Erreur de connexion Google')
      }
    } catch (e) {
      alert('Erreur de connexion Google')
    }
  })

  // Handle Google callback (token in URL after Google redirect)
  ;(async function handleGoogleCallback() {
    const params = new URLSearchParams(window.location.search)
    if (!params.get('code') && !params.get('google_callback')) return
    try {
      const res = await fetch(`${MEDUSA_URL}/auth/customer/google/callback${window.location.search}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      })
      const data = await res.json()
      if (data.token) {
        localStorage.setItem('mck_customer_token', data.token)
        window.location.href = '/account/'
      }
    } catch {}
  })()

  // Login
  document.getElementById('login-submit')?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const btn = document.getElementById('login-btn') as HTMLButtonElement
    const errorEl = document.getElementById('login-error')!
    errorEl.classList.add('hidden')
    btn.disabled = true
    btn.textContent = 'Connexion...'

    try {
      const res = await medusaAuth('/auth/customer/emailpass', {
        email: (document.getElementById('login-email') as HTMLInputElement).value,
        password: (document.getElementById('login-password') as HTMLInputElement).value,
      })

      if (!res.ok) {
        throw new Error('Email ou mot de passe incorrect')
      }

      const { token } = await res.json()
      setToken(token)
      showDashboard()
    } catch (err: any) {
      errorEl.textContent = err.message
      errorEl.classList.remove('hidden')
    } finally {
      btn.disabled = false
      btn.textContent = 'Se connecter'
    }
  })

  // Logout
  document.getElementById('logout-btn')?.addEventListener('click', () => {
    clearToken()
    document.getElementById('dashboard-section')?.classList.add('hidden')
    document.getElementById('auth-section')?.classList.remove('hidden')
  })

  // Show dashboard
  async function showDashboard() {
    document.getElementById('auth-section')?.classList.add('hidden')
    document.getElementById('dashboard-section')?.classList.remove('hidden')

    try {
      const res = await authedFetch('/store/customers/me')
      if (!res.ok) {
        clearToken()
        document.getElementById('dashboard-section')?.classList.add('hidden')
        document.getElementById('auth-section')?.classList.remove('hidden')
        return
      }

      const { customer } = await res.json()
      const name = [customer.first_name, customer.last_name].filter(Boolean).join(' ') || 'Client'
      document.getElementById('dash-name')!.textContent = name
      document.getElementById('dash-email')!.textContent = customer.email

      // Profile form
      ;(document.getElementById('profile-first') as HTMLInputElement).value = customer.first_name || ''
      ;(document.getElementById('profile-last') as HTMLInputElement).value = customer.last_name || ''
      ;(document.getElementById('profile-email') as HTMLInputElement).value = customer.email || ''
      ;(document.getElementById('profile-phone') as HTMLInputElement).value = customer.phone || ''

      // Load orders
      loadOrders()

      // Load addresses
      loadAddresses(customer)
    } catch {
      clearToken()
      document.getElementById('dashboard-section')?.classList.add('hidden')
      document.getElementById('auth-section')?.classList.remove('hidden')
    }
  }

  // Load orders
  async function loadOrders() {
    const loading = document.getElementById('orders-loading')!
    const empty = document.getElementById('orders-empty')!
    const list = document.getElementById('orders-list')!

    try {
      const res = await authedFetch('/store/orders')
      if (!res.ok) throw new Error()
      const { orders } = await res.json()

      loading.classList.add('hidden')
      if (!orders || orders.length === 0) {
        empty.classList.remove('hidden')
        return
      }

      list.classList.remove('hidden')
      list.innerHTML = orders.map((o: any) => {
        const date = new Date(o.created_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
        const total = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: o.currency_code?.toUpperCase() || 'EUR' }).format(o.total || 0)
        const statusMap: Record<string, string> = {
          pending: 'En attente',
          completed: 'Complétée',
          canceled: 'Annulée',
          archived: 'Archivée',
          requires_action: 'Action requise',
        }
        const statusLabel = statusMap[o.status] || o.status
        const statusColor = o.status === 'completed' ? 'text-success bg-success/10' : o.status === 'canceled' ? 'text-error bg-error/10' : 'text-primary bg-primary/10'
        return `
          <div class="bg-white p-5 rounded-2xl border border-border-light">
            <div class="flex items-center justify-between flex-wrap gap-3">
              <div>
                <p class="font-semibold text-text">Commande #${o.display_id || o.id.slice(-8)}</p>
                <p class="text-sm text-text-muted mt-0.5">${date}</p>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-xs font-semibold px-3 py-1 rounded-full ${statusColor}">${statusLabel}</span>
                <span class="font-bold text-text">${total}</span>
              </div>
            </div>
            ${o.items && o.items.length > 0 ? `
              <div class="mt-4 pt-4 border-t border-border-light space-y-2">
                ${o.items.map((item: any) => `
                  <div class="flex items-center gap-3 text-sm">
                    ${item.thumbnail ? `<img src="${item.thumbnail}" alt="${item.title}" width="40" height="40" class="w-10 h-10 rounded-lg object-contain bg-bg-light" />` : ''}
                    <span class="flex-1 text-text">${item.title}</span>
                    <span class="text-text-muted">x${item.quantity}</span>
                  </div>
                `).join('')}
              </div>
            ` : ''}
            <div class="mt-4 pt-3 border-t border-border-light flex gap-4 flex-wrap">
              <button type="button" class="invoice-download text-xs text-primary hover:underline flex items-center gap-1" data-order-id="${o.id}" data-email="${o.email}">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Telecharger la facture
              </button>
              <button type="button" class="reorder-btn text-xs text-primary hover:underline flex items-center gap-1" data-items='${JSON.stringify((o.items || []).map((it: any) => ({ variant_id: it.variant_id, quantity: it.quantity })))}'>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                Recommander
              </button>
            </div>
          </div>
        `
      }).join('')
      // Bind reorder buttons
      list.querySelectorAll('.reorder-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const el = btn as HTMLElement
          const items = JSON.parse(el.dataset.items || '[]')
          if (items.length === 0) { alert('Aucun article a recommander'); return }

          el.textContent = 'Ajout en cours...'
          let cartId = localStorage.getItem('mck_cart_id') || ''

          try {
            // Create cart if needed
            if (!cartId) {
              const r = await fetch(`${MEDUSA_URL}/store/carts`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'x-publishable-api-key': API_KEY },
                body: JSON.stringify({ region_id: document.querySelector('meta[name="medusa-region-id"]')?.getAttribute('content') }),
              })
              const data = await r.json()
              cartId = data.cart?.id
              if (cartId) localStorage.setItem('mck_cart_id', cartId)
            }

            // Add all items
            for (const item of items) {
              if (!item.variant_id) continue
              await fetch(`${MEDUSA_URL}/store/carts/${cartId}/line-items`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'x-publishable-api-key': API_KEY },
                body: JSON.stringify({ variant_id: item.variant_id, quantity: item.quantity || 1 }),
              })
            }

            // Update cart count badge
            const badge = document.getElementById('cart-count')
            if (badge) {
              const count = items.reduce((s: number, i: any) => s + (i.quantity || 1), 0)
              badge.textContent = String(count)
              badge.classList.remove('hidden')
            }

            window.location.href = '/cart/'
          } catch (e) {
            alert('Erreur lors de l\'ajout au panier')
            el.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> Recommander'
          }
        })
      })

      // Bind invoice download buttons
      list.querySelectorAll('.invoice-download').forEach(btn => {
        btn.addEventListener('click', async () => {
          const el = btn as HTMLElement
          const orderId = el.dataset.orderId
          const email = el.dataset.email
          el.textContent = 'Generation...'

          try {
            const res = await fetch(`${MEDUSA_URL}/store/orders/invoice`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'x-publishable-api-key': API_KEY },
              body: JSON.stringify({ order_id: orderId, email }),
            })
            if (!res.ok) throw new Error()
            const blob = await res.blob()
            const url = URL.createObjectURL(blob)
            const a = document.createElement('a')
            a.href = url
            a.download = `facture-magic-crochet-kit.pdf`
            a.click()
            URL.revokeObjectURL(url)
          } catch {
            alert('Erreur lors de la generation de la facture')
          }
          el.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg> Telecharger la facture'
        })
      })
    } catch {
      loading.classList.add('hidden')
      empty.classList.remove('hidden')
    }
  }

  // Load addresses
  function loadAddresses(customer: any) {
    const list = document.getElementById('addresses-list')!
    const empty = document.getElementById('addresses-empty')!
    const addresses = customer.addresses || []

    if (addresses.length === 0) {
      empty.classList.remove('hidden')
      return
    }

    list.innerHTML = addresses.map((a: any) => `
      <div class="bg-white p-5 rounded-2xl border border-border-light">
        <p class="font-semibold text-text">${a.first_name || ''} ${a.last_name || ''}</p>
        <p class="text-sm text-text-light mt-1">${a.address_1 || ''}</p>
        ${a.address_2 ? `<p class="text-sm text-text-light">${a.address_2}</p>` : ''}
        <p class="text-sm text-text-light">${a.postal_code || ''} ${a.city || ''}</p>
        <p class="text-sm text-text-muted">${a.country_code?.toUpperCase() || ''}</p>
        ${a.phone ? `<p class="text-sm text-text-muted mt-1">${a.phone}</p>` : ''}
      </div>
    `).join('')
  }

  // Profile update
  document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const success = document.getElementById('profile-success')!
    success.classList.add('hidden')

    try {
      const res = await authedFetch('/store/customers/me', 'POST', {
        first_name: (document.getElementById('profile-first') as HTMLInputElement).value,
        last_name: (document.getElementById('profile-last') as HTMLInputElement).value,
        phone: (document.getElementById('profile-phone') as HTMLInputElement).value,
      })

      if (res.ok) {
        success.classList.remove('hidden')
        const { customer } = await res.json()
        const name = [customer.first_name, customer.last_name].filter(Boolean).join(' ')
        document.getElementById('dash-name')!.textContent = name
      }
    } catch {}
  })

  // Auto-login on page load
  if (getToken()) {
    showDashboard()
  }
</script>
