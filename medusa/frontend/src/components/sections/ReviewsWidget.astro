---
/**
 * Reviews Widget - Trustpilot/Google-style review summary
 * Like Olympus theme's trustpilot-reviews section
 */
interface Review {
  name: string
  rating: number
  text: string
  date?: string
  verified?: boolean
}

interface Props {
  title?: string
  platform?: string
  overallRating?: number
  totalReviews?: number
  reviews?: Review[]
}

const {
  title = 'Avis clients',
  platform = 'Magic Crochet Kit',
  overallRating = 4.8,
  totalReviews = 347,
  reviews = [
    { name: 'Marie L.', rating: 5, text: "Livraison rapide, produit conforme. Les coquillages d'allaitement ont changé ma vie !", date: 'Il y a 3 jours', verified: true },
    { name: 'Sophie D.', rating: 5, text: "Excellent site, service client top. Je recommande à toutes les mamans.", date: 'Il y a 1 semaine', verified: true },
    { name: 'Camille R.', rating: 4, text: "Très bien dans l'ensemble, juste un petit retard de livraison. Produit au top.", date: 'Il y a 2 semaines', verified: true },
    { name: 'Laura M.', rating: 5, text: "Le tire-lait est super silencieux, exactement ce que je cherchais. Merci Magic Crochet Kit !", date: 'Il y a 3 semaines', verified: true },
  ],
} = Astro.props

const stars = Math.round(overallRating * 2) / 2
const distribution = [
  { stars: 5, pct: 78 },
  { stars: 4, pct: 15 },
  { stars: 3, pct: 5 },
  { stars: 2, pct: 1 },
  { stars: 1, pct: 1 },
]
---

<section class="py-16 lg:py-20 reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    {title && <h2 class="text-center mb-12">{title}</h2>}

    <div class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-10">
      <!-- Summary card -->
      <div class="bg-white rounded-2xl border border-border-light p-8 text-center">
        <p class="text-5xl font-bold text-text font-['DM_Sans']">{overallRating}</p>
        <div class="flex items-center justify-center gap-0.5 mt-3">
          {Array.from({ length: 5 }).map((_, i) => (
            <svg class={`w-5 h-5 ${i < Math.floor(stars) ? 'text-amber-400' : i < stars ? 'text-amber-400' : 'text-gray-200'}`} fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <p class="text-sm text-text-muted mt-2">Basé sur {totalReviews.toLocaleString('fr-FR')} avis</p>

        <!-- Distribution bars -->
        <div class="mt-6 space-y-2">
          {distribution.map((d) => (
            <div class="flex items-center gap-2 text-xs">
              <span class="w-3 text-text-muted">{d.stars}</span>
              <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <div class="flex-1 h-2 bg-bg-light rounded-full overflow-hidden">
                <div class="h-full bg-amber-400 rounded-full" style={`width: ${d.pct}%`}></div>
              </div>
              <span class="w-8 text-right text-text-muted">{d.pct}%</span>
            </div>
          ))}
        </div>

        <div class="mt-6 pt-5 border-t border-border-light">
          <div class="flex items-center justify-center gap-1.5 text-sm text-text-muted">
            <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Avis vérifiés
          </div>
        </div>
      </div>

      <!-- Reviews list -->
      <div class="space-y-4">
        {reviews.map((review) => (
          <div class="bg-white rounded-2xl border border-border-light p-6">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary/20 to-secondary/20 flex items-center justify-center text-primary font-semibold text-sm">
                  {review.name.charAt(0)}
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-medium text-text">{review.name}</span>
                    {review.verified && (
                      <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                    )}
                  </div>
                  {review.date && <span class="text-xs text-text-muted">{review.date}</span>}
                </div>
              </div>
              <div class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg class={`w-4 h-4 ${i < review.rating ? 'text-amber-400' : 'text-gray-200'}`} fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
            </div>
            <p class="text-sm text-text-light leading-relaxed">{review.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
