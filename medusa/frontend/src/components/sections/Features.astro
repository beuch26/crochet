---
interface Feature {
  icon: string
  title: string
  text: string
}

interface Props {
  title?: string
  subtitle?: string
  features: Feature[]
}

const { title = "Pourquoi Magic Crochet Kit ?", subtitle, features } = Astro.props

const defaultFeatures: Feature[] = [
  { icon: "heart", title: "Sélection avec amour", text: "Chaque produit est testé et approuvé par notre équipe de mamans expertes." },
  { icon: "shield", title: "Qualité garantie", text: "Nous ne travaillons qu'avec des marques reconnues pour leur sécurité et leur fiabilité." },
  { icon: "chat", title: "Conseils personnalisés", text: "Notre blog et notre équipe vous accompagnent dans chaque étape de la maternité." },
]

const items = features?.length ? features : defaultFeatures

const icons: Record<string, string> = {
  heart: "M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z",
  shield: "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z",
  chat: "M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z",
}
---

<section class="py-16 lg:py-20 bg-bg-warm reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2>{title}</h2>
      {subtitle && <p class="mt-3 text-text-light text-lg">{subtitle}</p>}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {items.map((f) => (
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-primary/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={icons[f.icon] || icons.heart} />
            </svg>
          </div>
          <h3 class="text-lg font-semibold font-['DM_Sans'] mb-2">{f.title}</h3>
          <p class="text-text-light text-sm leading-relaxed">{f.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
