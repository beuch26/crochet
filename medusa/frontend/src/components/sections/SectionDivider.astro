---
/**
 * Section Divider - decorative wave/curve between sections
 * Like Olympus theme's divider section
 */
interface Props {
  type?: 'wave' | 'curve' | 'slant' | 'triangle'
  color?: string
  bgColor?: string
  flip?: boolean
  height?: number
}

const {
  type = 'wave',
  color = '#f8fafc',
  bgColor = 'transparent',
  flip = false,
  height = 60,
} = Astro.props

const paths: Record<string, string> = {
  wave: 'M0,32L48,37.3C96,43,192,53,288,58.7C384,64,480,64,576,58.7C672,53,768,43,864,42.7C960,43,1056,53,1152,53.3C1248,53,1344,43,1392,37.3L1440,32L1440,64L1392,64C1344,64,1248,64,1152,64C1056,64,960,64,864,64C768,64,672,64,576,64C480,64,384,64,288,64C192,64,96,64,48,64L0,64Z',
  curve: 'M0,64L1440,0L1440,64L0,64Z',
  slant: 'M0,0L1440,64L1440,64L0,64Z',
  triangle: 'M0,64L720,0L1440,64L1440,64L0,64Z',
}
---

<div
  class="w-full overflow-hidden leading-none"
  style={`background-color: ${bgColor}; ${flip ? 'transform: rotate(180deg);' : ''}`}
>
  <svg
    viewBox="0 0 1440 64"
    preserveAspectRatio="none"
    class="w-full block"
    style={`height: ${height}px;`}
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d={paths[type] || paths.wave} fill={color}></path>
  </svg>
</div>
