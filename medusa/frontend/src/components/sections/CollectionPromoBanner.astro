---
/**
 * Collection Promo Banner - promotional banner within collection pages
 * Like Olympus theme's collection-promo-banner section
 */
interface Props {
  title?: string
  text?: string
  ctaText?: string
  ctaLink?: string
  image?: string
  position?: number
}

const {
  title = '',
  text = '',
  ctaText = 'Découvrir',
  ctaLink = '#',
  image = '',
  position = 4,
} = Astro.props
---

{title && (
  <div class="col-span-full my-4">
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-primary/10 via-secondary/5 to-primary/10 border border-primary/10 p-8 lg:p-10">
      <div class="flex flex-col md:flex-row items-center gap-6">
        {image && (
          <div class="w-24 h-24 rounded-2xl overflow-hidden shrink-0 bg-white shadow-sm">
            <img src={image} alt={title} class="w-full h-full object-contain p-2" loading="lazy" />
          </div>
        )}
        <div class="flex-1 text-center md:text-left">
          <h3 class="text-lg lg:text-xl font-semibold text-text">{title}</h3>
          {text && <p class="mt-2 text-sm text-text-light">{text}</p>}
        </div>
        <a href={ctaLink} class="btn btn-primary shrink-0 px-8 py-3">
          {ctaText}
        </a>
      </div>
    </div>
  </div>
)}
