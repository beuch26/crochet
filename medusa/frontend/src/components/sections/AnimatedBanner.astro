---
/**
 * Animated Banner - hero-style banner with gradient text and animations
 * Like Olympus theme's animated-banner section
 */
interface Props {
  title?: string
  subtitle?: string
  ctaText?: string
  ctaLink?: string
  bgImage?: string
  gradientText?: boolean
  size?: 'sm' | 'md' | 'lg'
}

const {
  title = '',
  subtitle = '',
  ctaText = '',
  ctaLink = '',
  bgImage = '',
  gradientText = true,
  size = 'md',
} = Astro.props

const sizeMap = { sm: 'py-16 lg:py-20', md: 'py-24 lg:py-32', lg: 'py-32 lg:py-44' }
---

{title && (
  <section class={`relative overflow-hidden ${sizeMap[size]} reveal`}>
    {bgImage ? (
      <>
        <img src={bgImage} alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-black/30"></div>
      </>
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-gray-950 via-gray-900 to-primary/30"></div>
    )}

    <!-- Animated shapes -->
    <div class="absolute top-1/4 -left-20 w-72 h-72 bg-primary/10 rounded-full blur-3xl animate-float"></div>
    <div class="absolute bottom-1/4 -right-20 w-96 h-96 bg-secondary/10 rounded-full blur-3xl animate-float delay-3"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class={`text-3xl lg:text-5xl xl:text-6xl font-bold leading-tight animate-fade-up ${
        gradientText
          ? 'bg-gradient-to-r from-white via-primary-light to-secondary bg-clip-text text-transparent'
          : 'text-white'
      }`}>
        {title}
      </h2>

      {subtitle && (
        <p class="mt-6 text-lg lg:text-xl text-white/70 max-w-2xl mx-auto animate-fade-up delay-1">
          {subtitle}
        </p>
      )}

      {ctaText && ctaLink && (
        <div class="mt-10 animate-fade-up delay-2">
          <a href={ctaLink} class="inline-flex items-center gap-2 px-10 py-4 bg-white text-text font-semibold rounded-full hover:shadow-xl hover:shadow-white/20 hover:-translate-y-0.5 transition-all text-base">
            {ctaText}
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .bg-clip-text {
    -webkit-background-clip: text;
    background-clip: text;
  }
</style>
