---
/**
 * Shoppable Image / Shop the Look
 * Display a lifestyle image with product hotspots that link to products
 */
interface Hotspot {
  x: number       // percentage from left (0-100)
  y: number       // percentage from top (0-100)
  title: string
  price?: string
  handle: string
  thumbnail?: string
}

interface Props {
  image: string
  alt?: string
  title?: string
  subtitle?: string
  hotspots: Hotspot[]
}

const { image, alt = '', title = '', subtitle = '', hotspots = [] } = Astro.props
---

{hotspots.length > 0 && (
  <section class="py-16 lg:py-20 reveal">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {(title || subtitle) && (
        <div class="text-center mb-10 max-w-2xl mx-auto">
          {title && <h2>{title}</h2>}
          {subtitle && <p class="mt-3 text-text-light text-lg">{subtitle}</p>}
        </div>
      )}

      <div class="relative rounded-2xl overflow-hidden border border-border-light shadow-lg group">
        <img src={image} alt={alt || title} class="w-full h-auto" loading="lazy" />

        {hotspots.map((spot, i) => (
          <div
            class="shoppable-hotspot absolute z-10"
            style={`left: ${spot.x}%; top: ${spot.y}%; transform: translate(-50%, -50%)`}
          >
            <!-- Ping animation -->
            <button
              type="button"
              data-hotspot={i}
              class="relative w-8 h-8 rounded-full bg-white shadow-lg border-2 border-primary flex items-center justify-center cursor-pointer hover:scale-125 transition-transform"
              aria-label={`Voir ${spot.title}`}
            >
              <span class="w-3 h-3 rounded-full bg-primary"></span>
              <span class="absolute inset-0 rounded-full bg-primary/30 animate-ping"></span>
            </button>

            <!-- Tooltip card -->
            <div
              data-hotspot-card={i}
              class="hidden absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-52 bg-white rounded-xl shadow-xl border border-border-light overflow-hidden z-20 animate-fade-up"
            >
              {spot.thumbnail && (
                <div class="h-28 bg-bg-light overflow-hidden">
                  <img src={spot.thumbnail} alt={spot.title} class="w-full h-full object-contain p-2" loading="lazy" />
                </div>
              )}
              <div class="p-3">
                <p class="text-sm font-medium text-text line-clamp-2">{spot.title}</p>
                {spot.price && <p class="text-sm font-bold text-primary mt-1">{spot.price}</p>}
                <a
                  href={`/products/${spot.handle}/`}
                  class="mt-2 block text-center text-xs font-semibold text-white bg-primary hover:bg-primary-hover rounded-lg py-1.5 transition-colors"
                >
                  Voir le produit
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  document.querySelectorAll('[data-hotspot]').forEach(btn => {
    const idx = btn.getAttribute('data-hotspot')
    const card = document.querySelector(`[data-hotspot-card="${idx}"]`)

    btn.addEventListener('click', (e) => {
      e.stopPropagation()
      // Close all other cards
      document.querySelectorAll('[data-hotspot-card]').forEach(c => c.classList.add('hidden'))
      card?.classList.toggle('hidden')
    })
  })

  // Close cards when clicking outside
  document.addEventListener('click', () => {
    document.querySelectorAll('[data-hotspot-card]').forEach(c => c.classList.add('hidden'))
  })
</script>
