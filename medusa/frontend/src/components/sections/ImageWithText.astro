---
interface Props {
  title: string
  text: string
  image: string
  imageAlt?: string
  ctaText?: string
  ctaLink?: string
  reverse?: boolean
}

const { title, text, image, imageAlt = '', ctaText, ctaLink, reverse = false } = Astro.props
---

<section class="py-16 lg:py-20 reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class:list={["grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center", reverse && "lg:direction-rtl"]}>
      <div class:list={["overflow-hidden rounded-2xl", reverse && "lg:order-2"]}>
        <img src={image} alt={imageAlt || title} loading="lazy" class="w-full h-auto rounded-2xl" />
      </div>
      <div class:list={[reverse && "lg:order-1"]}>
        <h2>{title}</h2>
        <p class="mt-4 text-text-light leading-relaxed">{text}</p>
        {ctaText && ctaLink && (
          <a href={ctaLink} class="btn btn-primary mt-6 inline-flex">{ctaText}</a>
        )}
      </div>
    </div>
  </div>
</section>
