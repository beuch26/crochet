---
/**
 * Timeline - journey/process steps display
 * Like Olympus theme's timeline section
 */
interface Step {
  title: string
  text: string
  icon?: string
}

interface Props {
  title?: string
  subtitle?: string
  steps?: Step[]
}

const {
  title = 'Comment ça marche',
  subtitle = '',
  steps = [
    { title: 'Choisissez', text: 'Parcourez notre sélection de produits pour bébé et maman.' },
    { title: 'Commandez', text: 'Ajoutez au panier et finalisez en quelques clics.' },
    { title: 'Recevez', text: 'Livraison rapide et soignée en 3-5 jours ouvrés.' },
    { title: 'Profitez', text: 'Satisfait ou remboursé pendant 30 jours.' },
  ],
} = Astro.props
---

<section class="py-16 lg:py-20 reveal">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    {(title || subtitle) && (
      <div class="text-center mb-14 max-w-2xl mx-auto">
        {title && <h2>{title}</h2>}
        {subtitle && <p class="mt-3 text-text-light text-lg">{subtitle}</p>}
      </div>
    )}

    <div class="relative">
      <!-- Connection line -->
      <div class="hidden md:block absolute top-10 left-0 right-0 h-0.5 bg-gradient-to-r from-primary/20 via-primary to-primary/20"></div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        {steps.map((step, i) => (
          <div class="relative text-center">
            <!-- Step number -->
            <div class="relative z-10 w-20 h-20 mx-auto mb-5 rounded-full bg-white border-2 border-primary shadow-lg shadow-primary/10 flex items-center justify-center">
              <span class="text-2xl font-bold text-primary font-['DM_Sans']">{i + 1}</span>
            </div>
            <h3 class="text-base font-semibold font-['DM_Sans'] mb-2">{step.title}</h3>
            <p class="text-sm text-text-light leading-relaxed">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
