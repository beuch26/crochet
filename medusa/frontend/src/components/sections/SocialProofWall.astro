---
/**
 * Social Proof Wall - Masonry grid of customer testimonials
 * Like the Olympus theme's social-proof-wall section
 */
interface Review {
  name: string
  rating: number
  text: string
  product?: string
  date?: string
  avatar?: string
}

interface Props {
  title?: string
  subtitle?: string
  reviews?: Review[]
}

const {
  title = 'Ce que disent nos clientes',
  subtitle = 'Des mamans comme vous partagent leur expérience',
  reviews = [
    { name: 'Marie L.', rating: 5, text: "Les coquillages d'allaitement sont incroyables ! Fini les douleurs dès le premier jour. Je recommande à 100%. Le coffret est magnifique aussi, parfait pour un cadeau.", product: 'Coffret allaitement naturel', date: 'Mars 2026' },
    { name: 'Sophie D.', rating: 5, text: "Livraison ultra rapide et produit conforme à la description. Le casque anti-bruit est parfait pour les sorties avec bébé.", product: 'Alpine Baby Muffy', date: 'Février 2026' },
    { name: 'Camille R.', rating: 5, text: "J'adore le bola de grossesse ! Le son est très doux et apaisant. Mon bébé réagit déjà quand je le porte.", product: 'Bola de grossesse éléphant', date: 'Mars 2026' },
    { name: 'Laura M.', rating: 4, text: "Très bon tire-lait, silencieux et efficace. Petit bémol sur les téterelles qui pourraient être plus souples.", product: 'Tire-lait électrique portable', date: 'Janvier 2026' },
    { name: 'Émilie P.', rating: 5, text: "Le soutien-gorge d'allaitement est ultra confortable ! Enfin un modèle qui tient bien sans comprimer. Je l'ai pris en 3 couleurs.", product: "Soutien-gorge d'allaitement", date: 'Février 2026' },
    { name: 'Julie F.', rating: 5, text: "Service client au top ! J'avais une question sur la taille et ils m'ont répondu en 2h. Le produit est parfait.", date: 'Mars 2026' },
    { name: 'Nadia K.', rating: 5, text: "Les compresses apaisantes sont magiques après les tétées. Je ne peux plus m'en passer !", product: 'Compresses chaud-froid', date: 'Février 2026' },
    { name: 'Aurélie B.', rating: 4, text: "Très contente de la trousse de soin bébé. Tout est bien rangé et de bonne qualité. Idéal pour la maternité.", product: 'Kit de soins bébé', date: 'Janvier 2026' },
  ],
} = Astro.props
---

<section class="py-16 lg:py-20 bg-bg-light reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {(title || subtitle) && (
      <div class="text-center mb-12 max-w-2xl mx-auto">
        {title && <h2>{title}</h2>}
        {subtitle && <p class="mt-3 text-text-light text-lg">{subtitle}</p>}
      </div>
    )}

    <!-- Masonry grid -->
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 lg:gap-6 space-y-4 lg:space-y-6">
      {reviews.map((review, i) => (
        <div class={`break-inside-avoid bg-white rounded-2xl p-6 border border-border-light shadow-sm hover:shadow-md transition-shadow duration-300 ${i % 3 === 0 ? 'reveal' : ''}`}>
          <!-- Stars -->
          <div class="flex items-center gap-0.5 mb-3">
            {Array.from({ length: 5 }).map((_, s) => (
              <svg class={`w-4 h-4 ${s < review.rating ? 'text-amber-400' : 'text-gray-200'}`} fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Review text -->
          <p class="text-sm text-text-light leading-relaxed">{review.text}</p>

          <!-- Product tag -->
          {review.product && (
            <span class="inline-block mt-3 px-3 py-1 bg-primary/5 text-primary text-xs font-medium rounded-full">
              {review.product}
            </span>
          )}

          <!-- Author -->
          <div class="flex items-center gap-3 mt-4 pt-4 border-t border-border-light">
            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-primary/20 to-secondary/20 flex items-center justify-center text-primary font-semibold text-sm">
              {review.name.charAt(0)}
            </div>
            <div>
              <p class="text-sm font-medium text-text">{review.name}</p>
              {review.date && <p class="text-xs text-text-muted">{review.date}</p>}
            </div>
            <div class="ml-auto">
              <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
