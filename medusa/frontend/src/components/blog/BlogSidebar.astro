---
import { blogImageUrl, blogPostPath } from '../../lib/blog'
import { slugify } from '../../lib/url'

interface Props {
  categories: string[]
  recentPosts: any[]
  currentHandle?: string
}

const { categories, recentPosts, currentHandle } = Astro.props
---

<aside class="space-y-8">
  <!-- Search -->
  <div class="bg-white p-5 rounded-2xl border border-border-light">
    <p class="text-base font-semibold font-['DM_Sans'] mb-3 text-text">Rechercher</p>
    <div class="relative">
      <input
        type="search"
        placeholder="Rechercher un article..."
        class="w-full pl-10 pr-4 py-2.5 text-sm border border-border rounded-xl bg-bg-light focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
      />
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-text-muted absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </div>

  <!-- Categories -->
  {categories.length > 0 && (
    <div class="bg-white p-5 rounded-2xl border border-border-light">
      <p class="text-base font-semibold font-['DM_Sans'] mb-3 text-text">Catégories</p>
      <div class="space-y-1.5">
        {categories.map((cat) => (
          <a href={`/blog/?cat=${slugify(cat)}`} class="flex items-center justify-between py-2 px-3 text-sm text-text-light hover:text-primary hover:bg-primary/5 rounded-lg transition-all">
            <span>{cat}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Recent posts -->
  {recentPosts.length > 0 && (
    <div class="bg-white p-5 rounded-2xl border border-border-light">
      <p class="text-base font-semibold font-['DM_Sans'] mb-3 text-text">Articles récents</p>
      <div class="space-y-3">
        {recentPosts.filter((p: any) => p.handle !== currentHandle).slice(0, 5).map((post: any) => (
          <a href={blogPostPath(post)} class="flex items-start gap-3 group">
            {blogImageUrl(post.featured_image) && (
              <div class="w-20 aspect-video rounded-lg overflow-hidden shrink-0 bg-bg-light">
                <img
                  src={blogImageUrl(post.featured_image)!}
                  alt={post.title}
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              </div>
            )}
            <div class="min-w-0">
              <p class="text-sm font-medium text-text group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                {post.title}
              </p>
              {post.published_at && (
                <time datetime={post.published_at} class="text-xs text-text-muted mt-1 block">
                  {new Date(post.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}
                </time>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Newsletter mini -->
  <div class="bg-gradient-to-br from-primary to-secondary p-6 rounded-2xl text-white">
    <p class="text-base font-semibold mb-2">Newsletter</p>
    <p class="text-sm text-white/80 mb-4">Recevez nos derniers articles</p>
    <form data-newsletter-form class="space-y-2">
      <input
        type="email"
        placeholder="Email"
        required
        class="w-full px-4 py-2.5 text-sm rounded-xl bg-white/15 border border-white/20 text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-white/30"
      />
      <button type="submit" class="w-full py-2.5 bg-white text-primary text-sm font-semibold rounded-xl hover:bg-white/90 transition-colors">
        S'inscrire
      </button>
    </form>
  </div>
</aside>
