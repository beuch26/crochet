---
interface Props {
  title?: string
  subtitle?: string
  placeholder?: string
  button_text?: string
  incentive?: string
  background_style?: 'white' | 'light' | 'gradient' | 'image'
  background_image?: string
}

const {
  title = 'Rejoignez notre communauté',
  subtitle = 'Recevez nos conseils et offres exclusives',
  placeholder = 'Votre email',
  button_text = "S'inscrire",
  incentive,
  background_style = 'gradient',
  background_image,
} = Astro.props

const isDark = background_style === 'gradient' || background_style === 'image'
---

<section class="py-16 lg:py-20 reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class={`relative overflow-hidden rounded-3xl p-10 lg:p-16 text-center ${isDark ? 'text-white' : 'text-text'} ${
      background_style === 'gradient' ? 'bg-gradient-to-br from-primary to-secondary' :
      background_style === 'light' ? 'bg-bg-light' :
      background_style === 'white' ? 'bg-white border border-border-light' :
      'bg-gray-900'
    }`}>
      {background_style === 'image' && background_image && (
        <img src={background_image} alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-30" />
      )}
      {(background_style === 'gradient' || background_style === 'image') && (
        <>
          <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
          <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>
        </>
      )}
      <div class="relative">
        {incentive && (
          <span class={`inline-block px-3 py-1 ${isDark ? 'bg-white/20 text-white' : 'bg-primary/10 text-primary'} text-xs font-semibold rounded-full mb-4 uppercase tracking-wider`}>
            {incentive}
          </span>
        )}
        {title && <h2 class="text-2xl lg:text-3xl" style={isDark ? 'color:#fff' : undefined}>{title}</h2>}
        {subtitle && (
          <p class={`mt-4 text-lg max-w-xl mx-auto ${isDark ? 'text-white' : 'text-text-light'}`} style={isDark ? 'color:rgba(255,255,255,0.92)' : undefined}>
            {subtitle}
          </p>
        )}
        <form data-newsletter-form class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 max-w-lg mx-auto">
          <input
            type="email"
            placeholder={placeholder}
            required
            class={`w-full sm:flex-1 px-5 py-3.5 rounded-full focus:outline-none focus:ring-2 ${
              isDark
                ? 'bg-white/15 border border-white/20 text-white placeholder-white/60 focus:ring-white/40 backdrop-blur-sm'
                : 'bg-white border border-border focus:ring-primary/20 focus:border-primary'
            }`}
          />
          <button type="submit" class={`shrink-0 px-7 py-3.5 font-semibold rounded-full transition-all ${
            isDark ? 'btn btn-white' : 'btn btn-primary'
          }`}>
            {button_text}
          </button>
        </form>
        <p class={`mt-4 text-xs ${isDark ? 'text-white' : 'text-text-muted'}`} style={isDark ? 'color:rgba(255,255,255,0.78)' : undefined}>
          Pas de spam. Désinscription en un clic.
        </p>
      </div>
    </div>
  </div>
</section>
