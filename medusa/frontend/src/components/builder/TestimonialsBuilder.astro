---
interface Testimonial {
  name: string
  location?: string
  image?: string
  rating: number
  text: string
  product?: string
}
interface Props {
  title?: string
  subtitle?: string
  layout?: 'grid_2' | 'grid_3' | 'carousel'
  items?: Testimonial[]
}

const {
  title = 'Ce que disent nos clients',
  subtitle,
  layout = 'grid_3',
  items = [],
} = Astro.props

const gridClass = {
  grid_2: 'lg:grid-cols-2',
  grid_3: 'lg:grid-cols-3',
  carousel: 'lg:grid-cols-3',
}[layout]
---

{items.length > 0 && (
  <section class="py-16 lg:py-20 reveal">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        {title && <h2>{title}</h2>}
        {subtitle && <p class="mt-3 text-text-light text-lg">{subtitle}</p>}
      </div>

      <div class={`grid grid-cols-1 md:grid-cols-2 ${gridClass} gap-6`}>
        {items.map((t) => (
          <div class="bg-white p-6 lg:p-8 rounded-2xl border border-border-light card-hover relative overflow-hidden">
            <svg class="absolute top-4 right-4 w-16 h-16 text-primary/5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
            <div class="flex items-center gap-0.5 mb-4 relative">
              {Array.from({ length: t.rating || 5 }).map(() => (
                <svg class="w-5 h-5 text-warning" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-text-light leading-relaxed text-sm italic relative">"{t.text}"</p>
            <div class="mt-5 pt-5 border-t border-border-light flex items-center gap-3">
              {t.image && (
                <img src={t.image} alt={t.name} loading="lazy" width="48" height="48" class="w-12 h-12 rounded-full object-cover border-2 border-primary/10" />
              )}
              <div class="flex-1">
                <p class="text-sm font-semibold text-text">{t.name}</p>
                {t.location && (
                  <p class="text-xs text-text-muted">{t.location}</p>
                )}
              </div>
            </div>
            {t.product && (
              <p class="mt-3 text-xs text-text-muted">
                Produit : <span class="text-primary font-medium">{t.product}</span>
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
