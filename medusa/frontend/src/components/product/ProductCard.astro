---
import WishlistButton from './WishlistButton.astro'

interface Props {
  id: string
  title: string
  handle: string
  price: number
  compareAtPrice?: number
  currency?: string
  thumbnail?: string
  hoverImage?: string
  affiliateUrl?: string
  affiliateLabel?: string
  badge?: string // "new" | "bestseller" | "outofstock" | custom text
  createdAt?: string
  inventoryQuantity?: number
}

const { id, title, handle, price, compareAtPrice, currency = 'EUR', thumbnail, hoverImage, affiliateUrl, affiliateLabel, badge, createdAt, inventoryQuantity } = Astro.props
const isAffiliate = !!affiliateUrl

const formatPrice = (amount: number) =>
  amount === 0 ? 'Gratuit' : new Intl.NumberFormat('fr-FR', { style: 'currency', currency }).format(amount)

const hasDiscount = compareAtPrice && compareAtPrice > price
const discountPercent = hasDiscount
  ? Math.round(((compareAtPrice - price) / compareAtPrice) * 100)
  : 0

// Auto-detect badge
const isNew = !badge && createdAt && (Date.now() - new Date(createdAt).getTime()) < 30 * 24 * 60 * 60 * 1000 // 30 days
const isOutOfStock = inventoryQuantity !== undefined && inventoryQuantity <= 0
const badgeText = badge || (isNew ? 'Nouveau' : '')
const badgeColor = badge === 'bestseller' ? 'bg-amber-500' : badge === 'outofstock' || isOutOfStock ? 'bg-gray-500' : 'bg-primary'
---

<article class="group relative bg-white rounded-2xl overflow-hidden border border-border-light card-hover">
  <WishlistButton productId={id} productHandle={handle} />
  <a href={`/products/${handle}/`} class="block">
    <!-- Image -->
    <div class="aspect-square overflow-hidden bg-bg-light relative">
      {thumbnail ? (
        <>
          <img
            src={thumbnail}
            alt={title}
            loading="lazy"
            width="400"
            height="400"
            class={`h-full w-full object-cover object-top transition-all duration-500 ease-out ${isOutOfStock ? 'opacity-50 grayscale' : ''} ${hoverImage ? 'group-hover:opacity-0 group-hover:scale-105' : 'group-hover:scale-105'}`}
          />
          {hoverImage && !isOutOfStock && (
            <img
              src={hoverImage}
              alt={title}
              loading="lazy"
              width="400"
              height="400"
              class="absolute inset-0 h-full w-full object-cover object-top opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out scale-105 group-hover:scale-100"
            />
          )}
        </>
      ) : (
        <div class="h-full w-full flex items-center justify-center text-text-muted">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      )}

      <!-- Badges stack (top-left) -->
      <div class="absolute top-3 left-3 flex flex-col gap-1.5">
        {hasDiscount && (
          <span class="bg-error text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-sm">
            -{discountPercent}%
          </span>
        )}
        {badgeText && !isOutOfStock && (
          <span class={`${badgeColor} text-white text-[10px] font-bold px-2.5 py-1 rounded-full shadow-sm uppercase tracking-wide`}>
            {badgeText}
          </span>
        )}
        {isOutOfStock && (
          <span class="bg-gray-600 text-white text-[10px] font-bold px-2.5 py-1 rounded-full shadow-sm uppercase tracking-wide">
            Rupture
          </span>
        )}
      </div>


      {/* Low stock indicator */}
      {inventoryQuantity !== undefined && inventoryQuantity > 0 && inventoryQuantity <= 5 && (
        <div class="absolute bottom-3 left-3 right-3">
          <span class="text-[10px] font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full">
            Plus que {inventoryQuantity} en stock
          </span>
        </div>
      )}
    </div>

    <!-- Info -->
    <div class="p-3.5 lg:p-4">
      <p class="product-card-title group-hover:text-primary transition-colors duration-200 line-clamp-2 min-h-[2.3rem]">
        {title}
      </p>
      <div class="mt-2 flex items-baseline gap-1.5">
        {isOutOfStock ? (
          <span class="text-sm font-medium text-text-muted">Indisponible</span>
        ) : (
          <>
            <span class={`text-base lg:text-[17px] font-bold ${hasDiscount ? 'text-error' : 'text-text'}`}>{formatPrice(price)}</span>
            {hasDiscount && (
              <span class="text-xs text-text-muted line-through">{formatPrice(compareAtPrice)}</span>
            )}
          </>
        )}
      </div>
    </div>
  </a>
</article>
