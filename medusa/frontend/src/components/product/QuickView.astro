---
// Quick View modal - triggered by product cards
---

<div id="quick-view-overlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[80] hidden opacity-0 transition-opacity duration-300"></div>

<div id="quick-view-modal" class="fixed inset-0 z-[81] hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[85vh] overflow-y-auto relative animate-fade-up">
    <button id="qv-close" type="button" aria-label="Fermer" class="absolute top-4 right-4 z-10 p-2 bg-white/90 text-text-muted hover:text-text rounded-full shadow-sm hover:shadow transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
      <!-- Image -->
      <div id="qv-image" class="aspect-square bg-bg-light flex items-center justify-center p-8">
        <div class="text-text-muted">Chargement...</div>
      </div>

      <!-- Info -->
      <div class="p-6 lg:p-8 flex flex-col">
        <div id="qv-category" class="text-xs font-semibold text-primary uppercase tracking-widest mb-2"></div>
        <span id="qv-title" class="block text-xl font-['DM_Serif_Display'] leading-tight" role="heading" aria-level="2"></span>
        <p id="qv-price" class="mt-3 text-2xl font-bold text-text font-['DM_Sans']"></p>
        <p id="qv-subtitle" class="mt-3 text-sm text-text-light line-clamp-3"></p>

        <div class="mt-auto pt-6 space-y-3">
          <button id="qv-add-to-cart" type="button" class="add-to-cart w-full py-3.5 bg-primary text-white font-semibold rounded-xl hover:bg-primary-hover transition-all text-sm shadow-lg shadow-primary/20">
            Ajouter au panier
          </button>
          <a id="qv-link" href="#" class="block text-center text-sm text-primary hover:underline">
            Voir les détails
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const MEDUSA_URL = document.querySelector('meta[name="medusa-url"]')?.getAttribute('content') || ''
  const API_KEY = document.querySelector('meta[name="medusa-key"]')?.getAttribute('content') || ''
  const REGION_ID = document.querySelector('meta[name="medusa-region-id"]')?.getAttribute('content') || 'reg_01KNMDW1PJAW5BV63ARBR3V1XH'

  function formatPrice(amount: number) {
    if (amount === 0) return 'Gratuit'
    return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(amount)
  }

  const overlay = document.getElementById('quick-view-overlay')
  const modal = document.getElementById('quick-view-modal')

  function closeQV() {
    overlay?.classList.add('opacity-0')
    setTimeout(() => {
      modal?.classList.add('hidden')
      overlay?.classList.add('hidden')
    }, 300)
    document.body.style.overflow = ''
  }

  document.getElementById('qv-close')?.addEventListener('click', closeQV)
  overlay?.addEventListener('click', closeQV)

  async function openQuickView(handle: string) {
    modal?.classList.remove('hidden')
    overlay?.classList.remove('hidden')
    setTimeout(() => overlay?.classList.remove('opacity-0'), 10)
    document.body.style.overflow = 'hidden'

    try {
      const res = await fetch(`${MEDUSA_URL}/store/products?handle=${handle}&region_id=${REGION_ID}&fields=+variants.calculated_price`, {
        headers: { 'x-publishable-api-key': API_KEY },
      })
      const data = await res.json()
      const product = data.products?.[0]
      if (!product) return

      const variant = product.variants?.[0]
      const price = variant?.calculated_price?.calculated_amount || 0

      const imgEl = document.getElementById('qv-image')!
      imgEl.innerHTML = product.thumbnail
        ? `<img src="${product.thumbnail}" alt="${product.title}" class="w-full h-full object-contain" />`
        : '<div class="text-text-muted opacity-30">Pas d\'image</div>'

      document.getElementById('qv-title')!.textContent = product.title
      document.getElementById('qv-price')!.textContent = formatPrice(price)
      document.getElementById('qv-subtitle')!.textContent = product.subtitle?.replace(/<[^>]*>/g, '') || ''
      document.getElementById('qv-category')!.textContent = product.collection?.title || ''

      const link = document.getElementById('qv-link') as HTMLAnchorElement
      link.href = `/products/${product.handle}/`

      const atcBtn = document.getElementById('qv-add-to-cart')!
      atcBtn.setAttribute('data-variant-id', variant?.id || '')
      atcBtn.setAttribute('data-price', formatPrice(price))
    } catch (e) {
      console.error('Quick view error:', e)
    }
  }

  // Bind quick view buttons
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('[data-quick-view]')
    if (btn) {
      e.preventDefault()
      e.stopPropagation()
      const handle = btn.getAttribute('data-quick-view')
      if (handle) openQuickView(handle)
    }
  })
</script>
