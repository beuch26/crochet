---
/**
 * Mobile Bottom Navigation Bar
 * Fixed bar at the bottom on mobile with 5 tabs
 */
---

<nav id="mobile-nav" class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-border-light lg:hidden safe-bottom transition-transform duration-300">
  <div class="grid grid-cols-5 h-14">
    <a href="/" class="mobile-nav-item flex flex-col items-center justify-center gap-0.5 text-text-muted" data-page="home">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>
      <span class="text-[10px] font-medium">Accueil</span>
    </a>
    <a href="/collections/" class="mobile-nav-item flex flex-col items-center justify-center gap-0.5 text-text-muted" data-page="collections">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
      <span class="text-[10px] font-medium">Boutique</span>
    </a>
    <button type="button" data-open-search class="mobile-nav-item flex flex-col items-center justify-center gap-0.5 text-text-muted">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
      <span class="text-[10px] font-medium">Recherche</span>
    </button>
    <a href="/wishlist/" class="mobile-nav-item flex flex-col items-center justify-center gap-0.5 text-text-muted relative" data-page="wishlist">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
      <span class="text-[10px] font-medium">Favoris</span>
      <span id="mob-wl-count" class="hidden absolute top-0.5 right-1/2 translate-x-3 bg-accent text-white text-[8px] rounded-full w-3.5 h-3.5 flex items-center justify-center font-bold">0</span>
    </a>
    <a href="/account/" class="mobile-nav-item flex flex-col items-center justify-center gap-0.5 text-text-muted" data-page="account">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
      <span class="text-[10px] font-medium">Compte</span>
    </a>
  </div>
</nav>

<style>
  .safe-bottom { padding-bottom: env(safe-area-inset-bottom, 0px); }
  .mobile-nav-item.active { color: var(--color-primary, #2563eb); }
</style>

<script>
  // Highlight active tab
  const path = window.location.pathname
  document.querySelectorAll('.mobile-nav-item').forEach(item => {
    const page = (item as HTMLElement).dataset.page
    if (
      (page === 'home' && path === '/') ||
      (page === 'collections' && path.startsWith('/collections')) ||
      (page === 'wishlist' && (path === '/wishlist' || path === '/wishlist/')) ||
      (page === 'account' && (path === '/account' || path === '/account/'))
    ) {
      item.classList.add('active')
      item.classList.remove('text-text-muted')
    }
  })

  // Wishlist count
  try {
    const wl = JSON.parse(localStorage.getItem('mck_wishlist') || '[]')
    const badge = document.getElementById('mob-wl-count')
    if (badge && wl.length > 0) {
      badge.textContent = String(wl.length)
      badge.classList.remove('hidden')
    }
  } catch {}
</script>
