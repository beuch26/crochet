---
// Newsletter popup - exit intent or delayed
---

<div id="nl-popup-overlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[90] hidden opacity-0 transition-opacity duration-300"></div>

<div id="nl-popup" class="fixed inset-0 z-[91] hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-8 relative animate-fade-up">
    <button id="nl-popup-close" type="button" aria-label="Fermer" class="absolute top-4 right-4 p-2 text-text-muted hover:text-text rounded-lg hover:bg-bg-light transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="text-center">
      <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-primary to-secondary flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
      </div>
      <p class="text-xl lg:text-2xl font-['DM_Serif_Display'] text-text">10% de réduction</p>
      <p class="mt-3 text-text-light text-sm leading-relaxed">
        Inscrivez-vous à notre newsletter et recevez un code promo de <strong class="text-text">10%</strong> sur votre première commande.
      </p>
    </div>

    <form class="mt-6 space-y-3" id="nl-popup-form">
      <input
        type="email"
        placeholder="Votre adresse email"
        required
        class="w-full px-4 py-3 border border-border rounded-xl bg-white text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
      />
      <button type="submit" class="btn btn-primary w-full py-3">
        Recevoir mon code promo
      </button>
    </form>

    <p class="mt-3 text-center text-xs text-text-muted">Pas de spam. Désinscription en un clic.</p>
  </div>
</div>

<script>
  const popup = document.getElementById('nl-popup')
  const overlay = document.getElementById('nl-popup-overlay')
  const dismissed = localStorage.getItem('nl_popup_dismissed')

  function showPopup() {
    if (dismissed || !popup || !overlay) return
    popup.classList.remove('hidden')
    overlay.classList.remove('hidden')
    setTimeout(() => overlay.classList.remove('opacity-0'), 10)
    document.body.style.overflow = 'hidden'
  }

  function hidePopup() {
    overlay?.classList.add('opacity-0')
    setTimeout(() => {
      popup?.classList.add('hidden')
      overlay?.classList.add('hidden')
    }, 300)
    document.body.style.overflow = ''
    localStorage.setItem('nl_popup_dismissed', '1')
  }

  document.getElementById('nl-popup-close')?.addEventListener('click', hidePopup)
  overlay?.addEventListener('click', hidePopup)

  document.getElementById('nl-popup-form')?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const form = e.target as HTMLFormElement
    const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement
    const email = emailInput?.value

    if (!email) return

    const MEDUSA_URL = document.querySelector('meta[name="medusa-url"]')?.getAttribute('content') || ''
    const API_KEY = document.querySelector('meta[name="medusa-key"]')?.getAttribute('content') || ''

    btn.disabled = true
    btn.textContent = 'Inscription...'

    try {
      await fetch(`${MEDUSA_URL}/store/newsletter`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-publishable-api-key': API_KEY },
        body: JSON.stringify({ email }),
      })
      btn.textContent = 'Merci !'
      btn.classList.remove('bg-primary')
      btn.classList.add('bg-success')
      setTimeout(hidePopup, 1500)
    } catch {
      btn.textContent = 'Erreur, réessayez'
      btn.disabled = false
    }
  })

  // Show after 15s or on exit intent
  if (!dismissed) {
    setTimeout(showPopup, 15000)

    document.addEventListener('mouseout', (e) => {
      if (e.clientY <= 0) showPopup()
    }, { once: true })
  }
</script>
