---
/**
 * Footer — repris du thème Shopify Magic Crochet Kit.
 * Structure : wave-animated divider noir, fond noir, 3 colonnes (Logo+desc+social,
 * Menu principal, Mentions légales), bottom (copyright + payment icons).
 */
import PaymentIcons from './PaymentIcons.astro'

interface Props {
  copyright?: string
  showPayment?: boolean
  socialFacebook?: string
  socialInstagram?: string
  socialTiktok?: string
  socialYoutube?: string
  socialPinterest?: string
  socialTwitter?: string
  logoUrl?: string
  siteName?: string
}

const {
  copyright = `© ${new Date().getFullYear()} Magic Crochet Kit. Tous droits réservés.`,
  showPayment = true,
  socialFacebook = '',
  socialInstagram = '',
  socialTiktok = '',
  socialYoutube = '',
  socialPinterest = '',
  socialTwitter = '',
  logoUrl = '/images/logo-noir.png',
  siteName = 'Magic Crochet Kit',
} = Astro.props

// Menus issus de Shopify (linklists main-menu + menu-mention-legal)
const mainMenu = [
  { title: 'Kits de crochet', url: '/collections/kits-de-crochet/' },
  { title: 'Modèles crochet', url: '/collections/modeles-crochet/' },
  { title: 'Fils & matériaux', url: '/collections/fils-materiaux/' },
  { title: 'Tutoriels & aide', url: '/blog/' },
]

const legalMenu = [
  { title: 'Contact', url: '/contact/' },
  { title: 'Mentions légales', url: '/mentions-legales/' },
  { title: 'Conditions générales', url: '/cgv/' },
  { title: 'Politique de confidentialité', url: '/politique-de-confidentialite/' },
]

const description = 'Apprenez le crochet facilement avec nos kits tout-en-un pour débutants. Créez vos premières pièces avec confiance !'
---

<!-- Wave divider animé (repris du thème Shopify) -->
<div class="footer-divider" aria-hidden="true">
  <svg viewBox="0 24 150 28" preserveAspectRatio="none">
    <defs>
      <path id="footer-wave-path" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z"></path>
    </defs>
    <g class="footer-wave-parallax footer-wave-parallax--1"><use href="#footer-wave-path" x="48" y="0" fill="#000" style="opacity:.7"/></g>
    <g class="footer-wave-parallax footer-wave-parallax--2"><use href="#footer-wave-path" x="48" y="3" fill="#000" style="opacity:.5"/></g>
    <g class="footer-wave-parallax footer-wave-parallax--3"><use href="#footer-wave-path" x="48" y="5" fill="#000" style="opacity:.3"/></g>
    <g class="footer-wave-parallax footer-wave-parallax--4"><use href="#footer-wave-path" x="48" y="7" fill="#000"/></g>
  </svg>
</div>

<footer class="bg-black text-white/80" role="contentinfo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-12">

      <!-- Colonne 1: Logo + description + social -->
      <div>
        <a href="/" aria-label={siteName} class="inline-block mb-4">
          <img src={logoUrl} alt={siteName} class="h-12 w-auto object-contain max-w-[180px]" width="180" height="48" loading="lazy" />
        </a>
        <p class="text-sm leading-relaxed text-white/70 max-w-md">{description}</p>

        <div class="flex items-center gap-3 mt-6">
          {socialFacebook && (
            <a href={socialFacebook} target="_blank" rel="noopener" aria-label="Facebook" class="text-white/70 hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M20 10C20 4.477 15.523 0 10 0S0 4.477 0 10c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V10h2.54V7.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V10h2.773l-.443 2.89h-2.33v6.988C16.343 19.128 20 14.991 20 10z"/></svg>
            </a>
          )}
          {socialInstagram && (
            <a href={socialInstagram} target="_blank" rel="noopener" aria-label="Instagram" class="text-white/70 hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M10 0C7.284 0 6.944.012 5.877.06 4.813.11 4.086.278 3.45.525a4.893 4.893 0 00-1.771 1.154A4.893 4.893 0 00.525 3.45C.278 4.086.11 4.813.06 5.877.012 6.944 0 7.284 0 10s.012 3.056.06 4.123c.05 1.064.218 1.791.465 2.427a4.893 4.893 0 001.154 1.771 4.893 4.893 0 001.771 1.154c.636.247 1.363.415 2.427.465C6.944 19.988 7.284 20 10 20s3.056-.012 4.123-.06c1.064-.05 1.791-.218 2.427-.465a4.893 4.893 0 001.771-1.154 4.893 4.893 0 001.154-1.771c.247-.636.415-1.363.465-2.427.048-1.067.06-1.407.06-4.123s-.012-3.056-.06-4.123c-.05-1.064-.218-1.791-.465-2.427a4.893 4.893 0 00-1.154-1.771A4.893 4.893 0 0016.55.525C15.914.278 15.187.11 14.123.06 13.056.012 12.716 0 10 0zm0 1.802c2.67 0 2.986.01 4.04.058.976.045 1.505.207 1.858.344.466.182.8.399 1.15.748.35.35.566.684.748 1.15.137.353.3.882.344 1.857.048 1.055.058 1.37.058 4.04 0 2.672-.01 2.987-.058 4.042-.045.975-.207 1.504-.344 1.857a3.097 3.097 0 01-.748 1.15c-.35.35-.684.566-1.15.748-.353.137-.882.3-1.857.344-1.054.048-1.37.058-4.041.058-2.67 0-2.987-.01-4.04-.058-.976-.045-1.505-.207-1.858-.344a3.097 3.097 0 01-1.15-.748 3.097 3.097 0 01-.748-1.15c-.137-.353-.3-.882-.344-1.857-.048-1.055-.058-1.37-.058-4.041 0-2.67.01-2.986.058-4.04.045-.976.207-1.505.344-1.858.182-.466.399-.8.748-1.15.35-.35.684-.566 1.15-.748.353-.137.882-.3 1.857-.344 1.055-.048 1.37-.058 4.041-.058zm0 3.063a5.135 5.135 0 100 10.27 5.135 5.135 0 000-10.27zm0 8.468a3.333 3.333 0 110-6.666 3.333 3.333 0 010 6.666zm6.538-8.671a1.2 1.2 0 11-2.4 0 1.2 1.2 0 012.4 0z"/></svg>
            </a>
          )}
          {socialTiktok && (
            <a href={socialTiktok} target="_blank" rel="noopener" aria-label="TikTok" class="text-white/70 hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M14.125 0h-3.05v13.622c0 1.623-1.3 2.932-2.912 2.932a2.92 2.92 0 01-2.913-2.932 2.92 2.92 0 012.913-2.932c.3 0 .587.044.862.125V7.7a6.087 6.087 0 00-.862-.063C3.663 7.637 0 11.32 0 15.84 0 20.36 3.663 22 8.163 22c4.5 0 8.162-1.64 8.162-6.16V7.475A9.393 9.393 0 0020 9.1V6.037a5.842 5.842 0 01-5.875-6.037z" transform="translate(0 -1)"/></svg>
            </a>
          )}
          {socialYoutube && (
            <a href={socialYoutube} target="_blank" rel="noopener" aria-label="YouTube" class="text-white/70 hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M19.582 3.186A2.506 2.506 0 0017.82 1.41C16.254 1 10 1 10 1S3.746 1 2.18 1.41A2.506 2.506 0 00.418 3.186C0 4.768 0 8.1 0 8.1s0 3.332.418 4.914a2.506 2.506 0 001.762 1.776C3.746 15.2 10 15.2 10 15.2s6.254 0 7.82-.41a2.506 2.506 0 001.762-1.776C20 11.432 20 8.1 20 8.1s0-3.332-.418-4.914zM7.955 11.471V4.729L13.182 8.1 7.955 11.47z" transform="translate(0 2)"/></svg>
            </a>
          )}
          {socialPinterest && (
            <a href={socialPinterest} target="_blank" rel="noopener" aria-label="Pinterest" class="text-white/70 hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M10 0C4.477 0 0 4.477 0 10c0 4.237 2.636 7.855 6.356 9.312-.088-.791-.166-2.005.035-2.868.182-.78 1.172-4.97 1.172-4.97s-.299-.598-.299-1.482c0-1.388.805-2.425 1.808-2.425.853 0 1.264.64 1.264 1.408 0 .858-.546 2.14-.828 3.33-.236.995.499 1.806 1.48 1.806 1.778 0 3.144-1.874 3.144-4.58 0-2.393-1.72-4.068-4.177-4.068-2.845 0-4.515 2.134-4.515 4.34 0 .859.331 1.781.744 2.282a.3.3 0 01.07.287c-.076.316-.245.995-.278 1.134-.044.183-.145.222-.335.134-1.249-.581-2.03-2.407-2.03-3.874 0-3.154 2.292-6.052 6.608-6.052 3.469 0 6.165 2.473 6.165 5.776 0 3.447-2.173 6.22-5.19 6.22-1.013 0-1.965-.527-2.291-1.148l-.623 2.378c-.225.869-.834 1.956-1.241 2.62A10 10 0 0010 20c5.523 0 10-4.477 10-10S15.523 0 10 0z"/></svg>
            </a>
          )}
          {socialTwitter && (
            <a href={socialTwitter} target="_blank" rel="noopener" aria-label="X (Twitter)" class="text-white/70 hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M11.903 8.471L19.347 0h-1.764l-6.465 7.353L5.955 0H0l7.808 11.12L0 20h1.764l6.828-7.765L14.045 20H20L11.903 8.471z"/></svg>
            </a>
          )}
        </div>
      </div>

      <!-- Colonne 2: Menu principal -->
      <div>
        <div class="text-white font-semibold mb-4 uppercase tracking-wide text-sm">Boutique</div>
        <ul class="space-y-2.5">
          {mainMenu.map((link) => (
            <li><a href={link.url} class="text-sm text-white/70 hover:text-white transition-colors">{link.title}</a></li>
          ))}
        </ul>
      </div>

      <!-- Colonne 3: Mentions légales -->
      <div>
        <div class="text-white font-semibold mb-4 uppercase tracking-wide text-sm">Informations</div>
        <ul class="space-y-2.5">
          {legalMenu.map((link) => (
            <li><a href={link.url} class="text-sm text-white/70 hover:text-white transition-colors">{link.title}</a></li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Footer bottom: copyright + payment icons -->
    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-white/60">
      <div class="flex flex-col sm:flex-row items-center gap-2">
        <p>{copyright}</p>
        <span class="hidden sm:inline text-white/40">•</span>
        <p>Site conçu avec ♥ par <a href="https://codiseo.com" target="_blank" rel="noopener" class="text-white/70 hover:text-white transition-colors">Codiseo</a></p>
      </div>
      {showPayment && (
        <div class="flex items-center gap-2">
          <PaymentIcons />
        </div>
      )}
    </div>
  </div>
</footer>

<style>
.footer-divider {
  width: 100%;
  overflow: hidden;
  line-height: 0;
  color: #000;
  background-color: transparent;
}
.footer-divider svg {
  position: relative;
  display: block;
  width: calc(100% + 1.3px);
  height: 100px;
}
.footer-wave-parallax > use {
  animation: footer-wave-move-forever 25s cubic-bezier(.55,.5,.45,.5) infinite;
}
.footer-wave-parallax--1 > use { animation-delay: -2s; animation-duration: 7s; }
.footer-wave-parallax--2 > use { animation-delay: -3s; animation-duration: 10s; }
.footer-wave-parallax--3 > use { animation-delay: -4s; animation-duration: 13s; }
.footer-wave-parallax--4 > use { animation-delay: -5s; animation-duration: 20s; }
@keyframes footer-wave-move-forever {
  0%   { transform: translate3d(-90px, 0, 0); }
  100% { transform: translate3d(85px, 0, 0); }
}
@media (prefers-reduced-motion: reduce) {
  .footer-wave-parallax > use { animation: none; }
}
</style>
