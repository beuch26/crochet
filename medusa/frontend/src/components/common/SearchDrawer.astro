---
// Predictive search drawer
---

<!-- Search overlay -->
<div id="search-overlay" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300"></div>

<!-- Search drawer -->
<div id="search-drawer" class="fixed top-0 left-0 right-0 z-[70] hidden">
  <div class="bg-white shadow-2xl rounded-b-2xl max-w-3xl mx-auto">
    <!-- Search input -->
    <div class="flex items-center gap-3 px-6 py-4 border-b border-border-light">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Rechercher un produit, un article..."
        autocomplete="off"
        class="flex-1 text-base bg-transparent outline-none placeholder-text-muted"
      />
      <button id="close-search" type="button" aria-label="Fermer" class="p-2 text-text-muted hover:text-text rounded-lg hover:bg-bg-light transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Results -->
    <div id="search-results" class="max-h-[60vh] overflow-y-auto px-6 py-4 hidden">
      <div id="search-loading" class="hidden text-center py-8 text-text-muted">
        Recherche en cours...
      </div>
      <div id="search-empty" class="hidden text-center py-8 text-text-muted">
        Aucun résultat trouvé
      </div>

      <!-- Products -->
      <div id="search-products" class="hidden">
        <p class="text-xs font-semibold text-text-muted uppercase tracking-widest mb-3">Produits</p>
        <div id="search-products-list" class="space-y-2"></div>
      </div>

      <!-- Blog -->
      <div id="search-blog" class="hidden mt-6">
        <p class="text-xs font-semibold text-text-muted uppercase tracking-widest mb-3">Articles</p>
        <div id="search-blog-list" class="space-y-2"></div>
      </div>
    </div>
  </div>
</div>

<script>
const MEDUSA_URL = document.querySelector('meta[name="medusa-url"]')?.getAttribute('content') || ''
const API_KEY = document.querySelector('meta[name="medusa-key"]')?.getAttribute('content') || ''
const REGION_ID = document.querySelector('meta[name="medusa-region-id"]')?.getAttribute('content') || 'reg_01KNMDW1PJAW5BV63ARBR3V1XH'

function formatPrice(amount: number) {
  return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(amount)
}

function openSearch() {
  document.getElementById('search-drawer')?.classList.remove('hidden')
  document.getElementById('search-overlay')?.classList.remove('hidden')
  setTimeout(() => {
    document.getElementById('search-overlay')?.classList.remove('opacity-0')
    document.getElementById('search-input')?.focus()
  }, 10)
  document.body.style.overflow = 'hidden'
}

function closeSearch() {
  document.getElementById('search-overlay')?.classList.add('opacity-0')
  setTimeout(() => {
    document.getElementById('search-drawer')?.classList.add('hidden')
    document.getElementById('search-overlay')?.classList.add('hidden')
  }, 300)
  document.body.style.overflow = ''
  const input = document.getElementById('search-input') as HTMLInputElement
  if (input) input.value = ''
  document.getElementById('search-results')?.classList.add('hidden')
}

document.getElementById('close-search')?.addEventListener('click', closeSearch)
document.getElementById('search-overlay')?.addEventListener('click', closeSearch)

// Open search triggers
document.querySelectorAll('[data-open-search]').forEach(el => {
  el.addEventListener('click', (e) => {
    e.preventDefault()
    openSearch()
  })
})

// Keyboard shortcut
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') closeSearch()
  if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
    e.preventDefault()
    openSearch()
  }
})

// Debounced search
let searchTimeout: any
const input = document.getElementById('search-input') as HTMLInputElement
input?.addEventListener('input', () => {
  clearTimeout(searchTimeout)
  const q = input.value.trim()
  if (q.length < 2) {
    document.getElementById('search-results')?.classList.add('hidden')
    return
  }
  document.getElementById('search-results')?.classList.remove('hidden')
  document.getElementById('search-loading')?.classList.remove('hidden')
  document.getElementById('search-empty')?.classList.add('hidden')
  document.getElementById('search-products')?.classList.add('hidden')
  document.getElementById('search-blog')?.classList.add('hidden')

  searchTimeout = setTimeout(() => performSearch(q), 300)
})

async function performSearch(query: string) {
  try {
    const res = await fetch(`${MEDUSA_URL}/store/products?q=${encodeURIComponent(query)}&limit=6&region_id=${REGION_ID}&fields=+variants.calculated_price`, {
      headers: { 'x-publishable-api-key': API_KEY },
    })
    const data = await res.json()
    const products = data.products || []

    document.getElementById('search-loading')?.classList.add('hidden')

    if (products.length === 0) {
      document.getElementById('search-empty')?.classList.remove('hidden')
      return
    }

    document.getElementById('search-empty')?.classList.add('hidden')
    document.getElementById('search-products')?.classList.remove('hidden')

    const list = document.getElementById('search-products-list')!
    list.innerHTML = products.map((p: any) => {
      const price = p.variants?.[0]?.calculated_price?.calculated_amount || 0
      return `
        <a href="/products/${p.handle}/" class="flex items-center gap-4 p-3 rounded-xl hover:bg-bg-light transition-colors group">
          <div class="w-14 h-14 rounded-lg bg-bg-light border border-border-light overflow-hidden shrink-0">
            ${p.thumbnail ? `<img src="${p.thumbnail}" alt="${p.title}" class="w-full h-full object-contain p-1" />` : '<div class="w-full h-full"></div>'}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-text truncate group-hover:text-primary transition-colors">${p.title}</p>
            <p class="text-sm font-bold text-text mt-0.5 font-['DM_Sans']">${formatPrice(price)}</p>
          </div>
        </a>
      `
    }).join('')
  } catch (e) {
    console.error('Search error:', e)
    document.getElementById('search-loading')?.classList.add('hidden')
  }
}
</script>
