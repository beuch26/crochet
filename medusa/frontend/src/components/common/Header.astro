---
/**
 * Header — repris fidèlement du thème Shopify Magic Crochet Kit.
 * Structure : Logo gauche, menu central avec dropdowns, actions droite (search, account, wishlist, cart).
 * Menu structure issue de Shopify Admin API (linklist `main-menu`).
 */
import { getThemeSettings } from '../../lib/medusa'

let themeSettings: Record<string, Record<string, any>> = {}
try {
  const { settings } = await getThemeSettings()
  themeSettings = settings || {}
} catch {}

const generalSettings = themeSettings?.general || {}
const logoUrl = generalSettings.logo_url || '/images/logo.png'
const siteName = generalSettings.site_name || 'Magic Crochet Kit'

// Menu Shopify d'origine (linklist main-menu)
type MenuLink = { title: string; url: string; children?: { title: string; url: string; separator?: boolean }[] }

const mainMenu: MenuLink[] = [
  {
    title: 'KITS DE CROCHET',
    url: '/collections/kits-de-crochet/',
    children: [
      { title: '— Par niveau —', url: '#', separator: true },
      { title: 'Kit crochet débutant', url: '/collections/kits-debutants-faciles/' },
      { title: 'Kit crochet intermédiaire', url: '/collections/kits-intermediaires/' },
      { title: 'Kit crochet avancé', url: '/collections/kits-avances/' },
      { title: '— Par type —', url: '#', separator: true },
      { title: 'Kit crochet amigurumi', url: '/collections/amigurumi/' },
      { title: 'Kit crochet animaux', url: '/collections/box-par-theme-personnages-1/' },
    ],
  },
  { title: 'MODÈLES CROCHET', url: '/collections/modeles-crochet/' },
  {
    title: 'FILS & MATÉRIAUX',
    url: '/collections/fils-materiaux/',
    children: [
      { title: '— Par type de fil —', url: '#', separator: true },
      { title: 'Fil acrylique', url: '/collections/fil-acrylique/' },
      { title: '— Matériaux —', url: '#', separator: true },
      { title: 'Crochets', url: '/collections/crochets/' },
    ],
  },
  { title: 'TUTORIELS & AIDE', url: '/blog/' },
]
---

<header id="site-header" class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-border-light transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="header-inner" class="grid grid-cols-[auto_1fr_auto] md:flex md:items-center md:justify-between items-center h-16 lg:h-[72px] transition-all duration-300 gap-2 md:gap-4">

      <!-- Mobile menu toggle (col 1 mobile, hidden desktop) -->
      <button id="mobile-menu-toggle" type="button" class="md:hidden p-2 -ml-2 text-text justify-self-start" aria-label="Menu">
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M3 6h18M3 12h18M3 18h18"/></svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <!-- Logo (centered on mobile via grid col 2, left on desktop) -->
      <a href="/" class="flex items-center gap-2 shrink-0 justify-self-center md:justify-self-start" aria-label={siteName}>
        <img src={logoUrl} alt={siteName} class="h-8 lg:h-11 w-auto object-contain max-w-[140px] md:max-w-[180px]" width="180" height="44" />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center flex-1 justify-center gap-1" aria-label="Navigation principale">
        {mainMenu.map((item) => (
          <div class="relative group">
            <a
              href={item.url}
              class="flex items-center gap-1 px-3 lg:px-4 py-2 text-[13px] lg:text-sm font-semibold uppercase tracking-wide text-text hover:text-primary transition-colors duration-200"
            >
              {item.title}
              {item.children && (
                <svg class="w-3 h-3 opacity-50 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              )}
            </a>
            {item.children && (
              <div class="absolute top-full left-1/2 -translate-x-1/2 pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                <div class="bg-black text-white rounded-lg shadow-2xl py-3 min-w-[260px]" style="background-color: rgba(0,0,0,0.95);">
                  {item.children.map((sub) =>
                    sub.separator ? (
                      <div class="px-5 py-2 text-[11px] uppercase tracking-widest text-white/40 font-semibold">{sub.title.replace(/—/g, '').trim()}</div>
                    ) : (
                      <a href={sub.url} class="block px-5 py-2 text-sm text-white/90 hover:text-accent hover:bg-white/5 transition-colors">
                        {sub.title}
                      </a>
                    )
                  )}
                </div>
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- Right actions -->
      <div class="flex items-center gap-0 sm:gap-1 lg:gap-2 shrink-0 justify-self-end">
        <button type="button" data-search-toggle class="w-9 h-9 md:w-10 md:h-10 flex items-center justify-center text-text hover:text-primary transition-colors" aria-label="Rechercher">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/></svg>
        </button>
        <a href="/account/" class="hidden md:flex w-10 h-10 items-center justify-center text-text hover:text-primary transition-colors" aria-label="Compte">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path stroke-linecap="round" d="M6 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/></svg>
        </a>
        <a href="/wishlist/" class="relative w-9 h-9 md:w-10 md:h-10 flex items-center justify-center text-text hover:text-primary transition-colors" aria-label="Favoris">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 20.364l-7.682-7.682a4.5 4.5 0 010-6.364z"/></svg>
          <span id="wishlist-count" class="hidden absolute -top-1 -right-1 bg-primary text-white text-[10px] font-bold min-w-[18px] h-[18px] px-1 rounded-full flex items-center justify-center">0</span>
        </a>
        <button type="button" data-cart-toggle class="relative w-9 h-9 md:w-10 md:h-10 flex items-center justify-center text-text hover:text-primary transition-colors" aria-label="Panier">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          <span id="cart-count" class="hidden absolute -top-1 -right-1 bg-primary text-white text-[10px] font-bold min-w-[18px] h-[18px] px-1 rounded-full flex items-center justify-center">0</span>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <nav id="mobile-menu" class="md:hidden hidden border-t border-border-light bg-white" aria-label="Navigation mobile">
      <div class="py-2">
        {mainMenu.map((item) => (
          <>
            <a href={item.url} class="block px-4 py-3 text-sm font-semibold uppercase tracking-wide text-text hover:bg-bg-light">{item.title}</a>
            {item.children && (
              <div class="pb-2">
                {item.children.map((sub) =>
                  sub.separator ? (
                    <div class="px-8 py-1.5 text-[10px] uppercase tracking-widest text-text-muted font-semibold">{sub.title.replace(/—/g, '').trim()}</div>
                  ) : (
                    <a href={sub.url} class="block px-8 py-2 text-sm text-text-light hover:text-primary">{sub.title}</a>
                  )
                )}
              </div>
            )}
          </>
        ))}
        <div class="border-t border-border-light mt-2 pt-2">
          <a href="/account/" class="block px-4 py-3 text-sm font-semibold text-text">Mon compte</a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('mobile-menu-toggle')
  const menu = document.getElementById('mobile-menu')
  const iconOpen = document.getElementById('menu-icon-open')
  const iconClose = document.getElementById('menu-icon-close')
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden')
    iconOpen?.classList.toggle('hidden')
    iconClose?.classList.toggle('hidden')
  })

  // Sticky shadow on scroll
  const header = document.getElementById('site-header')
  const inner = document.getElementById('header-inner')
  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 60
    inner?.classList.toggle('!h-12', scrolled)
    inner?.classList.toggle('lg:!h-14', scrolled)
    header?.classList.toggle('shadow-sm', scrolled)
  }, { passive: true })

  // Wishlist badge
  try {
    const wl = JSON.parse(localStorage.getItem('mck_wishlist') || '[]')
    const badge = document.getElementById('wishlist-count')
    if (badge && wl.length > 0) {
      badge.textContent = String(wl.length)
      badge.classList.remove('hidden')
    }
  } catch {}
</script>
