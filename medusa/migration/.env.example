# Shopify Admin API (Magic Crochet Kit)
SHOPIFY_SHOP_DOMAIN=crochetbox-2.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01

# PrestaShop API (legacy, conservé depuis geniuz)
PRESTASHOP_URL=https://geniuz.fr/api
PRESTASHOP_KEY=your_prestashop_api_key

# Medusa Admin
MEDUSA_URL=http://localhost:9000
MEDUSA_ADMIN_TOKEN=your_admin_jwt_token

# Options de migration (facultatif)
# DRY_RUN=1                          # n'écrit rien dans Medusa
# ONLY=collections,products,pages    # limiter aux étapes spécifiées
# PRODUCT_LIMIT=10                   # limiter le nombre de produits (test)
