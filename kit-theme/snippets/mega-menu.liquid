{%- comment -%}
  Mega Menu Snippet with Vanilla JavaScript
  Enhanced navigation with image preview on hover
  Usage: {% render 'mega-menu', link: link, bg_color: '#000', bg_opacity: 95, text_color: '#fff', hover_color: '#60a5fa', fallback_image: image %}
{%- endcomment -%}

{%- comment -%} Default values {%- endcomment -%}
{%- assign mega_bg_color = bg_color | default: '#000000' -%}
{%- assign mega_bg_opacity = bg_opacity | default: 95 -%}
{%- assign mega_text_color = text_color | default: '#ffffff' -%}
{%- assign mega_hover_color = hover_color | default: '#60a5fa' -%}
{%- assign mega_layout = layout | default: 'standard' -%}
{%- assign mega_featured_label = featured_label | default: 'Notre best-seller' -%}

{%- comment -%} Badge color: custom if set, otherwise theme primary {%- endcomment -%}
{%- if featured_badge_color != blank -%}
  {%- assign mega_badge_bg = featured_badge_color -%}
{%- else -%}
  {%- assign mega_badge_bg = 'var(--color-primary)' -%}
{%- endif -%}

{%- comment -%} Compute max-width based on layout {%- endcomment -%}
{%- case mega_layout -%}
  {%- when 'wide' -%}
    {%- assign mega_max_width = '1600px' -%}
  {%- when 'full' -%}
    {%- assign mega_max_width = '100%' -%}
  {%- else -%}
    {%- assign mega_max_width = '1400px' -%}
{%- endcase -%}

{%- comment -%} Check if featured product exists {%- endcomment -%}
{%- assign has_featured_product = false -%}
{%- if featured_product != blank and featured_product != empty -%}
  {%- assign has_featured_product = true -%}
{%- endif -%}

{%- comment -%} Convert opacity to decimal {%- endcomment -%}
{%- assign opacity_decimal = mega_bg_opacity | times: 1.0 | divided_by: 100.0 -%}

{%- comment -%} Extract RGB components from hex color {%- endcomment -%}
{%- assign bg_rgb = mega_bg_color | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
{%- assign text_rgb = mega_text_color | color_to_rgb | remove: 'rgb(' | remove: ')' -%}

{%- if link.links.size > 0 -%}
  {%- comment -%} Get default image from link based on type (collection or product) {%- endcomment -%}
  {%- assign default_image_url = '' -%}
  {%- assign default_label = link.title -%}

  {%- comment -%} Debug: Check what we have {%- endcomment -%}
  {%- comment -%} Type: {{ link.type }}, Has object: {{ link.object }}, Object type: {{ link.object.object_type }} {%- endcomment -%}

  {%- comment -%} Try to get image from the linked object {%- endcomment -%}
  {%- if link.object -%}
    {%- comment -%} Check if it's a collection {%- endcomment -%}
    {%- if link.object.object_type == 'collection' or link.type == 'collection_link' -%}
      {%- if link.object.image -%}
        {%- assign default_image_url = link.object.image | image_url: width: 1000 -%}
      {%- elsif link.object.featured_image -%}
        {%- assign default_image_url = link.object.featured_image | image_url: width: 1000 -%}
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Check if it's a product {%- endcomment -%}
    {%- if link.object.object_type == 'product' or link.type == 'product_link' -%}
      {%- if link.object.featured_image -%}
        {%- assign default_image_url = link.object.featured_image | image_url: width: 1000 -%}
      {%- elsif link.object.image -%}
        {%- assign default_image_url = link.object.image | image_url: width: 1000 -%}
      {%- elsif link.object.media[0] -%}
        {%- assign default_image_url = link.object.media[0].preview_image | image_url: width: 1000 -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} Fallback: try any image property {%- endcomment -%}
  {%- if default_image_url == blank and link.object.image -%}
    {%- assign default_image_url = link.object.image | image_url: width: 1000 -%}
  {%- endif -%}

  {%- comment -%} Ultimate fallback: use the fallback image from settings {%- endcomment -%}
  {%- if default_image_url == blank and fallback_image -%}
    {%- assign default_image_url = fallback_image | image_url: width: 1000 -%}
  {%- endif -%}

  {%- assign menu_id = link.title | handle -%}

  <div class="mega-menu" data-mega-menu="{{ menu_id }}">
    <div class="mega-menu__container">

      {%- comment -%} Image Section - Left Side {%- endcomment -%}
      <div class="mega-menu__image-section">
        <a href="{{ link.url }}" class="mega-menu__image-link">
          <div class="mega-menu__image-wrapper">
            {%- if default_image_url != blank -%}
              <img
                src="{{ default_image_url }}"
                class="mega-menu__image"
                loading="lazy"
                alt="{{ default_label }}"
                data-default-image="{{ default_image_url }}"
                data-default-label="{{ default_label }}"
              >
            {%- else -%}
              <div class="mega-menu__image-placeholder">
                <span>{{ default_label }}</span>
              </div>
            {%- endif -%}
          </div>
        </a>
      </div>

      {%- comment -%} Links Section - Center {%- endcomment -%}
      <div class="mega-menu__links-section">
        <div class="mega-menu__columns">

          {%- comment -%} Group items by category headers (items with url="#") {%- endcomment -%}
          {%- assign current_category = nil -%}
          {%- assign category_items = '' -%}

          {%- for item in link.links -%}
            {%- comment -%} Check if this is a category header (url = "#") {%- endcomment -%}
            {%- assign is_category_header = false -%}
            {%- if item.url == '#' or item.url == '/#' -%}
              {%- assign is_category_header = true -%}
            {%- endif -%}

            {%- if is_category_header -%}
              {%- comment -%} Start a new column for this category {%- endcomment -%}
              <div class="mega-menu__column">
                <div class="mega-menu__category-header">
                  <span>{{ item.title }}</span>
                </div>

                {%- comment -%} Collect following items until next category header {%- endcomment -%}
                <ul class="mega-menu__list">
                  {%- assign next_index = forloop.index -%}
                  {%- for next_item in link.links offset:next_index -%}
                    {%- if next_item.url == '#' or next_item.url == '/#' -%}
                      {%- break -%}
                    {%- endif -%}

                    {%- assign item_image_url = '' -%}

                    {%- if next_item.object -%}
                      {%- if next_item.object.image -%}
                        {%- assign item_image_url = next_item.object.image | image_url: width: 1000 -%}
                      {%- elsif next_item.object.featured_image -%}
                        {%- assign item_image_url = next_item.object.featured_image | image_url: width: 1000 -%}
                      {%- endif -%}
                    {%- endif -%}

                    {%- if item_image_url == blank -%}
                      {%- assign item_handle = next_item.url | split: '/collections/' | last | split: '?' | first | split: '/' | first -%}
                      {%- if item_handle != blank and collections[item_handle] -%}
                        {%- if collections[item_handle].image -%}
                          {%- assign item_image_url = collections[item_handle].image | image_url: width: 1000 -%}
                        {%- elsif collections[item_handle].featured_image -%}
                          {%- assign item_image_url = collections[item_handle].featured_image | image_url: width: 1000 -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endif -%}

                    {%- if item_image_url == blank and fallback_image -%}
                      {%- assign item_image_url = fallback_image | image_url: width: 1000 -%}
                    {%- endif -%}

                    <li>
                      <a
                        href="{{ next_item.url }}"
                        class="mega-menu__link"
                        {% if item_image_url != blank %}data-image="{{ item_image_url }}" data-label="{{ next_item.title }}"{% endif %}
                      >
                        {{ next_item.title }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Fallback: if no category headers found, display flat list {%- endcomment -%}
          {%- assign has_category_headers = false -%}
          {%- for item in link.links -%}
            {%- if item.url == '#' or item.url == '/#' -%}
              {%- assign has_category_headers = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- unless has_category_headers -%}
            {%- for column in link.links -%}
              <div class="mega-menu__column">
                {%- assign column_image_url = '' -%}
                {%- if column.object -%}
                  {%- if column.object.image -%}
                    {%- assign column_image_url = column.object.image | image_url: width: 1000 -%}
                  {%- elsif column.object.featured_image -%}
                    {%- assign column_image_url = column.object.featured_image | image_url: width: 1000 -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if column_image_url == blank -%}
                  {%- assign column_handle = column.url | split: '/collections/' | last | split: '?' | first | split: '/' | first -%}
                  {%- if column_handle != blank and collections[column_handle] -%}
                    {%- if collections[column_handle].image -%}
                      {%- assign column_image_url = collections[column_handle].image | image_url: width: 1000 -%}
                    {%- elsif collections[column_handle].featured_image -%}
                      {%- assign column_image_url = collections[column_handle].featured_image | image_url: width: 1000 -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if column_image_url == blank and fallback_image -%}
                  {%- assign column_image_url = fallback_image | image_url: width: 1000 -%}
                {%- endif -%}
                <div class="mega-menu__column-title">
                  <a href="{{ column.url }}" {% if column_image_url != blank %}class="mega-menu__link" data-image="{{ column_image_url }}" data-label="{{ column.title }}"{% endif %}>{{ column.title }}</a>
                </div>
                {%- if column.links.size > 0 -%}
                  <ul class="mega-menu__list">
                    {%- for child_link in column.links -%}
                      <li>
                        {%- assign child_image_url = '' -%}
                        {%- if child_link.object -%}
                          {%- if child_link.object.object_type == 'product' or child_link.type == 'product_link' -%}
                            {%- if child_link.object.featured_image -%}
                              {%- assign child_image_url = child_link.object.featured_image | image_url: width: 1000 -%}
                            {%- elsif child_link.object.media[0] -%}
                              {%- assign child_image_url = child_link.object.media[0].preview_image | image_url: width: 1000 -%}
                            {%- endif -%}
                          {%- elsif child_link.object.object_type == 'collection' or child_link.type == 'collection_link' -%}
                            {%- if child_link.object.image -%}
                              {%- assign child_image_url = child_link.object.image | image_url: width: 1000 -%}
                            {%- elsif child_link.object.featured_image -%}
                              {%- assign child_image_url = child_link.object.featured_image | image_url: width: 1000 -%}
                            {%- endif -%}
                          {%- endif -%}
                        {%- endif -%}
                        {%- if child_image_url == blank -%}
                          {%- assign link_handle = child_link.url | split: '/collections/' | last | split: '?' | first | split: '/' | first -%}
                          {%- if link_handle != blank and collections[link_handle] -%}
                            {%- if collections[link_handle].image -%}
                              {%- assign child_image_url = collections[link_handle].image | image_url: width: 1000 -%}
                            {%- elsif collections[link_handle].featured_image -%}
                              {%- assign child_image_url = collections[link_handle].featured_image | image_url: width: 1000 -%}
                            {%- endif -%}
                          {%- endif -%}
                        {%- endif -%}
                        {%- if child_image_url == blank and fallback_image -%}
                          {%- assign child_image_url = fallback_image | image_url: width: 1000 -%}
                        {%- endif -%}
                        {%- if child_image_url != blank -%}
                          <a href="{{ child_link.url }}" class="mega-menu__link" data-image="{{ child_image_url }}" data-label="{{ child_link.title }}">{{ child_link.title }}</a>
                        {%- elsif fallback_image -%}
                          <a href="{{ child_link.url }}" class="mega-menu__link" data-image="{{ fallback_image | image_url: width: 1000 }}" data-label="{{ child_link.title }}">{{ child_link.title }}</a>
                        {%- else -%}
                          <a href="{{ child_link.url }}" class="mega-menu__link">{{ child_link.title }}</a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endunless -%}

        </div>
      </div>

      {%- comment -%} Featured Product Section - Right Side {%- endcomment -%}
      {%- if has_featured_product -%}
        <div class="mega-menu__featured-section">
          <div class="mega-menu__featured-badge" style="background-color: {{ mega_badge_bg }};">
            {{ mega_featured_label }}
          </div>
          <a href="{{ featured_product.url }}" class="mega-menu__featured-link">
            <div class="mega-menu__featured-image-wrapper">
              {%- if featured_product.featured_image -%}
                <img
                  src="{{ featured_product.featured_image | image_url: width: 600 }}"
                  alt="{{ featured_product.title | escape }}"
                  class="mega-menu__featured-image"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
            <div class="mega-menu__featured-info">
              <h4 class="mega-menu__featured-title">{{ featured_product.title }}</h4>
              <div class="mega-menu__featured-price">
                {%- if featured_product.compare_at_price > featured_product.price -%}
                  <span class="mega-menu__featured-price--compare">{{ featured_product.compare_at_price | money }}</span>
                {%- endif -%}
                <span class="mega-menu__featured-price--current">{{ featured_product.price | money }}</span>
              </div>
            </div>
          </a>
        </div>
      {%- endif -%}

    </div>
  </div>
{%- endif -%}

<style>
/* Mega Menu - Desktop */
.mega-menu {
  --mega-bg-color: {{ mega_bg_color }};
  --mega-text-color: {{ mega_text_color }};
  --mega-hover-color: {{ mega_hover_color }};

  position: absolute;
  top: 100%;
  left: 0;
  width: 100vw;
  background: rgba({{ bg_rgb }}, {{ opacity_decimal }});
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-top: 1px solid rgba({{ text_rgb }}, 0.1);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
  z-index: 999999;
  pointer-events: none;
}

.nav-item:hover .mega-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}

.mega-menu__container {
  max-width: {{ mega_max_width }};
  margin: 0 auto;
  display: flex;
  gap: 2rem;
  padding: 3rem 2rem;
}

/* Image Section */
.mega-menu__image-section {
  flex: 0 0 {% if has_featured_product %}25%{% else %}34%{% endif %};
  display: flex;
}

.mega-menu__image-link {
  display: flex;
  flex-direction: column;
  flex: 1;
  text-decoration: none;
  border-right: 1px solid rgba({{ text_rgb }}, 0.1);
  padding-right: 2rem;
}

.mega-menu__image-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 1.07;
  border-radius: 1rem;
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.05);
}

.mega-menu__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.3s ease;
}

.mega-menu__image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: var(--mega-text-color, #fff);
  opacity: 0.5;
  font-size: 1.5rem;
  text-align: center;
  padding: 2rem;
}

/* Links Section */
.mega-menu__links-section {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.mega-menu__columns {
  display: flex;
  flex-direction: row;
  gap: 3rem;
}

.mega-menu__column {
  flex: 1;
  min-width: 0;
}

/* Category Header - Non-clickable, distinct style */
.mega-menu__category-header {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--mega-text-color, #fff);
  opacity: 0.5;
  padding: 0.5rem 1rem 0.75rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  margin-bottom: 0.75rem;
  cursor: default;
  pointer-events: none;
}

.mega-menu__category-header span {
  display: block;
}

.mega-menu__column-title {
  font-size: 0.9375rem;
  font-weight: 500;
  margin-bottom: 0;
  color: var(--mega-text-color, #fff);
}

.mega-menu__column-title a {
  display: block;
  padding: 0.625rem 1rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
  color: var(--mega-text-color, #fff);
  text-decoration: none;
}

.mega-menu__column-title a:hover {
  color: var(--mega-hover-color, #60a5fa);
  background: rgba(255, 255, 255, 0.1);
}

.mega-menu__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.mega-menu__link {
  display: block;
  color: var(--mega-text-color, #fff);
  opacity: 0.7;
  text-decoration: none;
  padding: 0.5rem 0.75rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
  font-size: 0.9375rem;
}

.mega-menu__link:hover {
  color: var(--mega-hover-color, #60a5fa);
  opacity: 1;
  background-color: rgba({{ text_rgb }}, 0.1);
  transform: translateX(4px);
}

/* Featured Product Section */
.mega-menu__featured-section {
  flex: 0 0 25%;
  border-left: 1px solid rgba({{ text_rgb }}, 0.1);
  padding-left: 2rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.mega-menu__featured-badge {
  display: inline-block;
  align-self: flex-start;
  padding: 0.25rem 0.75rem;
  border-radius: 2rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.mega-menu__featured-link {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  text-decoration: none;
  color: var(--mega-text-color, #fff);
  transition: opacity 0.2s ease;
}

.mega-menu__featured-link:hover {
  opacity: 0.85;
}

.mega-menu__featured-image-wrapper {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 0.75rem;
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.05);
}

.mega-menu__featured-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.mega-menu__featured-link:hover .mega-menu__featured-image {
  transform: scale(1.05);
}

.mega-menu__featured-info {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.mega-menu__featured-title {
  font-size: 0.9375rem;
  font-weight: 600;
  margin: 0;
  color: var(--mega-text-color, #fff);
  line-height: 1.3;
}

.mega-menu__featured-price {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.9375rem;
}

.mega-menu__featured-price--current {
  font-weight: 700;
  color: var(--color-primary, #71c9ce);
}

.mega-menu__featured-price--compare {
  text-decoration: line-through;
  opacity: 0.5;
  font-size: 0.8125rem;
}

/* Mobile responsiveness - Simplified accordion style */
@media (max-width: 1023px) {
  .mega-menu {
    position: relative;
    width: 100%;
    margin-left: 0;
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    display: none;
    background-color: var(--color-background-light, #f5f5f5);
    border-top: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .nav-item:hover .mega-menu,
  .nav-item.expanded .mega-menu {
    display: block;
  }

  .mega-menu__container {
    flex-direction: column;
    padding: 0.5rem 0;
    gap: 0;
  }

  /* Hide image and featured product sections on mobile */
  .mega-menu__image-section {
    display: none;
  }

  .mega-menu__featured-section {
    display: none;
  }

  .mega-menu__links-section {
    width: 100%;
  }

  .mega-menu__columns {
    flex-direction: column;
    gap: 0;
  }

  .mega-menu__column {
    min-width: 100%;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
  }

  .mega-menu__column:last-child {
    border-bottom: none;
  }

  .mega-menu__category-header {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text, #1f2937);
    opacity: 0.5;
    padding: 0.75rem 1rem 0.5rem;
    border-bottom: none;
    margin-bottom: 0;
    cursor: default;
  }

  .mega-menu__column-title {
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 0;
    padding: 0.75rem 1rem;
    color: var(--color-text, #1f2937);
    opacity: 1;
  }

  .mega-menu__column-title a {
    color: var(--color-text, #1f2937);
    display: block;
  }

  .mega-menu__column-title a:hover {
    color: var(--color-primary, #71c9ce);
  }

  .mega-menu__list {
    padding: 0 1rem 0.75rem 1.5rem;
    gap: 0.25rem;
  }

  .mega-menu__link {
    color: var(--color-text-light, #6b7280);
    opacity: 1;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
  }

  .mega-menu__link:hover {
    color: var(--color-primary, #71c9ce);
    background-color: transparent;
    transform: none;
  }
}
</style>

<script>
(function() {
  'use strict';

  // Position mega menus to span full viewport width
  function positionMegaMenus() {
    if (window.innerWidth < 1024) return;
    var menus = document.querySelectorAll('.mega-menu');
    menus.forEach(function(menu) {
      var parent = menu.closest('.nav-item');
      if (!parent) return;
      var parentRect = parent.getBoundingClientRect();
      menu.style.left = -parentRect.left + 'px';
    });
  }

  // Initialize mega menu image switching
  function initMegaMenu() {
    var megaMenus = document.querySelectorAll('[data-mega-menu]');

    megaMenus.forEach(function(menu) {
      var image = menu.querySelector('.mega-menu__image');
      if (!image) return;

      var defaultImage = image.getAttribute('data-default-image');
      var defaultLabel = image.getAttribute('data-default-label');

      var links = menu.querySelectorAll('.mega-menu__link[data-image]');

      links.forEach(function(link) {
        var imageUrl = link.getAttribute('data-image');
        var label = link.getAttribute('data-label');

        if (!imageUrl) return;

        link.addEventListener('mouseenter', function() {
          image.src = imageUrl;
          image.alt = label;
        });

        link.addEventListener('mouseleave', function() {
          if (defaultImage) {
            image.src = defaultImage;
            image.alt = defaultLabel;
          }
        });
      });
    });

    // Position menus after init
    positionMegaMenus();
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMegaMenu);
  } else {
    initMegaMenu();
  }

  // Reposition on resize
  window.addEventListener('resize', positionMegaMenus);
})();
</script>
