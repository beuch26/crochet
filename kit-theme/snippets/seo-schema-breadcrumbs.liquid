{%- comment -%}
  Schema.org BreadcrumbList JSON-LD
  Creates breadcrumb links in search results (sitelinks)
  Helps users and search engines understand site structure
{%- endcomment -%}

{%- liquid
  assign position = 1
  assign breadcrumb_items = ''
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ 'general.breadcrumbs.home' | t | default: 'Home' | json }},
      "item": {{ shop.url | json }}
    }
    {%- case template.name -%}

      {%- when 'product' -%}
        {%- if collection -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ shop.url | append: collection.url | json }}
          }
          ,{
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- elsif product.collections.size > 0 -%}
          {%- assign first_collection = product.collections.first -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ first_collection.title | json }},
            "item": {{ shop.url | append: first_collection.url | json }}
          }
          ,{
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- else -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ 'products.general.catalog' | t | default: 'Products' | json }},
            "item": {{ shop.url | append: '/collections/all' | json }}
          }
          ,{
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- endif -%}

      {%- when 'collection' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ shop.url | append: collection.url | json }}
        }

      {%- when 'blog' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": {{ shop.url | append: blog.url | json }}
        }

      {%- when 'article' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": {{ shop.url | append: blog.url | json }}
        }
        ,{
          "@type": "ListItem",
          "position": 3,
          "name": {{ article.title | json }},
          "item": {{ shop.url | append: article.url | json }}
        }

      {%- when 'page' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ page.title | json }},
          "item": {{ shop.url | append: page.url | json }}
        }

      {%- when 'search' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ 'general.search.title' | t | default: 'Search' | json }},
          "item": {{ shop.url | append: '/search?q=' | append: search.terms | url_encode | json }}
        }

      {%- when 'cart' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ 'cart.general.title' | t | default: 'Cart' | json }},
          "item": {{ shop.url | append: routes.cart_url | json }}
        }

      {%- when 'list-collections' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ 'collections.general.title' | t | default: 'Collections' | json }},
          "item": {{ shop.url | append: '/collections' | json }}
        }

      {%- when 'account' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ 'customer.account.title' | t | default: 'Account' | json }},
          "item": {{ shop.url | append: routes.account_url | json }}
        }

      {%- when 'addresses' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ 'customer.account.title' | t | default: 'Account' | json }},
          "item": {{ shop.url | append: routes.account_url | json }}
        }
        ,{
          "@type": "ListItem",
          "position": 3,
          "name": {{ 'customer.addresses.title' | t | default: 'Addresses' | json }},
          "item": {{ shop.url | append: routes.account_addresses_url | json }}
        }

      {%- when 'order' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ 'customer.account.title' | t | default: 'Account' | json }},
          "item": {{ shop.url | append: routes.account_url | json }}
        }
        ,{
          "@type": "ListItem",
          "position": 3,
          "name": {{ 'customer.order.title' | t | default: 'Order' | json }},
          "item": {{ shop.url | append: order.url | json }}
        }

    {%- endcase -%}
  ]
}
</script>
