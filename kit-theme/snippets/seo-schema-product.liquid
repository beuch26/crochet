{%- comment -%}
  Schema.org Product JSON-LD
  Displays price, availability, ratings, and more in search results
  Usage: {% render 'seo-schema-product', product: product %}
{%- endcomment -%}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_url = product.url | within: collection | default: product.url

  # Calculate review statistics if reviews exist
  assign review_count = 0
  assign average_rating = 0
  if product.metafields.reviews.rating_count
    assign review_count = product.metafields.reviews.rating_count
    assign average_rating = product.metafields.reviews.rating
  elsif product.metafields.spr.reviews
    # Support for Shopify Product Reviews app
    assign review_data = product.metafields.spr.reviews | split: ','
    if review_data.size >= 2
      assign review_count = review_data[0] | plus: 0
      assign average_rating = review_data[1] | plus: 0
    endif
  endif
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "url": {{ shop.url | append: product_url | json }},
  "sku": {{ selected_variant.sku | default: product.id | json }},
  "gtin": {{ selected_variant.barcode | json }},
  "mpn": {{ selected_variant.sku | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  {% if product.featured_image %}
  "image": [
    {% for image in product.images limit: 5 %}
      {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  {% endif %}
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: product_url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ selected_variant.price | divided_by: 100.0 | json }},
    "priceValidUntil": {{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' | json }},
    "availability": "https://schema.org/{% if selected_variant.available %}InStock{% else %}OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition",
    {% if selected_variant.compare_at_price and selected_variant.compare_at_price > selected_variant.price %}
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": {{ selected_variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "valueAddedTaxIncluded": {{ settings.prices_include_tax | default: false | json }}
    },
    {% endif %}
    "seller": {
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
    }
    {% if selected_variant.inventory_quantity and selected_variant.inventory_quantity > 0 %}
    ,
    "inventoryLevel": {
      "@type": "QuantitativeValue",
      "value": {{ selected_variant.inventory_quantity | json }}
    }
    {% endif %}
    {% if product.available and settings.enable_shipping_info %}
    ,
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": {{ settings.shipping_rate | default: 0 | json }},
        "currency": {{ cart.currency.iso_code | json }}
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": {{ settings.shipping_country | default: shop.address.country_code | json }}
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": {{ settings.handling_time_min | default: 1 | json }},
          "maxValue": {{ settings.handling_time_max | default: 3 | json }},
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": {{ settings.transit_time_min | default: 3 | json }},
          "maxValue": {{ settings.transit_time_max | default: 7 | json }},
          "unitCode": "DAY"
        }
      }
    }
    {% endif %}
  }
  {% if review_count > 0 and average_rating > 0 %}
  ,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ average_rating | json }},
    "reviewCount": {{ review_count | json }},
    "bestRating": "5",
    "worstRating": "1"
  }
  {% endif %}
  {% if product.metafields.custom.additional_info %}
  ,
  "additionalProperty": [
    {% assign properties = product.metafields.custom.additional_info | split: '|' %}
    {% for property in properties %}
      {% assign prop_parts = property | split: ':' %}
      {% if prop_parts.size == 2 %}
      {
        "@type": "PropertyValue",
        "name": {{ prop_parts[0] | strip | json }},
        "value": {{ prop_parts[1] | strip | json }}
      }{% unless forloop.last %},{% endunless %}
      {% endif %}
    {% endfor %}
  ]
  {% endif %}
  {% if product.type != blank %}
  ,
  "category": {{ product.type | json }}
  {% endif %}
  {% comment %} Product Identifiers {% endcomment %}
  {% if product.id %}
  ,
  "productID": {{ product.id | json }}
  {% endif %}
  {% if selected_variant.weight %}
  ,
  "weight": {
    "@type": "QuantitativeValue",
    "value": {{ selected_variant.weight | json }},
    "unitCode": "{{ selected_variant.weight_unit | upcase }}"
  }
  {% endif %}
  {% comment %} Material (from tags or metafields) {% endcomment %}
  {% if product.metafields.custom.material %}
  ,
  "material": {{ product.metafields.custom.material | json }}
  {% endif %}
  {% comment %} Color (from first variant option if color) {% endcomment %}
  {% for option in product.options_with_values %}
    {% assign option_name = option.name | downcase %}
    {% if option_name contains 'color' or option_name contains 'colour' %}
  ,
  "color": {{ option.values | join: ', ' | json }}
      {% break %}
    {% endif %}
  {% endfor %}
}
</script>

{%- comment -%} Additional Schema for Product Reviews (if they exist) {%- endcomment -%}
{%- if review_count > 0 and product.metafields.reviews.reviews_data -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "review": [
    {% assign reviews = product.metafields.reviews.reviews_data | split: '||' %}
    {% for review in reviews limit: 10 %}
      {% assign review_parts = review | split: '|' %}
      {% if review_parts.size >= 4 %}
      {
        "@type": "Review",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": {{ review_parts[0] | json }},
          "bestRating": "5",
          "worstRating": "1"
        },
        "author": {
          "@type": "Person",
          "name": {{ review_parts[1] | json }}
        },
        "reviewBody": {{ review_parts[2] | json }},
        "datePublished": {{ review_parts[3] | json }}
      }{% unless forloop.last %},{% endunless %}
      {% endif %}
    {% endfor %}
  ]
}
</script>
{%- endif -%}
