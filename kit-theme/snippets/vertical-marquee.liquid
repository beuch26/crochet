{%- comment -%}
  Vertical Marquee
  A vertical scrolling banner fixed on the right side of the page

  Parameters:
  - items: array of text items to display (optional, uses defaults if not provided)
  - position: 'left' or 'right' (default: 'right')
  - background_color: hex color (default: uses primary color)
  - text_color: hex color (default: white)
{%- endcomment -%}

{%- liquid
  assign position = position | default: 'right'
  assign bg_color = background_color | default: 'var(--color-primary, #0369a1)'
  assign txt_color = text_color | default: '#ffffff'

  assign default_items = 'GARANTIE 30 JOURS,KIT 100% COMPLET,TUTORIEL VIDEO INCLUS,LIVRAISON RAPIDE,SATISFAIT OU REMBOURSE,SUPPORT 7J/7'
  assign marquee_items = items | default: default_items | split: ','
-%}

<div class="vertical-marquee vertical-marquee--{{ position }}" data-vertical-marquee>
  <div class="vertical-marquee__track" data-marquee-track>
    {%- for i in (1..3) -%}
      <div class="vertical-marquee__content">
        {%- for item in marquee_items -%}
          <div class="vertical-marquee__item">
            <svg class="vertical-marquee__icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 0L10 5.5H16L11 9L13 15L8 11.5L3 15L5 9L0 5.5H6L8 0Z"/>
            </svg>
            <span class="vertical-marquee__text">{{ item | strip }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
/* Vertical Marquee */
.vertical-marquee {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 70vh;
  max-height: 500px;
  background: var(--color-primary, #0369a1);
  color: {{ txt_color }};
  z-index: 100;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: -2px 0 15px rgba(0,0,0,0.15);
  border-radius: 8px 0 0 8px;
}

.vertical-marquee--right {
  right: 0;
  border-radius: 8px 0 0 8px;
}

.vertical-marquee--left {
  left: 0;
  border-radius: 0 8px 8px 0;
  box-shadow: 2px 0 15px rgba(0,0,0,0.15);
}

.vertical-marquee__track {
  display: flex;
  flex-direction: column;
  animation: vertical-scroll 25s linear infinite;
  writing-mode: vertical-rl;
  text-orientation: mixed;
}

.vertical-marquee--left .vertical-marquee__track {
  writing-mode: vertical-lr;
}

@keyframes vertical-scroll {
  0% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(-33.333%);
  }
}

.vertical-marquee__content {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  padding: 1rem 0;
}

.vertical-marquee__item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.6875rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  white-space: nowrap;
  padding: 0.5rem 0;
}

.vertical-marquee__icon {
  flex-shrink: 0;
  opacity: 0.9;
  animation: pulse-icon 2s ease-in-out infinite;
}

@keyframes pulse-icon {
  0%, 100% { opacity: 0.9; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.1); }
}

.vertical-marquee__text {
  line-height: 1.2;
}

/* Hover pause animation */
.vertical-marquee:hover .vertical-marquee__track {
  animation-play-state: paused;
}

/* Responsive: Hide on mobile and smaller tablets */
@media (max-width: 1024px) {
  .vertical-marquee {
    display: none;
  }
}

/* Reduce size on medium screens */
@media (min-width: 1025px) and (max-width: 1280px) {
  .vertical-marquee {
    width: 32px;
    height: 60vh;
  }

  .vertical-marquee__item {
    font-size: 0.625rem;
    gap: 0.375rem;
  }

  .vertical-marquee__icon {
    width: 12px;
    height: 12px;
  }
}

/* Gradient overlay for smooth loop effect */
.vertical-marquee::before,
.vertical-marquee::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  height: 40px;
  z-index: 2;
  pointer-events: none;
}

.vertical-marquee::before {
  top: 0;
  background: linear-gradient(to bottom, var(--color-primary, #0369a1), transparent);
}

.vertical-marquee::after {
  bottom: 0;
  background: linear-gradient(to top, var(--color-primary, #0369a1), transparent);
}
</style>

<script>
(function() {
  // Optional: Adjust animation speed based on content length
  const marquee = document.querySelector('[data-vertical-marquee]');
  if (!marquee) return;

  const track = marquee.querySelector('[data-marquee-track]');
  if (!track) return;

  // Clone content for seamless loop if needed
  const content = track.querySelector('.vertical-marquee__content');
  if (content && track.children.length < 3) {
    for (let i = track.children.length; i < 3; i++) {
      track.appendChild(content.cloneNode(true));
    }
  }
})();
</script>
