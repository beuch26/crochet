{%- comment -%}
  Product Gallery with Zoom and Lightbox
  Usage: {% render 'product-gallery', product: product %}
{%- endcomment -%}

{%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}

<div class="product-gallery" data-product-gallery>

  {%- comment -%} Main Media (Image or Video) {%- endcomment -%}
  <div class="product-gallery__main">
    {%- if product.media.size > 0 -%}
      <div class="product-gallery__main-media" data-main-media>
        {%- if featured_media -%}
          {%- if featured_media.media_type == 'image' -%}
            <img
              src="{{ featured_media | image_url: width: 1000 }}"
              srcset="{{ featured_media | image_url: width: 400 }} 400w,
                      {{ featured_media | image_url: width: 600 }} 600w,
                      {{ featured_media | image_url: width: 800 }} 800w,
                      {{ featured_media | image_url: width: 1000 }} 1000w"
              sizes="(min-width: 1024px) 50vw, 100vw"
              alt="{{ featured_media.alt | default: product.title }}"
              width="1000"
              height="1000"
              loading="eager"
              fetchpriority="high"
              data-zoom-image="{{ featured_media | image_url: width: 2000 }}"
              data-media-type="image"
            >
          {%- elsif featured_media.media_type == 'video' -%}
            <div class="product-gallery__video" data-media-type="video">
              {{ featured_media | video_tag: controls: true, autoplay: false, loop: false, muted: false }}
            </div>
          {%- elsif featured_media.media_type == 'external_video' -%}
            <div class="product-gallery__video product-gallery__video--external" data-media-type="external_video">
              {{ featured_media | external_video_tag }}
            </div>
          {%- elsif featured_media.media_type == 'model' -%}
            <div class="product-gallery__model" data-media-type="model">
              {{ featured_media | model_viewer_tag }}
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- comment -%} Zoom Hint (Images Only) {%- endcomment -%}
        <div class="product-gallery__zoom-hint" data-zoom-hint>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2"/>
            <path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M8 5V11M5 8H11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span>{{ 'products.product.click_to_zoom' | t | default: 'Click to zoom' }}</span>
        </div>
      </div>

      {%- comment -%} Product Badges {%- endcomment -%}
      <div class="product-gallery__badges">
        {%- if product.available == false -%}
          <span class="badge badge--error">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif product.compare_at_price > product.price -%}
          {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
          <span class="badge badge--primary">-{{ discount }}%</span>
        {%- endif -%}
        {%- if product.tags contains 'new' -%}
          <span class="badge badge--success">{{ 'products.product.new' | t | default: 'New' }}</span>
        {%- endif -%}
      </div>

      {%- comment -%} Gallery Navigation Arrows {%- endcomment -%}
      {%- if product.media.size > 1 -%}
        <button type="button" class="product-gallery__nav product-gallery__nav--prev" data-gallery-prev aria-label="Image précédente">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="product-gallery__nav product-gallery__nav--next" data-gallery-next aria-label="Image suivante">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}

      {%- comment -%} Sold Badge - Tilted Style {%- endcomment -%}
      {%- liquid
        assign sold_count = product.metafields.custom.sold_count | default: 0
        if sold_count == 0
          assign sold_count = product.id | modulo: 47 | plus: 23
        endif
      -%}
      <div class="product-gallery__sold-badge">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
          <path d="M13.5 4.5L6 12L2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{{ sold_count }} vendus ces 24h</span>
      </div>

    {%- else -%}
      <div class="product-gallery__placeholder">
        {{ 'product-1' | placeholder_svg_tag }}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Thumbnails {%- endcomment -%}
  {%- if product.media.size > 1 -%}
    <div class="product-gallery__thumbnails" data-thumbnails>
      {%- for media in product.media limit: 8 -%}
        <button
          type="button"
          class="product-gallery__thumbnail {% if forloop.first %}active{% endif %}"
          data-thumbnail
          data-media-id="{{ media.id }}"
          data-media-type="{{ media.media_type }}"
          aria-label="{{ 'products.product.view_image' | t }} {{ forloop.index }}"
        >
          {%- if media.media_type == 'image' -%}
            <img
              src="{{ media | image_url: width: 150 }}"
              alt="{{ media.alt | default: product.title }}"
              width="150"
              height="150"
              loading="lazy"
            >
          {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
            <img
              src="{{ media.preview_image | image_url: width: 150 }}"
              alt="{{ media.alt | default: product.title }}"
              width="150"
              height="150"
              loading="lazy"
            >
            <div class="product-gallery__thumbnail-play">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          {%- elsif media.media_type == 'model' -%}
            <img
              src="{{ media.preview_image | image_url: width: 150 }}"
              alt="{{ media.alt | default: product.title }}"
              width="150"
              height="150"
              loading="lazy"
            >
            <div class="product-gallery__thumbnail-3d">3D</div>
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

{%- comment -%} Lightbox Modal {%- endcomment -%}
<div class="product-gallery-lightbox" data-lightbox style="display:none;">
  <div class="product-gallery-lightbox__overlay" data-lightbox-close></div>
  <div class="product-gallery-lightbox__content">
    <button class="product-gallery-lightbox__close" data-lightbox-close aria-label="{{ 'general.accessibility.close' | t }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <button class="product-gallery-lightbox__prev" data-lightbox-prev aria-label="{{ 'general.accessibility.previous' | t }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="product-gallery-lightbox__image" data-lightbox-image></div>

    <button class="product-gallery-lightbox__next" data-lightbox-next aria-label="{{ 'general.accessibility.next' | t }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="product-gallery-lightbox__counter" data-lightbox-counter></div>
  </div>
</div>

<style>
/* Product Gallery Main */
.product-gallery {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  max-width: 100%;
  min-width: 0; /* Allow grid to shrink on mobile */
  overflow-x: hidden;
}

.product-gallery__main {
  position: relative;
  background-color: var(--color-background-light);
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 1/1;
}

.product-gallery__main-media {
  position: relative;
  width: 100%;
  height: 100%;
  cursor: zoom-in;
}

.product-gallery__main-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.product-gallery__main-media:hover img {
  transform: scale(1.05);
}

.product-gallery__video,
.product-gallery__model {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #000;
  cursor: default;
}

.product-gallery__video video,
.product-gallery__video iframe {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.product-gallery__model model-viewer {
  width: 100%;
  height: 100%;
}

.product-gallery__zoom-hint {
  position: absolute;
  bottom: 1rem;
  right: 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background-color: rgba(0,0,0,0.7);
  color: white;
  border-radius: var(--radius-md);
  font-size: 0.875rem;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.product-gallery__main-media:has([data-media-type="image"]):hover .product-gallery__zoom-hint {
  opacity: 1;
}

.product-gallery__main-media:has([data-media-type="video"]) .product-gallery__zoom-hint,
.product-gallery__main-media:has([data-media-type="external_video"]) .product-gallery__zoom-hint,
.product-gallery__main-media:has([data-media-type="model"]) .product-gallery__zoom-hint {
  display: none;
}

/* Gallery Navigation Arrows */
.product-gallery__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 36px;
  height: 36px;
  background-color: rgba(255,255,255,0.85);
  border: none;
  border-radius: 50%;
  color: #333;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  opacity: 0;
  transition: opacity 0.2s ease, background-color 0.2s ease;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}

.product-gallery__main:hover .product-gallery__nav {
  opacity: 1;
}

.product-gallery__nav:hover {
  background-color: white;
}

.product-gallery__nav--prev {
  left: 0.75rem;
}

.product-gallery__nav--next {
  right: 0.75rem;
}

.product-gallery__nav[hidden] {
  display: none;
}

@media (max-width: 480px) {
  .product-gallery__nav {
    width: 32px;
    height: 32px;
    opacity: 0.8;
  }

  .product-gallery__nav svg {
    width: 16px;
    height: 16px;
  }
}

.product-gallery__badges {
  position: absolute;
  top: 1rem;
  left: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  z-index: 1;
}

/* Sold Badge - Tilted Style */
.product-gallery__sold-badge {
  position: absolute;
  top: 1rem;
  right: 1rem;
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.375rem 0.75rem;
  background: var(--color-primary, #0369a1);
  color: white;
  font-size: 0.6875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  border-radius: 4px;
  transform: rotate(3deg);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  z-index: 2;
}

.product-gallery__sold-badge svg {
  flex-shrink: 0;
}

@media (max-width: 480px) {
  .product-gallery__sold-badge {
    font-size: 0.625rem;
    padding: 0.25rem 0.5rem;
  }
}

.product-gallery__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background-color: var(--color-background-light);
}

.product-gallery__placeholder svg {
  width: 100%;
  height: 100%;
  opacity: 0.3;
}

/* Thumbnails */
.product-gallery__thumbnails {
  display: flex;
  gap: 0.5rem;
  overflow-x: auto;
  padding-bottom: 0.5rem;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
  scroll-snap-type: x mandatory;
  max-width: 100%;
}

.product-gallery__thumbnail {
  position: relative;
  flex-shrink: 0;
  width: 80px;
  height: 80px;
  border: 2px solid transparent;
  border-radius: var(--radius-sm);
  overflow: hidden;
  cursor: pointer;
  transition: all var(--transition-speed);
  background-color: var(--color-background-light);
  padding: 0;
  scroll-snap-align: start;
}

@media (max-width: 480px) {
  .product-gallery__thumbnail {
    width: 70px;
    height: 70px;
  }
}

.product-gallery__thumbnail:hover {
  border-color: var(--color-border);
}

.product-gallery__thumbnail.active {
  border-color: var(--color-primary);
}

.product-gallery__thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.product-gallery__thumbnail-play,
.product-gallery__thumbnail-3d {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  background-color: rgba(0,0,0,0.6);
  border-radius: 50%;
  pointer-events: none;
}

.product-gallery__thumbnail-3d {
  font-size: 0.75rem;
  font-weight: 700;
  color: white;
  padding: 0.25rem 0.5rem;
  border-radius: var(--radius-sm);
  width: auto;
  height: auto;
}

/* Lightbox */
.product-gallery-lightbox {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-gallery-lightbox__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.95);
  cursor: zoom-out;
}

.product-gallery-lightbox__content {
  position: relative;
  width: 90%;
  height: 90%;
  max-width: 1400px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-gallery-lightbox__image {
  max-width: 100%;
  max-height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-gallery-lightbox__image img {
  max-width: 100%;
  max-height: 90vh;
  object-fit: contain;
}

.product-gallery-lightbox__image video,
.product-gallery-lightbox__image iframe {
  max-width: 100%;
  max-height: 90vh;
  width: auto;
  height: auto;
}

.product-gallery-lightbox__image .product-gallery__video {
  max-width: 100%;
  max-height: 90vh;
  background-color: transparent;
}

.product-gallery-lightbox__close {
  position: fixed;
  top: 1rem;
  right: 1rem;
  width: 48px;
  height: 48px;
  background-color: rgba(255,255,255,0.15);
  border: 1px solid rgba(255,255,255,0.3);
  border-radius: 50%;
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease, border-color 0.2s ease;
  z-index: 10001;
}

.product-gallery-lightbox__close:hover {
  background-color: rgba(255,255,255,0.3);
  border-color: rgba(255,255,255,0.5);
}

.product-gallery-lightbox__prev,
.product-gallery-lightbox__next {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 48px;
  height: 48px;
  background-color: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 50%;
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease, border-color 0.2s ease;
  z-index: 2;
}

.product-gallery-lightbox__prev[hidden],
.product-gallery-lightbox__next[hidden] {
  display: none;
}

.product-gallery-lightbox__prev {
  left: 1rem;
}

.product-gallery-lightbox__next {
  right: 1rem;
}

.product-gallery-lightbox__prev:hover,
.product-gallery-lightbox__next:hover {
  background-color: rgba(255,255,255,0.2);
}

.product-gallery-lightbox__counter {
  position: absolute;
  bottom: 1rem;
  left: 50%;
  transform: translateX(-50%);
  padding: 0.5rem 1rem;
  background-color: rgba(0,0,0,0.7);
  color: white;
  border-radius: var(--radius-md);
  font-size: 0.875rem;
  z-index: 2;
}

@media (min-width: 768px) {
  .product-gallery {
    flex-direction: column;
  }

  .product-gallery__main {
    flex: 1;
  }

  .product-gallery__thumbnails {
    flex-direction: row;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 0.5rem;
    padding-right: 0;
    /* Hide scrollbar but keep functionality */
    scrollbar-width: thin;
    scrollbar-color: transparent transparent;
  }

  /* Show scrollbar on hover for better UX */
  .product-gallery__thumbnails:hover {
    scrollbar-color: rgba(0, 0, 0, 0.3) transparent;
  }

  /* Webkit browsers (Chrome, Safari, Edge) */
  .product-gallery__thumbnails::-webkit-scrollbar {
    height: 6px;
  }

  .product-gallery__thumbnails::-webkit-scrollbar-track {
    background: transparent;
  }

  .product-gallery__thumbnails::-webkit-scrollbar-thumb {
    background-color: transparent;
    border-radius: 3px;
  }

  .product-gallery__thumbnails:hover::-webkit-scrollbar-thumb {
    background-color: rgba(0, 0, 0, 0.3);
  }

  .product-gallery__thumbnails::-webkit-scrollbar-thumb:hover {
    background-color: rgba(0, 0, 0, 0.5);
  }

  .product-gallery__thumbnail {
    width: 90px;
    height: 90px;
  }
}

@media (max-width: 767px) {
  .product-gallery-lightbox__prev,
  .product-gallery-lightbox__next {
    width: 40px;
    height: 40px;
  }
}
</style>

<script>
(function() {
  const gallery = document.querySelector('[data-product-gallery]');
  if (!gallery) return;

  const mainMediaContainer = gallery.querySelector('[data-main-media]');
  const thumbnails = gallery.querySelectorAll('[data-thumbnail]');
  const lightbox = document.querySelector('[data-lightbox]');
  const lightboxImage = lightbox?.querySelector('[data-lightbox-image]');
  const lightboxCounter = lightbox?.querySelector('[data-lightbox-counter]');
  const galleryPrev = gallery.querySelector('[data-gallery-prev]');
  const galleryNext = gallery.querySelector('[data-gallery-next]');

  // Move lightbox to body to escape sticky stacking context
  if (lightbox) document.body.appendChild(lightbox);

  let currentIndex = 0;
  const mediaData = [];
  const productData = {{ product | json }};

  // Collect all media data from product object
  if (productData && productData.media) {
    productData.media.forEach((media, index) => {
      const mediaItem = {
        type: media.media_type,
        id: media.id,
        alt: media.alt || productData.title
      };

      if (media.media_type === 'image') {
        mediaItem.src = media.src;
        // Get high-res version - remove size parameter and add _2000x2000
        const cleanUrl = media.src.split('?')[0]; // Remove query params
        mediaItem.largeSrc = cleanUrl.replace(/(_\d+x\d+)?(\.\w+)$/, '_2000x2000$2');
      } else if (media.media_type === 'video') {
        mediaItem.videoSources = media.sources;
      } else if (media.media_type === 'external_video') {
        mediaItem.externalId = media.external_id;
        mediaItem.host = media.host;
      } else if (media.media_type === 'model') {
        mediaItem.modelSources = media.sources;
      }

      mediaData.push(mediaItem);
    });
  }

  // Gallery navigation arrows
  function updateGalleryNav() {
    if (!galleryPrev || !galleryNext || mediaData.length <= 1) return;
    galleryPrev.hidden = (currentIndex === 0);
    galleryNext.hidden = (currentIndex === mediaData.length - 1);
  }

  if (galleryPrev) {
    galleryPrev.addEventListener('click', (e) => {
      e.stopPropagation();
      if (currentIndex > 0) {
        currentIndex--;
        updateMainMedia(currentIndex);
        updateActiveThumbnail(currentIndex);
        updateGalleryNav();
      }
    });
  }

  if (galleryNext) {
    galleryNext.addEventListener('click', (e) => {
      e.stopPropagation();
      if (currentIndex < mediaData.length - 1) {
        currentIndex++;
        updateMainMedia(currentIndex);
        updateActiveThumbnail(currentIndex);
        updateGalleryNav();
      }
    });
  }

  // Thumbnail click
  thumbnails.forEach((thumb, index) => {
    thumb.addEventListener('click', () => {
      currentIndex = index;
      updateMainMedia(index);
      updateActiveThumbnail(index);
      updateGalleryNav();
    });
  });

  function updateMainMedia(index) {
    if (!mainMediaContainer || !mediaData[index]) return;
    const media = mediaData[index];

    let html = '';

    if (media.type === 'image') {
      html = `
        <img
          src="${media.src}"
          alt="${media.alt}"
          data-zoom-image="${media.largeSrc}"
          data-media-type="image"
          loading="lazy"
        >
      `;
      mainMediaContainer.style.cursor = 'zoom-in';
    } else if (media.type === 'video' && media.videoSources) {
      const videoSource = media.videoSources[0];
      html = `
        <div class="product-gallery__video" data-media-type="video">
          <video controls>
            <source src="${videoSource.url}" type="${videoSource.mime_type}">
          </video>
        </div>
      `;
      mainMediaContainer.style.cursor = 'default';
    } else if (media.type === 'external_video') {
      let embedUrl = '';
      if (media.host === 'youtube') {
        embedUrl = `https://www.youtube-nocookie.com/embed/${media.externalId}?enablejsapi=1`;
      } else if (media.host === 'vimeo') {
        embedUrl = `https://player.vimeo.com/video/${media.externalId}`;
      }
      html = `
        <div class="product-gallery__video product-gallery__video--external" data-media-type="external_video">
          <iframe
            src="${embedUrl}"
            frameborder="0"
            allow="autoplay; encrypted-media"
            allowfullscreen
          ></iframe>
        </div>
      `;
      mainMediaContainer.style.cursor = 'default';
    }

    mainMediaContainer.innerHTML = html;

    // Re-add zoom hint for images
    if (media.type === 'image') {
      mainMediaContainer.innerHTML += `
        <div class="product-gallery__zoom-hint" data-zoom-hint>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2"/>
            <path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M8 5V11M5 8H11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span>${'{{ "products.product.click_to_zoom" | t | default: "Click to zoom" }}'}</span>
        </div>
      `;
    }
  }

  function updateActiveThumbnail(index) {
    thumbnails.forEach((thumb, i) => {
      thumb.classList.toggle('active', i === index);
    });
  }

  // Main media click - open lightbox (only for images)
  if (mainMediaContainer && lightbox) {
    mainMediaContainer.addEventListener('click', (e) => {
      const mediaType = mainMediaContainer.querySelector('[data-media-type]')?.dataset.mediaType;
      if (mediaType === 'image') {
        openLightbox(currentIndex);
      }
    });
  }

  function openLightbox(index) {
    if (!lightbox || mediaData.length === 0) return;

    currentIndex = index;
    lightbox.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    updateLightboxImage();
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.style.display = 'none';
    document.body.style.overflow = '';
  }

  function updateLightboxImage() {
    if (!lightboxImage || !mediaData[currentIndex]) return;

    const media = mediaData[currentIndex];
    let html = '';

    if (media.type === 'image') {
      html = `<img src="${media.largeSrc || media.src}" alt="${media.alt}">`;
    } else if (media.type === 'video' && media.videoSources) {
      const videoSource = media.videoSources[0];
      html = `
        <div class="product-gallery__video">
          <video controls autoplay>
            <source src="${videoSource.url}" type="${videoSource.mime_type}">
          </video>
        </div>
      `;
    } else if (media.type === 'external_video') {
      let embedUrl = '';
      if (media.host === 'youtube') {
        embedUrl = `https://www.youtube-nocookie.com/embed/${media.externalId}?autoplay=1&enablejsapi=1`;
      } else if (media.host === 'vimeo') {
        embedUrl = `https://player.vimeo.com/video/${media.externalId}?autoplay=1`;
      }
      html = `
        <div class="product-gallery__video">
          <iframe
            src="${embedUrl}"
            frameborder="0"
            allow="autoplay; encrypted-media"
            allowfullscreen
            width="100%"
            height="100%"
          ></iframe>
        </div>
      `;
    }

    lightboxImage.innerHTML = html;

    if (lightboxCounter) {
      lightboxCounter.textContent = `${currentIndex + 1} / ${mediaData.length}`;
    }

    // Update lightbox nav visibility
    const lbPrev = lightbox?.querySelector('[data-lightbox-prev]');
    const lbNext = lightbox?.querySelector('[data-lightbox-next]');
    if (lbPrev) lbPrev.hidden = (currentIndex === 0);
    if (lbNext) lbNext.hidden = (currentIndex === mediaData.length - 1);
  }

  // Lightbox controls
  if (lightbox) {
    const closeButtons = lightbox.querySelectorAll('[data-lightbox-close]');
    closeButtons.forEach(btn => {
      btn.addEventListener('click', closeLightbox);
    });

    const prevBtn = lightbox.querySelector('[data-lightbox-prev]');
    const nextBtn = lightbox.querySelector('[data-lightbox-next]');

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentIndex > 0) {
          currentIndex--;
          updateLightboxImage();
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (currentIndex < mediaData.length - 1) {
          currentIndex++;
          updateLightboxImage();
        }
      });
    }

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (lightbox.style.display !== 'flex') return;

      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft' && prevBtn) prevBtn.click();
      if (e.key === 'ArrowRight' && nextBtn) nextBtn.click();
    });
  }

  // Init gallery nav state
  updateGalleryNav();

  // Variant change - update featured media
  window.addEventListener('variantChange', (e) => {
    if (!e.detail || !e.detail.variant) return;

    const variant = e.detail.variant;
    if (variant.featured_media && variant.featured_media.id) {
      const mediaIndex = mediaData.findIndex(m => m.id == variant.featured_media.id);
      if (mediaIndex >= 0) {
        currentIndex = mediaIndex;
        updateMainMedia(mediaIndex);
        updateActiveThumbnail(mediaIndex);
        updateGalleryNav();
      }
    }
  });
})();
</script>
