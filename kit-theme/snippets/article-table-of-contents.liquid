{%- comment -%}
  Article Table of Contents
  Auto-generates clickable TOC from H2 and H3 headings
  Critical for SEO and UX on long articles
  Usage: {% render 'article-table-of-contents', content: article.content %}
{%- endcomment -%}

{%- liquid
  # Count H2 and H3 headings to determine if TOC should show
  assign h2_count = content | split: '<h2' | size | minus: 1
  assign h3_count = content | split: '<h3' | size | minus: 1
  assign heading_count = h2_count | plus: h3_count
-%}

{%- if heading_count >= 2 -%}
  <nav class="table-of-contents" aria-labelledby="toc-heading" data-toc-container>
    <button class="toc-header" data-toc-toggle aria-expanded="false" aria-controls="toc-list">
      <svg class="toc-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 4h14M3 10h10M3 16h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span id="toc-heading" class="toc-title">{{ 'blog.article.table_of_contents' | t | default: 'Sommaire' }}</span>
      <span class="toc-count" data-toc-count></span>
      <svg class="toc-chevron" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <ol id="toc-list" class="toc-list" style="display: none;">
      {%- comment -%} TOC items will be generated by JavaScript {%- endcomment -%}
    </ol>
  </nav>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const articleContent = document.querySelector('.article-content');
    const tocList = document.getElementById('toc-list');
    const tocContainer = document.querySelector('[data-toc-container]');
    const tocCount = document.querySelector('[data-toc-count]');

    if (!articleContent || !tocList) return;

    const headings = articleContent.querySelectorAll('h2, h3');
    const h2Headings = articleContent.querySelectorAll('h2');

    if (h2Headings.length < 2) {
      if (tocContainer) tocContainer.style.display = 'none';
      return;
    }

    // Update count badge - only count H2 sections
    if (tocCount) {
      tocCount.textContent = h2Headings.length + ' sections';
    }

    let headingIndex = 0;

    // Generate TOC items and add IDs to headings
    headings.forEach((heading) => {
      headingIndex++;
      const headingText = heading.textContent.trim();
      const headingId = headingText.toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '') + '-' + headingIndex;

      heading.id = headingId;

      const li = document.createElement('li');
      const isH3 = heading.tagName.toLowerCase() === 'h3';
      li.className = 'toc-item toc-item--level-' + (isH3 ? '3' : '2');

      const link = document.createElement('a');
      link.href = '#' + headingId;
      link.className = 'toc-link';
      link.textContent = headingText;

      li.appendChild(link);
      tocList.appendChild(li);
    });

    // TOC toggle - closed by default
    const tocToggle = document.querySelector('[data-toc-toggle]');

    if (tocToggle && tocList) {
      tocToggle.addEventListener('click', () => {
        const isExpanded = tocToggle.getAttribute('aria-expanded') === 'true';
        tocToggle.setAttribute('aria-expanded', !isExpanded);
        tocList.style.display = isExpanded ? 'none' : 'block';
        tocContainer.classList.toggle('is-open', !isExpanded);
      });
    }

    // Smooth scroll for TOC links
    tocList.addEventListener('click', (e) => {
      const link = e.target.closest('.toc-link');
      if (!link) return;

      e.preventDefault();
      const targetId = link.getAttribute('href');
      const targetElement = document.querySelector(targetId);

      if (targetElement) {
        const headerOffset = document.querySelector('[data-sticky-header]')?.offsetHeight || 80;
        const elementPosition = targetElement.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset - 20;

        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth'
        });

        history.pushState(null, null, targetId);

        document.querySelectorAll('.toc-link').forEach(l => l.classList.remove('active'));
        link.classList.add('active');
      }
    });
  });
  </script>
{%- endif -%}

<style>
/* Table of Contents - Collapsible, non-sticky */
.table-of-contents {
  background-color: var(--color-background-light);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  margin: var(--spacing-lg) 0;
  overflow: hidden;
}

.toc-header {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  width: 100%;
  padding: 0.875rem 1rem;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
  transition: background-color 0.2s ease;
}

.toc-header:hover {
  background-color: rgba(0, 0, 0, 0.02);
}

.toc-icon {
  color: var(--color-primary);
  flex-shrink: 0;
}

.toc-title {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--color-text);
  flex: 1;
}

.toc-count {
  font-size: 0.75rem;
  color: var(--color-text-light);
  background: var(--color-background);
  padding: 0.125rem 0.5rem;
  border-radius: 1rem;
}

.toc-chevron {
  color: var(--color-text-light);
  transition: transform 0.2s ease;
  flex-shrink: 0;
}

.table-of-contents.is-open .toc-chevron {
  transform: rotate(180deg);
}

.toc-list {
  list-style: none;
  padding: 0 1rem 1rem;
  margin: 0;
  border-top: 1px solid var(--color-border);
}

.toc-item--level-2 {
  margin-left: 0;
}

.toc-item--level-3 {
  margin-left: 1rem;
}

.toc-link {
  display: block;
  padding: 0.5rem 0;
  color: var(--color-text);
  text-decoration: none;
  font-size: 0.875rem;
  line-height: 1.4;
  transition: color 0.15s ease;
}

.toc-item--level-3 > .toc-link {
  font-size: 0.8125rem;
  color: var(--color-text-light);
  padding-left: 1rem;
}

.toc-link:hover {
  color: var(--color-primary);
}

.toc-link.active {
  color: var(--color-primary);
  font-weight: 600;
}
</style>
