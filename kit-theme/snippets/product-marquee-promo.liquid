{%- comment -%}
  Product Marquee Promo - Scrolling Banner for Product Pages
  A dynamic scrolling banner that creates urgency and highlights key benefits

  Parameters:
  - variant: Current variant object
  - product: Product object
  - show_savings: Show savings amount (default: true)
  - show_urgency: Show urgency messages (default: true)
  - theme: 'dark', 'light', 'gradient' (default: 'gradient')
{%- endcomment -%}

{%- liquid
  assign show_savings = show_savings | default: true
  assign show_urgency = show_urgency | default: true
  assign theme = theme | default: 'gradient'

  assign has_discount = false
  if variant.compare_at_price > variant.price
    assign has_discount = true
    assign savings = variant.compare_at_price | minus: variant.price
    assign savings_percent = savings | times: 100 | divided_by: variant.compare_at_price
  endif

  assign is_low_stock = false
  if variant.inventory_management and variant.inventory_quantity <= 10 and variant.inventory_quantity > 0
    assign is_low_stock = true
  endif
-%}

<div class="product-marquee product-marquee--{{ theme }}" data-product-marquee>
  <div class="product-marquee__track">
    <div class="product-marquee__content">
      {%- for i in (1..3) -%}

        {%- if has_discount and show_savings -%}
          <span class="product-marquee__item product-marquee__item--highlight">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 0L10 5.5H16L11 9L13 15L8 11.5L3 15L5 9L0 5.5H6L8 0Z"/>
            </svg>
            ÉCONOMISEZ {{ savings | money }}
          </span>
          <span class="product-marquee__sep">✦</span>
        {%- endif -%}

        {%- if is_low_stock and show_urgency -%}
          <span class="product-marquee__item product-marquee__item--urgent">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
              <path d="M8 4v4l2.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            STOCK LIMITÉ
          </span>
          <span class="product-marquee__sep">✦</span>
        {%- endif -%}

        <span class="product-marquee__item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <rect x="2" y="5" width="10" height="8" rx="1" stroke="currentColor" stroke-width="1.5"/>
            <path d="M12 7h2l1.5 2v4H12V7z" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="5" cy="14" r="1.5" stroke="currentColor" stroke-width="1"/>
            <circle cx="13" cy="14" r="1.5" stroke="currentColor" stroke-width="1"/>
          </svg>
          LIVRAISON RAPIDE
        </span>
        <span class="product-marquee__sep">✦</span>

        <span class="product-marquee__item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M8 14.5s5.5-2.5 5.5-7V3L8 1 2.5 3v4.5c0 4.5 5.5 7 5.5 7z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M5.5 8l2 2 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          PAIEMENT SÉCURISÉ
        </span>
        <span class="product-marquee__sep">✦</span>

        <span class="product-marquee__item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/>
            <path d="M8 5v3l2 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M2 2l2 2M14 2l-2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          RETOURS 30 JOURS
        </span>
        <span class="product-marquee__sep">✦</span>

        <span class="product-marquee__item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M14 8a6 6 0 01-6 6m0 0a6 6 0 01-6-6m6 6V2m6 6H2" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="8" cy="8" r="2" fill="currentColor"/>
          </svg>
          QUALITÉ PREMIUM
        </span>
        <span class="product-marquee__sep">✦</span>

      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .product-marquee {
    --marquee-bg: linear-gradient(90deg, #1a1a2e 0%, #16213e 50%, #1a1a2e 100%);
    --marquee-text: #ffffff;
    --marquee-accent: #fbbf24;
    --marquee-urgent: #ef4444;

    position: relative;
    overflow: hidden;
    border-radius: 10px;
    margin: 0.75rem 0;
  }

  .product-marquee--gradient {
    --marquee-bg: linear-gradient(90deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
  }

  .product-marquee--light {
    --marquee-bg: linear-gradient(90deg, #f8fafc 0%, #f1f5f9 50%, #f8fafc 100%);
    --marquee-text: #1f2937;
    --marquee-accent: #2563eb;
  }

  .product-marquee--dark {
    --marquee-bg: linear-gradient(90deg, #000000 0%, #111111 50%, #000000 100%);
  }

  .product-marquee::before,
  .product-marquee::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 60px;
    z-index: 2;
    pointer-events: none;
  }

  .product-marquee::before {
    left: 0;
    background: linear-gradient(90deg, var(--marquee-text), transparent);
    opacity: 0.15;
  }

  .product-marquee::after {
    right: 0;
    background: linear-gradient(-90deg, var(--marquee-text), transparent);
    opacity: 0.15;
  }

  .product-marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 30s linear infinite;
    background: var(--marquee-bg);
    padding: 0.625rem 0;
  }

  .product-marquee:hover .product-marquee__track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }

  .product-marquee__content {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-right: 1.25rem;
  }

  .product-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    color: var(--marquee-text);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .product-marquee__item svg {
    flex-shrink: 0;
    opacity: 0.8;
  }

  .product-marquee__item--highlight {
    color: var(--marquee-accent);
    animation: marquee-pulse 2s ease-in-out infinite;
  }

  .product-marquee__item--highlight svg {
    opacity: 1;
    animation: marquee-star-spin 3s linear infinite;
  }

  @keyframes marquee-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.8; }
  }

  @keyframes marquee-star-spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .product-marquee__item--urgent {
    color: var(--marquee-urgent);
    position: relative;
  }

  .product-marquee__item--urgent::before {
    content: '';
    position: absolute;
    inset: -4px -8px;
    background: rgba(239, 68, 68, 0.15);
    border-radius: 4px;
    animation: marquee-urgent-pulse 1.5s ease-in-out infinite;
  }

  @keyframes marquee-urgent-pulse {
    0%, 100% { opacity: 0; transform: scale(0.95); }
    50% { opacity: 1; transform: scale(1); }
  }

  .product-marquee__sep {
    color: var(--marquee-accent);
    font-size: 0.625rem;
    opacity: 0.6;
  }

  /* Mobile */
  @media (max-width: 767px) {
    .product-marquee__track {
      padding: 0.5rem 0;
    }

    .product-marquee__item {
      font-size: 0.625rem;
      gap: 0.3rem;
    }

    .product-marquee__item svg {
      width: 14px;
      height: 14px;
    }

    .product-marquee__content {
      gap: 1rem;
    }
  }
</style>
