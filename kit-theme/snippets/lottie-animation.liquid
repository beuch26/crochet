{%- comment -%}
  Lottie Animation Component
  Renders a Lottie animation from URL or JSON

  Parameters:
  - src: URL to Lottie JSON file (required)
  - autoplay: Start animation automatically (default: true)
  - loop: Loop animation (default: true)
  - width: Width of container
  - height: Height of container
  - trigger: 'load', 'hover', 'scroll' (default: 'load')
  - class: Additional CSS classes

  Usage:
  {%- render 'lottie-animation', src: 'https://...', width: '200px', height: '200px' -%}
{%- endcomment -%}

{%- liquid
  assign src = src | default: ''
  assign autoplay = autoplay | default: true
  assign loop = loop | default: true
  assign width = width | default: '100%'
  assign height = height | default: 'auto'
  assign trigger = trigger | default: 'load'
  assign speed = speed | default: 1
  assign extra_class = class | default: ''
-%}

{%- if src != blank -%}
  <div
    class="lottie-animation {{ extra_class }}"
    data-lottie
    data-lottie-src="{{ src }}"
    data-lottie-autoplay="{{ autoplay }}"
    data-lottie-loop="{{ loop }}"
    data-lottie-trigger="{{ trigger }}"
    data-lottie-speed="{{ speed }}"
    style="width: {{ width }}; height: {{ height }};"
  >
    <div class="lottie-animation__player" data-lottie-player></div>
    <noscript>
      <p class="lottie-animation__fallback">{{ 'general.lottie_fallback' | t | default: 'L\'animation nécessite JavaScript' }}</p>
    </noscript>
  </div>
{%- endif -%}

<style>
  .lottie-animation {
    position: relative;
    display: inline-block;
  }

  .lottie-animation__player {
    width: 100%;
    height: 100%;
  }

  .lottie-animation__player svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lottie-animation__fallback {
    text-align: center;
    padding: var(--spacing-md);
    color: var(--color-text-light);
    font-size: 0.875rem;
  }
</style>

<script>
  (function() {
    'use strict';

    let lottieLoaded = false;
    const pendingAnimations = [];

    function loadLottieLibrary() {
      if (lottieLoaded || document.querySelector('script[src*="lottie"]')) {
        return Promise.resolve();
      }

      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js';
        script.async = true;
        script.onload = () => {
          lottieLoaded = true;
          resolve();
        };
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }

    function initLottieAnimation(container) {
      const player = container.querySelector('[data-lottie-player]');
      if (!player || container.dataset.lottieInitialized) return;

      const src = container.dataset.lottieSrc;
      const autoplay = container.dataset.lottieAutoplay === 'true';
      const loop = container.dataset.lottieLoop === 'true';
      const trigger = container.dataset.lottieTrigger || 'load';
      const speed = parseFloat(container.dataset.lottieSpeed) || 1;

      if (!src) return;

      container.dataset.lottieInitialized = 'true';

      function createAnimation() {
        if (typeof lottie === 'undefined') {
          pendingAnimations.push({ container, player, src, autoplay, loop, trigger, speed });
          loadLottieLibrary().then(processPendingAnimations);
          return;
        }

        const anim = lottie.loadAnimation({
          container: player,
          renderer: 'svg',
          loop: loop,
          autoplay: trigger === 'load' && autoplay,
          path: src
        });

        anim.setSpeed(speed);

        if (trigger === 'hover') {
          container.addEventListener('mouseenter', () => anim.play());
          container.addEventListener('mouseleave', () => {
            anim.pause();
            anim.goToAndStop(0, true);
          });
        }

        if (trigger === 'scroll') {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                anim.play();
              } else {
                anim.pause();
              }
            });
          }, { threshold: 0.3 });

          observer.observe(container);
        }

        container._lottieAnim = anim;
      }

      createAnimation();
    }

    function processPendingAnimations() {
      while (pendingAnimations.length > 0) {
        const { container } = pendingAnimations.shift();
        container.dataset.lottieInitialized = '';
        initLottieAnimation(container);
      }
    }

    document.querySelectorAll('[data-lottie]').forEach(initLottieAnimation);

    if (Shopify.designMode) {
      document.addEventListener('shopify:section:load', (e) => {
        e.target.querySelectorAll('[data-lottie]').forEach(initLottieAnimation);
      });
    }
  })();
</script>
