{%- comment -%}
  Cart Upsells Component
  Shows recommended products in cart drawer to increase AOV
{%- endcomment -%}

{%- liquid
  assign max_products = max_products | default: 3
  assign layout = layout | default: 'slider'

  assign cart_product_ids = ''
  for item in cart.items
    assign cart_product_ids = cart_product_ids | append: item.product.id | append: ','
  endfor

  assign shown_ids = ''
  assign shown_count = 0
-%}

{%- comment -%} Try to get products from cart item's collections first {%- endcomment -%}
{%- assign has_source = false -%}
{%- for item in cart.items limit: 1 -%}
  {%- if item.product.collections.size > 0 -%}
    {%- for coll in item.product.collections limit: 1 -%}
      {%- if coll.products.size > 1 -%}
        {%- assign upsell_source = coll -%}
        {%- assign has_source = true -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} Fallback: try known collection handles {%- endcomment -%}
{%- unless has_source -%}
  {%- assign test_coll = collections['kits-de-crochet'] -%}
  {%- if test_coll != blank and test_coll.products.size > 0 -%}
    {%- assign upsell_source = test_coll -%}
    {%- assign has_source = true -%}
  {%- endif -%}
{%- endunless -%}

{%- unless has_source -%}
  {%- assign test_coll = collections['kits-debutants-faciles'] -%}
  {%- if test_coll != blank and test_coll.products.size > 0 -%}
    {%- assign upsell_source = test_coll -%}
    {%- assign has_source = true -%}
  {%- endif -%}
{%- endunless -%}

{%- unless has_source -%}
  {%- assign test_coll = collections['all'] -%}
  {%- if test_coll != blank and test_coll.products.size > 0 -%}
    {%- assign upsell_source = test_coll -%}
    {%- assign has_source = true -%}
  {%- endif -%}
{%- endunless -%}

{%- if has_source and upsell_source.products.size > 0 -%}
  {%- comment -%} Count available products first {%- endcomment -%}
  {%- assign available_count = 0 -%}
  {%- for product in upsell_source.products limit: 10 -%}
    {%- assign pid_str = product.id | append: ',' -%}
    {%- unless cart_product_ids contains pid_str -%}
      {%- if product.available -%}
        {%- assign available_count = available_count | plus: 1 -%}
      {%- endif -%}
    {%- endunless -%}
  {%- endfor -%}

  {%- if available_count > 0 -%}
    <div class="cart-upsells" data-cart-upsells>
      <div class="cart-upsells__header">
        <h3 class="cart-upsells__title">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.44.91-5.32L2.27 6.62l5.34-.78L10 1z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {{ 'cart.upsells.title' | t | default: 'Vous aimerez aussi' }}
        </h3>
      </div>

      <div class="cart-upsells__products cart-upsells__products--{{ layout }}" data-upsells-container>
        {%- for product in upsell_source.products -%}
          {%- if shown_count >= max_products -%}
            {%- break -%}
          {%- endif -%}

          {%- assign pid_str = product.id | append: ',' -%}
          {%- assign skip_product = false -%}

          {%- if cart_product_ids contains pid_str -%}
            {%- assign skip_product = true -%}
          {%- endif -%}

          {%- if shown_ids contains pid_str -%}
            {%- assign skip_product = true -%}
          {%- endif -%}

          {%- unless product.available -%}
            {%- assign skip_product = true -%}
          {%- endunless -%}

          {%- comment -%} Skip affiliate products {%- endcomment -%}
          {%- if product.metafields.custom.affiliate_url != blank -%}
            {%- assign skip_product = true -%}
          {%- endif -%}

          {%- unless skip_product -%}
            {%- assign shown_ids = shown_ids | append: pid_str -%}
            {%- assign shown_count = shown_count | plus: 1 -%}
            {%- assign variant = product.selected_or_first_available_variant -%}

            <div class="cart-upsell-item" data-upsell-item>
              <a href="{{ product.url }}" class="cart-upsell-item__image">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 100 }}"
                    alt="{{ product.title | escape }}"
                    width="80"
                    height="80"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>

              <div class="cart-upsell-item__info">
                <a href="{{ product.url }}" class="cart-upsell-item__title">
                  {{ product.title | truncate: 25 }}
                </a>
                <div class="cart-upsell-item__price">
                  {%- if variant.compare_at_price > variant.price -%}
                    <span class="cart-upsell-item__price--compare">{{ variant.compare_at_price | money }}</span>
                  {%- endif -%}
                  <span class="cart-upsell-item__price--current">{{ variant.price | money }}</span>
                </div>
              </div>

              <button type="button"
                      class="cart-upsell-item__add btn btn--primary btn--small"
                      data-upsell-add
                      data-variant-id="{{ variant.id }}"
                      aria-label="{{ 'cart.add' | t | default: 'Ajouter' }} {{ product.title | escape }}">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>

    <style>
      .cart-upsells {
        padding: 1rem 0;
        border-top: 1px solid var(--color-border, #e5e5e5);
        margin-top: 1rem;
      }

      .cart-upsells__header {
        margin-bottom: 0.75rem;
      }

      .cart-upsells__title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--color-text, #333);
        margin: 0;
      }

      .cart-upsells__title svg {
        color: var(--color-warning, #f59e0b);
      }

      .cart-upsells__products {
        display: flex;
        gap: 0.75rem;
      }

      .cart-upsells__products--slider {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: var(--color-border, #e5e5e5) transparent;
        padding-bottom: 8px;
        scroll-snap-type: x mandatory;
      }

      .cart-upsells__products--slider::-webkit-scrollbar {
        height: 4px;
      }

      .cart-upsells__products--slider::-webkit-scrollbar-track {
        background: transparent;
        border-radius: 2px;
      }

      .cart-upsells__products--slider::-webkit-scrollbar-thumb {
        background: var(--color-border, #e5e5e5);
        border-radius: 2px;
      }

      .cart-upsells__products--slider::-webkit-scrollbar-thumb:hover {
        background: var(--color-primary, #6366f1);
      }

      .cart-upsells__products--grid {
        flex-wrap: wrap;
      }

      .cart-upsell-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem;
        background-color: var(--color-background-light, #f9f9f9);
        border-radius: 8px;
        flex: 0 0 230px;
        max-width: 230px;
        scroll-snap-align: start;
      }

      .cart-upsells__products--grid .cart-upsell-item {
        flex: 1 1 calc(50% - 0.375rem);
        min-width: auto;
      }

      .cart-upsell-item__image {
        width: 56px;
        height: 56px;
        flex-shrink: 0;
        border-radius: 6px;
        overflow: hidden;
      }

      .cart-upsell-item__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .cart-upsell-item__info {
        flex: 1;
        min-width: 0;
      }

      .cart-upsell-item__title {
        display: block;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--color-text, #333);
        text-decoration: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 0.125rem;
      }

      .cart-upsell-item__title:hover {
        color: var(--color-primary, #6366f1);
      }

      .cart-upsell-item__price {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.75rem;
      }

      .cart-upsell-item__price--compare {
        text-decoration: line-through;
        color: var(--color-text-light, #999);
      }

      .cart-upsell-item__price--current {
        font-weight: 600;
        color: var(--color-text, #333);
      }

      .cart-upsell-item__add {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background-color: var(--color-primary, #6366f1);
        color: white;
        border: none;
        cursor: pointer;
      }

      .cart-upsell-item__add:hover {
        opacity: 0.9;
      }

      .cart-upsell-item__add.added {
        background-color: var(--color-success, #22c55e);
        pointer-events: none;
      }

      .cart-upsell-item__add.loading {
        opacity: 0.6;
        pointer-events: none;
      }
    </style>
  {%- endif -%}
{%- endif -%}
