{%- comment -%}
  SEO Meta Tags: Open Graph, Twitter Cards, and other social meta tags
  This snippet handles all social sharing metadata for optimal SEO
{%- endcomment -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: shop.description
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_image = ''
  assign og_image_width = 1200
  assign og_image_height = 630

  # Determine og:type and image based on template
  case template.name
    when 'product'
      assign og_type = 'product'
      if product.featured_image
        assign og_image = product.featured_image | image_url: width: 1200
        assign og_image_width = product.featured_image.width
        assign og_image_height = product.featured_image.height
      endif
    when 'article'
      assign og_type = 'article'
      if article.image
        assign og_image = article.image | image_url: width: 1200
        assign og_image_width = article.image.width
        assign og_image_height = article.image.height
      endif
    when 'collection'
      if collection.image
        assign og_image = collection.image | image_url: width: 1200
        assign og_image_width = collection.image.width
        assign og_image_height = collection.image.height
      elsif collection.products.first and collection.products.first.featured_image
        assign og_image = collection.products.first.featured_image | image_url: width: 1200
      endif
  endcase

  # Fallback to shop logo or default image
  if og_image == blank and settings.logo
    assign og_image = settings.logo | image_url: width: 1200
  elsif og_image == blank and settings.share_image
    assign og_image = settings.share_image | image_url: width: 1200
  endif
-%}

{%- comment -%} Open Graph Meta Tags {%- endcomment -%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | strip_html | truncate: 300 | escape }}">

{%- if og_image != blank -%}
  <meta property="og:image" content="https:{{ og_image }}">
  <meta property="og:image:secure_url" content="https:{{ og_image }}">
  <meta property="og:image:width" content="{{ og_image_width }}">
  <meta property="og:image:height" content="{{ og_image_height }}">
  <meta property="og:image:alt" content="{{ og_title | escape }}">
{%- endif -%}

{%- if template.name == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="og:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">

  {%- if product.variants.size > 1 -%}
    <meta property="product:plural_title" content="{{ product.variants.size }} {{ 'products.product.variants' | t }}">
  {%- endif -%}
{%- endif -%}

{%- if template.name == 'article' -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  {%- if article.updated_at != article.published_at -%}
    <meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  {%- endif -%}
  <meta property="article:author" content="{{ article.author | escape }}">
  {%- for tag in article.tags -%}
    <meta property="article:tag" content="{{ tag | escape }}">
  {%- endfor -%}
{%- endif -%}

{%- comment -%} Facebook App ID {%- endcomment -%}
{%- if settings.facebook_app_id != blank -%}
  <meta property="fb:app_id" content="{{ settings.facebook_app_id }}">
{%- endif -%}

{%- comment -%} Twitter Card Meta Tags {%- endcomment -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | truncate: 200 | escape }}">

{%- if settings.twitter_username != blank -%}
  <meta name="twitter:site" content="@{{ settings.twitter_username }}">
  <meta name="twitter:creator" content="@{{ settings.twitter_username }}">
{%- endif -%}

{%- if og_image != blank -%}
  <meta name="twitter:image" content="https:{{ og_image }}">
  <meta name="twitter:image:alt" content="{{ og_title | escape }}">
{%- endif -%}

{%- if template.name == 'product' and product.available -%}
  <meta name="twitter:label1" content="{{ 'products.product.price' | t }}">
  <meta name="twitter:data1" content="{{ product.price | money }}">

  {%- if product.compare_at_price > product.price -%}
    <meta name="twitter:label2" content="{{ 'products.product.save' | t }}">
    <meta name="twitter:data2" content="{{ product.compare_at_price | minus: product.price | money }}">
  {%- endif -%}
{%- endif -%}

{%- comment -%} Additional SEO Meta Tags {%- endcomment -%}
{%- if template.name == 'product' -%}
  <meta name="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta name="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta name="product:brand" content="{{ product.vendor | escape }}">
  <meta name="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
  <meta name="product:condition" content="new">
{%- endif -%}

{%- comment -%} Pinterest Rich Pins {%- endcomment -%}
<meta name="pinterest-rich-pin" content="true">

{%- comment -%} Google+ / Schema.org Microdata (legacy support) {%- endcomment -%}
<meta itemprop="name" content="{{ og_title | escape }}">
<meta itemprop="description" content="{{ og_description | strip_html | truncate: 300 | escape }}">
{%- if og_image != blank -%}
  <meta itemprop="image" content="https:{{ og_image }}">
{%- endif -%}

{%- comment -%} Author Information {%- endcomment -%}
{%- if template.name == 'article' and settings.enable_author_info -%}
  <link rel="author" href="{{ shop.url }}/pages/about-{{ article.author | handleize }}">
{%- endif -%}

{%- comment -%} Geo Tags for Local Business {%- endcomment -%}
{%- if settings.enable_local_business and settings.business_latitude != blank -%}
  <meta name="geo.position" content="{{ settings.business_latitude }};{{ settings.business_longitude }}">
  <meta name="ICBM" content="{{ settings.business_latitude }}, {{ settings.business_longitude }}">
  <meta name="geo.placename" content="{{ settings.business_city }}, {{ settings.business_country }}">
  <meta name="geo.region" content="{{ settings.business_region }}">
{%- endif -%}
