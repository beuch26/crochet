          claimBtn.textContent = window.theme?.translations?.giftAdded || '✓ Cadeau ajouté !';
          claimBtn.classList.add('btn--success-claimed');

          setTimeout(() => {
            if (typeof Cart !== 'undefined' && Cart.openDrawer) {
              Cart.openDrawer();
              Cart.refreshDrawer();
            }
          }, 500);

        } catch (error) {
          console.error('Gift claim error:', error);
          alert(window.theme?.translations?.cartError || 'Erreur lors de l\'ajout du cadeau');
        } finally {
          claimBtn.classList.remove('loading');
        }
      });
    }

    document.addEventListener('cart:updated', (event) => {
      const cart = event.detail.cart;
      const productId = giftEl.dataset.productId;
      const threshold = parseInt(giftEl.dataset.threshold);

      if (productId === 'global') return;

      let currentQuantity = 0;
      cart.items.forEach(item => {
        if (item.product_id == productId) {
          currentQuantity += item.quantity;
        }
      });

      const progress = Math.min((currentQuantity / threshold) * 100, 100);
      const progressFill = giftEl.querySelector('[data-gift-progress]');
      if (progressFill) {
        progressFill.style.width = progress + '%';
      }
    });
  })();
</script>
