    const giftEl = document.querySelector('[data-quantity-gift]');
    if (!giftEl) return;

    const claimBtn = giftEl.querySelector('[data-claim-gift]');
    if (claimBtn) {
      claimBtn.addEventListener('click', async () => {
        const variantId = claimBtn.dataset.variantId;
        if (!variantId) return;

        claimBtn.classList.add('loading');
        claimBtn.disabled = true;

        try {
          const response = await fetch(window.Shopify?.routes?.root + 'cart/add.js', {
            method: 'POST',
