{%- comment -%}
  Social Proof Wall Section
  Inspired by ShipFast - Animated masonry wall of testimonials
  with auto-scrolling columns and Twitter/X style cards
{%- endcomment -%}

{%- liquid
  assign section_id = section.id
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign stat_number = section.settings.stat_number
  assign stat_label = section.settings.stat_label
  assign stat_prefix = section.settings.stat_prefix
  assign stat_suffix = section.settings.stat_suffix
  assign enable_counter = section.settings.enable_counter
  assign counter_duration = section.settings.counter_duration | default: 2000
  assign stat_color_type = section.settings.stat_color_type
  assign stat_color_start = section.settings.stat_color_start
  assign stat_color_end = section.settings.stat_color_end
  assign enable_animation = section.settings.enable_animation
  assign animation_speed = section.settings.animation_speed
  assign columns = section.settings.columns | default: 4
  assign max_height = section.settings.max_height | default: 600
  assign color_scheme = section.settings.color_scheme
-%}

{%- render 'section-spacing', id: section.id, margin_top: section.settings.section_margin_top, margin_bottom: section.settings.section_margin_bottom -%}

<section class="social-proof-wall section section--{{ color_scheme }}" id="social-proof-{{ section_id }}" data-section-id="{{ section_id }}">
  <div class="container">
    {%- if heading != blank or stat_number != blank -%}
      <header class="social-proof-wall__header">
        {%- if stat_number != blank -%}
          {%- capture stat_bg -%}
            {%- if stat_color_type == 'primary' -%}
              {{ settings.color_primary | default: '#2563eb' }}
            {%- elsif stat_color_type == 'custom' -%}
              linear-gradient(135deg, {{ stat_color_start | default: '#50b7f1' }} 0%, {{ stat_color_end | default: '#a855f7' }} 100%)
            {%- else -%}
              linear-gradient(135deg, {{ settings.color_primary | default: '#2563eb' }} 0%, {{ settings.color_secondary | default: '#a855f7' }} 100%)
            {%- endif -%}
          {%- endcapture -%}
          <div class="social-proof-wall__stat">
            <span
              class="social-proof-wall__stat-number{% if enable_counter %} social-proof-wall__stat-number--counter{% endif %}"
              style="background: {{ stat_bg | strip }}; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
              {% if enable_counter %}
                data-counter-target="{{ stat_number }}"
                data-counter-duration="{{ counter_duration }}"
                data-counter-prefix="{{ stat_prefix }}"
                data-counter-suffix="{{ stat_suffix }}"
              {% endif %}
            >
              {%- if enable_counter -%}0{%- else -%}{{ stat_prefix }}{{ stat_number }}{{ stat_suffix }}{%- endif -%}
            </span>
            {%- if stat_label != blank -%}
              <span class="social-proof-wall__stat-label">{{ stat_label }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Reviews Badge {%- endcomment -%}
        {%- if section.settings.reviews_count != blank -%}
          {%- assign spw_stars_color = section.settings.reviews_stars_color | default: '#fbbf24' -%}
          {%- assign spw_text_color = section.settings.reviews_text_color | default: '#6b7280' -%}
          {%- assign spw_rating = section.settings.reviews_rating | default: 5 | times: 1.0 -%}
          <div class="social-proof-wall__reviews" style="color: {{ spw_text_color }};">
            <div class="social-proof-wall__reviews-stars">
              {%- for i in (1..5) -%}
                {%- assign spw_fill = spw_rating | minus: i | plus: 1 -%}
                {%- if spw_fill >= 1 -%}
                  <svg class="social-proof-wall__star" width="22" height="22" viewBox="0 0 20 20" fill="{{ spw_stars_color }}" xmlns="http://www.w3.org/2000/svg"><path d="M10 1.25l2.47 5.01 5.53.8-4 3.9.94 5.5L10 13.87l-4.94 2.59.94-5.5-4-3.9 5.53-.8L10 1.25z"/></svg>
                {%- elsif spw_fill > 0 -%}
                  {%- assign spw_pct = spw_fill | times: 100 | round -%}
                  <svg class="social-proof-wall__star" width="22" height="22" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                    <defs><linearGradient id="spw-star-{{ section.id }}-{{ i }}"><stop offset="{{ spw_pct }}%" stop-color="{{ spw_stars_color }}"/><stop offset="{{ spw_pct }}%" stop-color="#d1d5db"/></linearGradient></defs>
                    <path d="M10 1.25l2.47 5.01 5.53.8-4 3.9.94 5.5L10 13.87l-4.94 2.59.94-5.5-4-3.9 5.53-.8L10 1.25z" fill="url(#spw-star-{{ section.id }}-{{ i }})"/>
                  </svg>
                {%- else -%}
                  <svg class="social-proof-wall__star" width="22" height="22" viewBox="0 0 20 20" fill="#d1d5db" xmlns="http://www.w3.org/2000/svg"><path d="M10 1.25l2.47 5.01 5.53.8-4 3.9.94 5.5L10 13.87l-4.94 2.59.94-5.5-4-3.9 5.53-.8L10 1.25z"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <span class="social-proof-wall__reviews-text">{{ section.settings.reviews_rating | default: '5.0' }}/5 - {{ section.settings.reviews_count }} {{ section.settings.reviews_label | default: 'avis Google' }}</span>
            {%- if section.settings.reviews_icon != blank and section.settings.reviews_icon != 'none' -%}
              <span class="social-proof-wall__reviews-icon">
                {%- case section.settings.reviews_icon -%}
                  {%- when 'google' -%}
                    <svg width="20" height="20" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59a14.5 14.5 0 0 1 0-9.18l-7.98-6.19a24.03 24.03 0 0 0 0 21.56l7.98-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                  {%- when 'trustpilot' -%}
                    <svg width="20" height="20" viewBox="0 0 48 48"><path fill="#00B67A" d="M48 18.3H29.6L24 0l-5.6 18.3H0l15.2 11-5.8 18.3L24 36.5l14.6 11.1-5.8-18.3L48 18.3z"/></svg>
                  {%- when 'etsy' -%}
                    <svg width="20" height="20" viewBox="0 0 48 48"><path fill="#F56400" d="M24 0C10.75 0 0 10.75 0 24s10.75 24 24 24 24-10.75 24-24S37.25 0 24 0z"/><path fill="#fff" d="M14 13.5c0-1 .2-1.5 1.6-1.5h8.8c2.4 0 3.2.8 3.8 3.6l.6 2.4h1.6l-.4-8.5H14.2c-1.8 0-3.2.2-3.2 2.2V33c0 2 1.4 2.2 3.2 2.2h16.2l.8-8.5h-1.6l-1 2.8c-.6 2.4-1.4 3.2-4 3.2h-7.2c-1.8 0-2.4-.4-2.4-1.8v-8.4h6.8c2 0 2.6.6 3 3l.4 1.6h1.6V17h-1.6l-.4 1.6c-.4 2.4-1 3-3 3H15V13.5z"/></svg>
                  {%- when 'facebook' -%}
                    <svg width="20" height="20" viewBox="0 0 48 48"><path fill="#1877F2" d="M48 24C48 10.75 37.25 0 24 0S0 10.75 0 24c0 11.98 8.77 21.9 20.25 23.7V30.94h-6.1V24h6.1v-5.29c0-6.01 3.58-9.34 9.07-9.34 2.63 0 5.38.47 5.38.47v5.9h-3.03c-2.98 0-3.92 1.85-3.92 3.75V24h6.66l-1.06 6.94h-5.6V47.7C39.23 45.9 48 35.98 48 24z"/></svg>
                {%- endcase -%}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if heading != blank -%}
          {%- if section.settings.enable_heading_style -%}
            {%- render 'heading-styles',
              text: heading,
              tag: 'h2',
              style: section.settings.heading_style,
              color: section.settings.heading_style_color,
              align: 'center',
              size: 'xl',
              typing_texts: section.settings.typing_texts
            -%}
          {%- else -%}
            <h2 class="social-proof-wall__title">{{ heading }}</h2>
          {%- endif -%}
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="social-proof-wall__subtitle">{{ subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="social-proof-wall__container{% if enable_animation %} social-proof-wall__container--animated{% endif %}"
        style="--wall-columns: {{ columns }}; --wall-max-height: {{ max_height }}px; --animation-speed: {{ animation_speed }}s;"
      >
        <div class="social-proof-wall__gradient social-proof-wall__gradient--top"></div>
        <div class="social-proof-wall__gradient social-proof-wall__gradient--bottom"></div>

        <div class="social-proof-wall__columns">
          {%- assign blocks_per_column = section.blocks.size | divided_by: columns | ceil -%}
          {%- for col in (1..columns) -%}
            {%- assign col_start = col | minus: 1 | times: blocks_per_column -%}
            {%- assign col_end = col_start | plus: blocks_per_column | minus: 1 -%}
            {%- assign direction = col | modulo: 2 -%}

            <div class="social-proof-wall__column{% if direction == 0 %} social-proof-wall__column--reverse{% endif %}" data-column="{{ col }}">
              <div class="social-proof-wall__column-inner">
                {%- for block in section.blocks -%}
                  {%- assign block_index = forloop.index0 -%}
                  {%- if block_index >= col_start and block_index <= col_end -%}
                    <article class="social-proof-card" {{ block.shopify_attributes }}>
                      <div class="social-proof-card__header">
                        <div class="social-proof-card__avatar">
                          {%- if block.settings.avatar != blank -%}
                            <img
                              src="{{ block.settings.avatar | image_url: width: 96 }}"
                              alt="{{ block.settings.author }}"
                              width="48"
                              height="48"
                              loading="lazy"
                            >
                          {%- else -%}
                            {%- assign initials = block.settings.author | split: ' ' -%}
                            {%- assign first_initial = initials[0] | slice: 0 | upcase -%}
                            {%- assign last_initial = initials[1] | slice: 0 | upcase | default: '' -%}
                            {%- assign avatar_colors = '#4c51bf|#9f1239|#0369a1|#166534|#b45309|#475569' | split: '|' -%}
                            {%- assign gradient_index = forloop.index0 | modulo: 6 -%}
                            <span class="social-proof-card__avatar-placeholder" style="background: {{ avatar_colors[gradient_index] }};">
                              {{ first_initial }}{{ last_initial }}
                            </span>
                          {%- endif -%}
                        </div>

                        <div class="social-proof-card__author">
                          <span class="social-proof-card__name">{{ block.settings.author | default: 'Anonymous' }}</span>
                          {%- if block.settings.handle != blank -%}
                            <span class="social-proof-card__handle">{{ block.settings.handle }}</span>
                          {%- endif -%}
                        </div>

                        {%- if block.settings.platform != 'none' -%}
                          <div class="social-proof-card__platform social-proof-card__platform--{{ block.settings.platform }}">
                            {%- case block.settings.platform -%}
                              {%- when 'twitter' -%}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                </svg>
                              {%- when 'instagram' -%}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                </svg>
                              {%- when 'facebook' -%}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                </svg>
                              {%- when 'tiktok' -%}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                                </svg>
                              {%- when 'youtube' -%}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                                </svg>
                            {%- endcase -%}
                          </div>
                        {%- endif -%}
                      </div>

                      {%- if block.settings.content != blank -%}
                        <div class="social-proof-card__content">
                          <p>{{ block.settings.content }}</p>
                        </div>
                      {%- endif -%}

                      {%- if block.settings.image != blank -%}
                        <div class="social-proof-card__image">
                          <img
                            src="{{ block.settings.image | image_url: width: 600 }}"
                            alt="{{ block.settings.author }} - Témoignage"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                            loading="lazy"
                          >
                        </div>
                      {%- endif -%}

                      {%- if block.settings.tag != blank -%}
                        <div class="social-proof-card__tag">
                          {{ block.settings.tag }}
                        </div>
                      {%- endif -%}
                    </article>
                  {%- endif -%}
                {%- endfor -%}

                {%- comment -%} Duplicate for infinite scroll effect {%- endcomment -%}
                {%- if enable_animation -%}
                  {%- for block in section.blocks -%}
                    {%- assign block_index = forloop.index0 -%}
                    {%- if block_index >= col_start and block_index <= col_end -%}
                      <article class="social-proof-card" aria-hidden="true">
                        <div class="social-proof-card__header">
                          <div class="social-proof-card__avatar">
                            {%- if block.settings.avatar != blank -%}
                              <img
                                src="{{ block.settings.avatar | image_url: width: 96 }}"
                                alt=""
                                width="48"
                                height="48"
                                loading="lazy"
                              >
                            {%- else -%}
                              {%- assign initials = block.settings.author | split: ' ' -%}
                              {%- assign first_initial = initials[0] | slice: 0 | upcase -%}
                              {%- assign last_initial = initials[1] | slice: 0 | upcase | default: '' -%}
                              {%- assign avatar_colors = '#4c51bf|#9f1239|#0369a1|#166534|#b45309|#475569' | split: '|' -%}
                              {%- assign gradient_index = forloop.index0 | modulo: 6 -%}
                              <span class="social-proof-card__avatar-placeholder" style="background: {{ avatar_colors[gradient_index] }};">
                                {{ first_initial }}{{ last_initial }}
                              </span>
                            {%- endif -%}
                          </div>

                          <div class="social-proof-card__author">
                            <span class="social-proof-card__name">{{ block.settings.author | default: 'Anonymous' }}</span>
                            {%- if block.settings.handle != blank -%}
                              <span class="social-proof-card__handle">{{ block.settings.handle }}</span>
                            {%- endif -%}
                          </div>

                          {%- if block.settings.platform != 'none' -%}
                            <div class="social-proof-card__platform social-proof-card__platform--{{ block.settings.platform }}">
                              {%- case block.settings.platform -%}
                                {%- when 'twitter' -%}
                                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                  </svg>
                                {%- when 'instagram' -%}
                                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                  </svg>
                                {%- when 'facebook' -%}
                                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                  </svg>
                                {%- when 'tiktok' -%}
                                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                                  </svg>
                                {%- when 'youtube' -%}
                                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                                  </svg>
                              {%- endcase -%}
                            </div>
                          {%- endif -%}
                        </div>

                        {%- if block.settings.content != blank -%}
                          <div class="social-proof-card__content">
                            <p>{{ block.settings.content }}</p>
                          </div>
                        {%- endif -%}

                        {%- if block.settings.image != blank -%}
                          <div class="social-proof-card__image">
                            <img
                              src="{{ block.settings.image | image_url: width: 600 }}"
                              alt=""
                              width="{{ block.settings.image.width }}"
                              height="{{ block.settings.image.height }}"
                              loading="lazy"
                            >
                          </div>
                        {%- endif -%}

                        {%- if block.settings.tag != blank -%}
                          <div class="social-proof-card__tag">
                            {{ block.settings.tag }}
                          </div>
                        {%- endif -%}
                      </article>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .social-proof-wall {
    padding: clamp(3rem, 8vw, 5rem) 0;
    overflow: hidden;
  }

  .social-proof-wall.section--dark {
    background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
  }

  .social-proof-wall.section--light {
    background: var(--color-background-light);
  }

  .social-proof-wall.section--accent {
    background: linear-gradient(135deg, rgba(80, 183, 241, 0.08) 0%, var(--color-background) 50%, rgba(147, 51, 234, 0.08) 100%);
  }

  /* Header */
  .social-proof-wall__header {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .social-proof-wall__stat {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .social-proof-wall__stat-number {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .social-proof-wall__stat-number--counter {
    min-width: 2ch;
  }

  .social-proof-wall__reviews {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .social-proof-wall__reviews-stars {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .social-proof-wall__star {
    flex-shrink: 0;
  }

  .social-proof-wall__reviews-text {
    font-size: 1rem;
    font-weight: 500;
  }

  .social-proof-wall__reviews-icon {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .section--dark .social-proof-wall__reviews-text {
    color: #94a3b8;
  }

  .social-proof-wall__stat-label {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    color: var(--color-text);
  }

  .social-proof-wall__title {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.75rem 0;
    line-height: 1.2;
  }

  .section--dark .social-proof-wall__title,
  .section--dark .social-proof-wall__stat-label {
    color: #f8fafc;
  }

  .social-proof-wall__subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: #4b5563;
    margin: 0;
    max-width: 600px;
    margin-inline: auto;
  }

  .section--dark .social-proof-wall__subtitle {
    color: #94a3b8;
  }

  /* Container */
  .social-proof-wall__container {
    position: relative;
    max-height: var(--wall-max-height, 600px);
    overflow: hidden;
  }

  .social-proof-wall__gradient {
    position: absolute;
    left: 0;
    right: 0;
    height: 80px;
    z-index: 2;
    pointer-events: none;
  }

  .social-proof-wall__gradient--top {
    top: 0;
    background: linear-gradient(to bottom, var(--color-background) 0%, transparent 100%);
  }

  .social-proof-wall__gradient--bottom {
    bottom: 0;
    background: linear-gradient(to top, var(--color-background) 0%, transparent 100%);
  }

  .section--dark .social-proof-wall__gradient--top {
    background: linear-gradient(to bottom, #0f172a 0%, transparent 100%);
  }

  .section--dark .social-proof-wall__gradient--bottom {
    background: linear-gradient(to top, #1e293b 0%, transparent 100%);
  }

  .section--light .social-proof-wall__gradient--top {
    background: linear-gradient(to bottom, var(--color-background-light) 0%, transparent 100%);
  }

  .section--light .social-proof-wall__gradient--bottom {
    background: linear-gradient(to top, var(--color-background-light) 0%, transparent 100%);
  }

  .section--accent .social-proof-wall__gradient--top {
    background: linear-gradient(to bottom, var(--color-background) 0%, transparent 100%);
  }

  .section--accent .social-proof-wall__gradient--bottom {
    background: linear-gradient(to top, var(--color-background) 0%, transparent 100%);
  }

  /* Columns */
  .social-proof-wall__columns {
    display: grid;
    grid-template-columns: repeat(var(--wall-columns, 4), 1fr);
    gap: 1rem;
    align-items: start;
  }

  .social-proof-wall__column {
    display: flex;
    flex-direction: column;
  }

  .social-proof-wall__column-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Animation */
  .social-proof-wall__container--animated .social-proof-wall__column-inner {
    animation: scrollUp var(--animation-speed, 30s) linear infinite;
  }

  .social-proof-wall__container--animated .social-proof-wall__column--reverse .social-proof-wall__column-inner {
    animation: scrollDown var(--animation-speed, 30s) linear infinite;
  }

  @keyframes scrollUp {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-50%);
    }
  }

  @keyframes scrollDown {
    0% {
      transform: translateY(-50%);
    }
    100% {
      transform: translateY(0);
    }
  }

  .social-proof-wall__container--animated:hover .social-proof-wall__column-inner {
    animation-play-state: paused;
  }

  /* Card */
  .social-proof-card {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1.25rem;
    transition: all 0.3s ease;
  }

  .section--dark .social-proof-card {
    background: rgba(30, 41, 59, 0.8);
    border-color: rgba(148, 163, 184, 0.1);
  }

  .social-proof-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 8px 30px rgba(80, 183, 241, 0.15);
    transform: translateY(-2px);
  }

  .social-proof-card__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.875rem;
  }

  .social-proof-card__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .social-proof-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .social-proof-card__avatar-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    color: white;
    border-radius: 50%;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .social-proof-card__author {
    flex: 1;
    min-width: 0;
  }

  .social-proof-card__name {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .section--dark .social-proof-card__name {
    color: #f8fafc;
  }

  .social-proof-card__handle {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-text-light);
  }

  .section--dark .social-proof-card__handle {
    color: #64748b;
  }

  .social-proof-card__platform {
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .social-proof-card:hover .social-proof-card__platform {
    opacity: 1;
  }

  .social-proof-card__platform--twitter { color: #000; }
  .social-proof-card__platform--instagram { color: #E4405F; }
  .social-proof-card__platform--facebook { color: #1877F2; }
  .social-proof-card__platform--tiktok { color: #000; }
  .social-proof-card__platform--youtube { color: #FF0000; }

  .section--dark .social-proof-card__platform--twitter,
  .section--dark .social-proof-card__platform--tiktok {
    color: #f8fafc;
  }

  .social-proof-card__content {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .section--dark .social-proof-card__content {
    color: #e2e8f0;
  }

  .social-proof-card__content p {
    margin: 0;
  }

  .social-proof-card__image {
    margin-top: 0.875rem;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .social-proof-card__image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .social-proof-card__tag {
    display: inline-block;
    margin-top: 0.875rem;
    padding: 0.375rem 0.75rem;
    background: linear-gradient(135deg, rgba(80, 183, 241, 0.1) 0%, rgba(147, 51, 234, 0.1) 100%);
    border-radius: 2rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .section--dark .social-proof-card__tag {
    background: linear-gradient(135deg, rgba(80, 183, 241, 0.2) 0%, rgba(147, 51, 234, 0.2) 100%);
    color: #7dd3fc;
  }

  /* Responsive */
  @media (max-width: 1199px) {
    .social-proof-wall__columns {
      grid-template-columns: repeat(3, 1fr);
    }

    .social-proof-wall__column:nth-child(4) {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .social-proof-wall__columns {
      grid-template-columns: repeat(2, 1fr);
    }

    .social-proof-wall__column:nth-child(3) {
      display: none;
    }
  }

  @media (max-width: 599px) {
    .social-proof-wall__columns {
      grid-template-columns: 1fr;
    }

    .social-proof-wall__column:not(:first-child) {
      display: none;
    }

    .social-proof-wall__container {
      max-height: 500px;
    }

    .social-proof-wall__gradient {
      height: 60px;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .social-proof-wall__container--animated .social-proof-wall__column-inner {
      animation: none;
    }

    .social-proof-wall__stat-number--counter {
      /* Show final value immediately for reduced motion */
    }
  }
</style>

<script>
  (function() {
    'use strict';

    function animateCounter(element) {
      const target = parseInt(element.dataset.counterTarget, 10);
      const duration = parseInt(element.dataset.counterDuration, 10) || 2000;
      const prefix = element.dataset.counterPrefix || '';
      const suffix = element.dataset.counterSuffix || '';

      if (isNaN(target)) return;

      // Check for reduced motion preference
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        element.textContent = prefix + target.toLocaleString('fr-FR') + suffix;
        return;
      }

      const startTime = performance.now();
      const startValue = 0;

      function easeOutExpo(t) {
        return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
      }

      function updateCounter(currentTime) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const easedProgress = easeOutExpo(progress);
        const currentValue = Math.floor(startValue + (target - startValue) * easedProgress);

        element.textContent = prefix + currentValue.toLocaleString('fr-FR') + suffix;

        if (progress < 1) {
          requestAnimationFrame(updateCounter);
        } else {
          element.textContent = prefix + target.toLocaleString('fr-FR') + suffix;
        }
      }

      requestAnimationFrame(updateCounter);
    }

    function initCounters(container) {
      const counters = container.querySelectorAll('.social-proof-wall__stat-number--counter');

      counters.forEach(counter => {
        if (counter.dataset.counterInitialized) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              animateCounter(counter);
              counter.dataset.counterInitialized = 'true';
              observer.disconnect();
            }
          });
        }, { threshold: 0.5 });

        observer.observe(counter);
      });
    }

    // Initialize on page load
    document.querySelectorAll('.social-proof-wall').forEach(initCounters);

    // Reinitialize for Shopify theme editor
    if (Shopify.designMode) {
      document.addEventListener('shopify:section:load', (e) => {
        const section = e.target.querySelector('.social-proof-wall');
        if (section) {
          // Reset counter state for preview
          const counter = section.querySelector('.social-proof-wall__stat-number--counter');
          if (counter) {
            delete counter.dataset.counterInitialized;
            animateCounter(counter);
          }
        }
      });
    }
  })();
</script>

