{%- comment -%}
  Features / USPs Section
  Display unique selling points with icons (shipping, guarantee, support, etc.)
{%- endcomment -%}

{%- render 'section-spacing', id: section.id, margin_top: section.settings.section_margin_top, margin_bottom: section.settings.section_margin_bottom -%}

<div class="features-section section {% if section.settings.background_color == 'light' %}bg-light{% elsif section.settings.background_color == 'primary' %}bg-primary{% endif %}" style="padding-top: {{ section.settings.section_padding_top }}px; padding-bottom: {{ section.settings.section_padding_bottom }}px;">
  <div class="container">
    <div class="features-grid" data-columns="{{ section.settings.columns_desktop }}">
      {%- for block in section.blocks -%}
        <div class="feature-item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <div class="feature-item__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'shipping' -%}
                  <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor">
                    <rect x="2" y="8" width="32" height="28" rx="2" stroke-width="2.5"/>
                    <path d="M34 18h6l6 6v10h-8" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="14" cy="36" r="4" stroke-width="2.5"/>
                    <circle cx="38" cy="36" r="4" stroke-width="2.5"/>
                    <path d="M4 36h6M18 36h16" stroke-width="2.5" stroke-linecap="round"/>
                  </svg>
                {%- when 'return' -%}
                  <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor">
                    <path d="M8 20h28M8 20l6-6M8 20l6 6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M40 28H12M40 28l-6 6M40 28l-6-6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 'guarantee' -%}
                  <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor">
                    <path d="M24 4l-18 8v12c0 11 8 18 18 22 10-4 18-11 18-22V12L24 4z" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M16 24l6 6 10-12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 'support' -%}
                  <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor">
                    <circle cx="24" cy="24" r="20" stroke-width="2.5"/>
                    <path d="M18 30c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="24" cy="18" r="5" stroke-width="2.5"/>
                  </svg>
                {%- when 'secure' -%}
                  <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor">
                    <rect x="8" y="20" width="32" height="22" rx="2" stroke-width="2.5"/>
                    <path d="M14 20V14a10 10 0 0120 0v6" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="24" cy="31" r="3" stroke-width="2.5"/>
                    <path d="M24 34v4" stroke-width="2.5" stroke-linecap="round"/>
                  </svg>
                {%- when 'quality' -%}
                  <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor">
                    <path d="M24 2l7.5 15 16.5 2.5-12 11.5 3 16.5L24 40l-15 7.5 3-16.5-12-11.5L16.5 17z" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 'payment' -%}
                  <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor">
                    <rect x="4" y="10" width="40" height="28" rx="3" stroke-width="2.5"/>
                    <path d="M4 20h40" stroke-width="2.5"/>
                    <rect x="10" y="28" width="10" height="6" rx="1" stroke-width="2.5"/>
                  </svg>
                {%- when 'gift' -%}
                  <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor">
                    <rect x="6" y="16" width="36" height="8" stroke-width="2.5" stroke-linecap="round"/>
                    <rect x="6" y="24" width="36" height="18" stroke-width="2.5" stroke-linecap="round"/>
                    <path d="M24 16V42M14 16c0-3 2-8 5-8 2.5 0 2.5 2 2.5 2s0-2 2.5-2c3 0 5 5 5 8" stroke-width="2.5" stroke-linecap="round"/>
                  </svg>
              {%- endcase -%}
            </div>
          {%- endif -%}

          <div class="feature-item__content">
            {%- if block.settings.title != blank -%}
              <p class="feature-item__title">{{ block.settings.title }}</p>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="feature-item__description">{{ block.settings.description }}</p>
            {%- endif -%}

            {%- if block.settings.link_text != blank and block.settings.link_url != blank -%}
              <a href="{{ block.settings.link_url }}" class="feature-item__link">
                {{ block.settings.link_text }}
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M6 12l4-4-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
.features-section {
  /* Padding controlled via inline styles */
}

.features-section.bg-light {
  background-color: var(--color-background-light);
}

.features-section.bg-primary {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  color: white;
}

.features-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.5rem 1.5rem;
}

.feature-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0;
}

.features-section.bg-primary .feature-item__icon,
.features-section.bg-primary .feature-item__title {
  color: white;
}

.feature-item__icon {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  flex-shrink: 0;
}

.feature-item__icon svg {
  width: 24px;
  height: 24px;
}

.feature-item__content {
  display: flex;
  flex-direction: column;
}

.feature-item__title {
  font-size: 0.8125rem;
  font-weight: 600;
  margin: 0;
  color: var(--color-text);
  white-space: nowrap;
}

.feature-item__description {
  font-size: 0.6875rem;
  line-height: 1.4;
  color: var(--color-text-light);
  margin: 0;
}

.feature-item__link {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  color: var(--color-primary);
  font-weight: 600;
  font-size: 0.9375rem;
  text-decoration: none;
  transition: gap var(--transition-speed);
}

.feature-item__link:hover {
  gap: 0.625rem;
}

.feature-item__link svg {
  transition: transform var(--transition-speed);
}

.feature-item__link:hover svg {
  transform: translateX(2px);
}

/* Responsive */
@media (max-width: 768px) {
  .features-grid {
    gap: 0.25rem 1rem;
  }

  .feature-item__icon {
    width: 28px;
    height: 28px;
  }

  .feature-item__icon svg {
    width: 20px;
    height: 20px;
  }

  .feature-item__title {
    font-size: 0.75rem;
  }

  .feature-item__description {
    display: none;
  }
}
</style>

{% schema %}
{
  "name": "Caractéristiques / USPs",
  "class": "section-features",
  "settings": [
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Espacement haut (px)",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 80,
      "unit": "px",
      "info": "Espacement vertical en haut de la section"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Espacement bas (px)",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 80,
      "unit": "px",
      "info": "Espacement vertical en bas de la section"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Colonnes sur ordinateur",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Couleur de fond",
      "options": [
        {
          "value": "default",
          "label": "Par défaut (Blanc)"
        },
        {
          "value": "light",
          "label": "Gris clair"
        },
        {
          "value": "primary",
          "label": "Dégradé principal"
        }
      ],
      "default": "light"
    },
    {
      "type": "header",
      "content": "Espacement de la section"
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "label": "Marge en haut (px)",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "label": "Marge en bas (px)",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Caractéristique",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            {
              "value": "none",
              "label": "Aucune icône"
            },
            {
              "value": "shipping",
              "label": "Livraison gratuite"
            },
            {
              "value": "return",
              "label": "Retours faciles"
            },
            {
              "value": "guarantee",
              "label": "Garantie"
            },
            {
              "value": "support",
              "label": "Support 24h/24"
            },
            {
              "value": "secure",
              "label": "Paiement sécurisé"
            },
            {
              "value": "quality",
              "label": "Qualité premium"
            },
            {
              "value": "payment",
              "label": "Paiements multiples"
            },
            {
              "value": "gift",
              "label": "Emballage cadeau"
            }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Livraison gratuite"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Livraison gratuite sur toutes les commandes de plus de 50€"
        },
        {
          "type": "header",
          "content": "Lien optionnel"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Texte du lien",
          "placeholder": "En savoir plus"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "URL du lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Caractéristiques / USPs",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "shipping",
            "title": "Livraison Gratuite",
            "description": "Sur toutes les commandes de plus de 50€"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "return",
            "title": "Retours Faciles",
            "description": "30 jours pour changer d'avis"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "secure",
            "title": "Paiement Sécurisé",
            "description": "Transactions 100% sécurisées"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "support",
            "title": "Support Client",
            "description": "Assistance 7j/7 par email"
          }
        }
      ]
    }
  ]
}
{% endschema %}
