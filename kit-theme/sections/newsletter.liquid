    {
      "type": "select",
      "id": "heading_tag",
      "label": "SEO: Niveau du titre",
      "options": [
        {"value": "h1", "label": "H1"},
        {"value": "h2", "label": "H2 (Recommande)"},
        {"value": "h3", "label": "H3"},
        {"value": "h4", "label": "H4"}
