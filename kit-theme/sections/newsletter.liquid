      "default": "Inscrivez-vous pour recevoir nos offres spéciales et actualités"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder email",
      "default": "Entrez votre email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "S'inscrire"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "options": [
        {
          "value": "default",
          "label": "Par defaut"
        },
        {
          "value": "accent",
