{%- comment -%}
  Newsletter Inline Section
  Email subscription form for homepage
{%- endcomment -%}

{%- comment -%} Top Divider {%- endcomment -%}
{%- if section.settings.show_top_divider -%}
  {%- render 'section-divider',
    shape: section.settings.top_divider_shape,
    color: section.settings.top_divider_color,
    height: section.settings.top_divider_height,
    flip_horizontal: section.settings.top_divider_flip_h,
    flip_vertical: section.settings.top_divider_flip_v,
    position: 'top'
  -%}
{%- endif -%}

<div class="newsletter-section section {% if section.settings.color_scheme == 'accent' %}newsletter-section--accent{% endif %}" style="{% if section.settings.color_scheme == 'custom' and section.settings.custom_background_color != blank %}background-color: {{ section.settings.custom_background_color }};{% endif %}">
  <div class="container">
    <div class="newsletter-content">

      {%- if section.settings.show_icon -%}
        <div class="newsletter-icon">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
            <path d="M4 12h40v24c0 2.2-1.8 4-4 4H8c-2.2 0-4-1.8-4-4V12z" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M44 12L24 28 4 12" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      {%- endif -%}

      <div class="newsletter-text">
        {%- if section.settings.title != blank -%}
          {%- liquid
            assign heading_tag = section.settings.heading_tag | default: 'h2'
          -%}
          {%- if section.settings.enable_heading_style -%}
            {%- render 'heading-styles',
              text: section.settings.title,
              tag: heading_tag,
              style: section.settings.heading_style,
              color: section.settings.heading_style_color,
              align: 'center',
              size: 'xl',
              typing_texts: section.settings.typing_texts
            -%}
          {%- else -%}
            <{{ heading_tag }} class="newsletter-title">{{ section.settings.title }}</{{ heading_tag }}>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="newsletter-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <div class="newsletter-form-wrapper">
        {%- form 'customer', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <div class="newsletter-form-group">
            <input
              type="email"
              name="contact[email]"
              class="newsletter-input"
              placeholder="{{ section.settings.placeholder | default: 'Entrez votre email' }}"
              aria-label="{{ 'newsletter.email_placeholder' | t }}"
              required
            >
            <button type="submit" class="btn btn--primary newsletter-submit">
              {{ section.settings.button_label | default: "S'inscrire" }}
            </button>
          </div>

          {%- if form.posted_successfully? -%}
            <div class="newsletter-success">
              ✓ {{ section.settings.success_message | default: 'Merci de vous être inscrit !' }}
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="newsletter-error">
              {{ 'newsletter.error' | t }}
            </div>
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.show_privacy_text -%}
          <p class="newsletter-privacy">
            {{ section.settings.privacy_text | default: 'Nous respectons votre vie privée. Désabonnez-vous à tout moment.' }}
          </p>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{%- comment -%} Bottom Divider {%- endcomment -%}
{%- if section.settings.show_bottom_divider -%}
  {%- render 'section-divider',
    shape: section.settings.bottom_divider_shape,
    color: section.settings.bottom_divider_color,
    height: section.settings.bottom_divider_height,
    flip_horizontal: section.settings.bottom_divider_flip_h,
    flip_vertical: section.settings.bottom_divider_flip_v,
    position: 'bottom'
  -%}
{%- endif -%}

<style>
.newsletter-section {
  background-color: var(--color-background-light);
  padding: var(--spacing-2xl) 0;
}

.newsletter-section--accent {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  color: white;
}

.newsletter-section--accent .newsletter-title,
.newsletter-section--accent .newsletter-subtitle {
  color: white;
}

.newsletter-content {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-lg);
  align-items: center;
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}

@media (min-width: 768px) {
  .newsletter-content {
    grid-template-columns: auto 1fr 1fr;
    text-align: left;
  }
}

.newsletter-icon {
  color: var(--color-primary);
}

.newsletter-section--accent .newsletter-icon {
  color: white;
}

.newsletter-title {
  font-size: clamp(1.75rem, 3vw, 2.25rem);
  margin-bottom: 0.5rem;
}

.newsletter-subtitle {
  font-size: 1rem;
  color: var(--color-text-light);
  margin: 0;
}

.newsletter-section--accent .newsletter-subtitle {
  color: rgba(255,255,255,0.9);
}

.newsletter-form-wrapper {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.newsletter-form-group {
  display: flex;
  gap: 0.5rem;
}

.newsletter-input {
  flex: 1;
  padding: 0.875rem 1.25rem;
  border: 2px solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 1rem;
  background-color: white;
  color: var(--color-text);
}

.newsletter-section--accent .newsletter-input {
  border-color: rgba(255,255,255,0.3);
  background-color: rgba(255,255,255,0.9);
}

.newsletter-input:focus {
  outline: none;
  border-color: var(--color-primary);
}

.newsletter-submit {
  white-space: nowrap;
}

.newsletter-success {
  padding: 0.75rem 1rem;
  background-color: var(--color-success);
  color: white;
  border-radius: var(--radius-sm);
  font-weight: 600;
  text-align: center;
}

.newsletter-error {
  padding: 0.75rem 1rem;
  background-color: var(--color-error);
  color: white;
  border-radius: var(--radius-sm);
  text-align: center;
}

.newsletter-privacy {
  font-size: 0.75rem;
  color: var(--color-text-light);
  margin: 0;
  text-align: center;
}

.newsletter-section--accent .newsletter-privacy {
  color: rgba(255,255,255,0.7);
}

@media (max-width: 767px) {
  .newsletter-form-group {
    flex-direction: column;
  }

  .newsletter-submit {
    width: 100%;
  }
}
</style>

{% schema %}
{
