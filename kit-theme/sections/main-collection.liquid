.color-swatch input:checked ~ .visually-hidden {
  /* Trick to target parent when input is checked */
}

.color-swatch:has(input:checked) {
  border-color: #000;
  transform: scale(1.15);
  box-shadow: 0 0 0 2px white, 0 0 0 4px #000;
}

.color-swatch:has(input:checked)::after {
