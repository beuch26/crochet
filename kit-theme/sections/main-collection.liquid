}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Function to load collection content via AJAX
  function loadCollectionContent(url) {
    const collectionContent = document.getElementById('collection-content');
    if (collectionContent) {
      collectionContent.classList.add('is-loading');
    }

    fetch(url)
      .then(response => response.text())
      .then(html => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const newContent = doc.getElementById('collection-content');

        if (newContent && collectionContent) {
          collectionContent.innerHTML = newContent.innerHTML;
          window.history.pushState({}, '', url);
          collectionContent.classList.remove('is-loading');
          collectionContent.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          window.location.href = url;
        }
      })
      .catch(error => {
        if (collectionContent) {
          collectionContent.classList.remove('is-loading');
        }
        window.location.href = url;
      });
  }

  // Sort change (now with AJAX + tri par variations)
  const sortSelect = document.getElementById('sort-by');
  if (sortSelect) {
    sortSelect.addEventListener('change', function(e) {
      const sortValue = e.target.value;
      const url = new URL(window.location.href);

      // Check if it's a variation sort (color or size)
      if (sortValue.startsWith('color-') || sortValue.startsWith('size-')) {
        // For variation sorting, we use filters instead of sort_by
        const [type, value] = sortValue.split('-');

        // Clear previous sort_by
        url.searchParams.delete('sort_by');

        // Add filter for the variation
        if (type === 'color') {
          url.searchParams.set('filter.v.option.color', value);
        } else if (type === 'size') {
          url.searchParams.set('filter.v.option.size', value);
        }
      } else {
        // Standard sort
        url.searchParams.set('sort_by', sortValue);
        // Remove variation filters if any
        url.searchParams.delete('filter.v.option.color');
        url.searchParams.delete('filter.v.option.size');
      }

      loadCollectionContent(url.toString());
    });

    // Set current sort value from URL
    const urlParams = new URLSearchParams(window.location.search);
    const currentSort = urlParams.get('sort_by');
    const colorFilter = urlParams.get('filter.v.option.color');
    const sizeFilter = urlParams.get('filter.v.option.size');

    if (currentSort) {
      sortSelect.value = currentSort;
    } else if (colorFilter) {
      sortSelect.value = 'color-' + colorFilter;
    } else if (sizeFilter) {
      sortSelect.value = 'size-' + sizeFilter;
    }
  }

  // Collection filters - auto-apply on change
  const filtersForm = document.getElementById('collection-filters');
  const clearFiltersBtn = document.getElementById('clear-filters');
  const priceMin = document.getElementById('filter-price-min');
  const priceMax = document.getElementById('filter-price-max');
  const priceMinValue = document.getElementById('price-min-value');
  const priceMaxValue = document.getElementById('price-max-value');
  const priceInputMin = document.getElementById('price-input-min');
  const priceInputMax = document.getElementById('price-input-max');
  const priceTrackFill = document.getElementById('price-track-fill');

  if (filtersForm) {
    // Update track fill position
    function updateTrackFill() {
      if (!priceMin || !priceMax || !priceTrackFill) return;
      const min = parseInt(priceMin.min);
      const max = parseInt(priceMin.max);
      const minVal = parseInt(priceMin.value);
      const maxVal = parseInt(priceMax.value);
      const range = max - min;
      const leftPercent = ((minVal - min) / range) * 100;
      const rightPercent = 100 - ((maxVal - min) / range) * 100;
      priceTrackFill.style.left = leftPercent + '%';
      priceTrackFill.style.right = rightPercent + '%';
    }

    // Sync slider and input values
    function syncPriceFilter(source, target) {
      if (target) target.value = source.value;
      updateTrackFill();
    }

    // Initialize track fill
    updateTrackFill();

    // Price slider and input sync
    if (priceMin && priceMax) {
      // Slider to input sync
      priceMin.addEventListener('input', function() {
        const minVal = parseInt(this.value);
        const maxVal = parseInt(priceMax.value);
        if (minVal > maxVal) this.value = maxVal;
        syncPriceFilter(this, priceInputMin);
        if (priceMinValue) priceMinValue.textContent = this.value + ' €';
      });

      priceMax.addEventListener('input', function() {
        const minVal = parseInt(priceMin.value);
        const maxVal = parseInt(this.value);
        if (maxVal < minVal) this.value = minVal;
        syncPriceFilter(this, priceInputMax);
        if (priceMaxValue) priceMaxValue.textContent = this.value + ' €';
      });

      // Input to slider sync
      if (priceInputMin) {
        priceInputMin.addEventListener('input', function() {
          let val = parseInt(this.value) || 0;
          const max = parseInt(priceMax.value);
          if (val > max) val = max;
          if (val < parseInt(priceMin.min)) val = parseInt(priceMin.min);
          this.value = val;
          priceMin.value = val;
          updateTrackFill();
        });

        priceInputMin.addEventListener('change', function() {
          applyFilters();
        });
      }

      if (priceInputMax) {
        priceInputMax.addEventListener('input', function() {
          let val = parseInt(this.value) || 0;
          const min = parseInt(priceMin.value);
          if (val < min) val = min;
          if (val > parseInt(priceMax.max)) val = parseInt(priceMax.max);
          this.value = val;
          priceMax.value = val;
          updateTrackFill();
        });

        priceInputMax.addEventListener('change', function() {
          applyFilters();
        });
      }
    }

    // Function to apply filters - CLIENT-SIDE filtering
    function applyFilters() {
      const productGrid = document.querySelector('.product-grid');
      if (!productGrid) return;

      const allProducts = productGrid.querySelectorAll('.product-card');

      // Get selected filters
      const selectedColors = Array.from(filtersForm.querySelectorAll('input[name*="couleur"]:checked, input[name*="color"]:checked'))
        .map(cb => cb.value.toLowerCase());
      const selectedSizes = Array.from(filtersForm.querySelectorAll('input[name*="taille"]:checked, input[name*="size"]:checked'))
        .map(cb => cb.value.toLowerCase());

      const minPriceEuros = priceMin ? parseInt(priceMin.value) : 0;
      const maxPriceEuros = priceMax ? parseInt(priceMax.value) : 999999;

      let visibleCount = 0;

      allProducts.forEach(product => {
        let shouldShow = true;

        // Filter by price
        const priceElement = product.querySelector('.product-card__price, [class*="price"]');
        if (priceElement) {
          const priceText = priceElement.textContent.replace(/[^\d,\.]/g, '').replace(',', '.');
          const productPrice = parseFloat(priceText);

          if (productPrice < minPriceEuros || productPrice > maxPriceEuros) {
            shouldShow = false;
          }
        }

        // Filter by color (using data attributes)
        if (shouldShow && selectedColors.length > 0) {
          const productColors = product.dataset.productColors || '';
          const hasColor = selectedColors.some(color => productColors.includes(color));
          if (!hasColor) shouldShow = false;
        }

        // Filter by size (using data attributes)
        if (shouldShow && selectedSizes.length > 0) {
          const productSizes = product.dataset.productSizes || '';
          const hasSize = selectedSizes.some(size => productSizes.includes(size));
          if (!hasSize) shouldShow = false;
        }

        // Show or hide product
        if (shouldShow) {
          product.style.display = '';
          visibleCount++;
        } else {
          product.style.display = 'none';
        }
      });

      // Update product count
      const resultsBadge = document.querySelector('.results-badge strong');
      if (resultsBadge) {
        resultsBadge.textContent = visibleCount;
      }
    }

    // Auto-apply on checkbox change (colors, sizes, categories)
    const checkboxes = filtersForm.querySelectorAll('input[type="checkbox"]');

    checkboxes.forEach(checkbox => {
      checkbox.addEventListener('change', applyFilters);
    });

    // Auto-apply on price slider change (with debounce)
    let priceDebounce;
    if (priceMin) {
      priceMin.addEventListener('change', function() {
        clearTimeout(priceDebounce);
        priceDebounce = setTimeout(() => {
          applyFilters();
        }, 500);
      });
    }
    if (priceMax) {
      priceMax.addEventListener('change', function() {
        clearTimeout(priceDebounce);
        priceDebounce = setTimeout(() => {
          applyFilters();
        }, 500);
      });
    }

    // Clear filters button - reset all filters
    if (clearFiltersBtn) {
      clearFiltersBtn.addEventListener('click', function() {
        // Uncheck all checkboxes
        checkboxes.forEach(cb => cb.checked = false);

        // Reset price sliders to their min/max values
        if (priceMin && priceMax) {
          priceMin.value = priceMin.getAttribute('data-min') || priceMin.min;
          priceMax.value = priceMax.getAttribute('data-max') || priceMax.max;

          // Trigger input events to update displayed values
          priceMin.dispatchEvent(new Event('input'));
          priceMax.dispatchEvent(new Event('input'));
        }

        // Re-apply filters (will show all products)
        applyFilters();
      });
    }

    // Show clear button if any filter is active
    function checkActiveFilters() {
      const hasActiveFilters = filtersForm.querySelectorAll('input[type="checkbox"]:checked').length > 0 ||
                               (priceMin && priceMin.value != priceMin.min) ||
                               (priceMax && priceMax.value != priceMax.max);
      if (clearFiltersBtn) {
        if (hasActiveFilters) {
          clearFiltersBtn.classList.add('has-filters');
        } else {
          clearFiltersBtn.classList.remove('has-filters');
        }
      }
    }

    // Check on page load and after each filter change
    checkActiveFilters();

    // Re-check after each checkbox change
    checkboxes.forEach(checkbox => {
      checkbox.addEventListener('change', checkActiveFilters);
    });

    // Re-check after price changes
    if (priceMin) {
      priceMin.addEventListener('change', checkActiveFilters);
    }
    if (priceMax) {
      priceMax.addEventListener('change', checkActiveFilters);
    }
  }
});
</script>

