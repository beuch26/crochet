          "default": "Voir les nouveautés"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Lien"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icône (emoji)",
          "info": "Icône emoji optionnel"
