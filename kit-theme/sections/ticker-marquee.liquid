        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau Défilant",
      "blocks": [
        { "type": "text", "settings": { "text": "Livraison gratuite dès 50€ d'achat", "icon": "🚚" } },
        { "type": "text", "settings": { "text": "Retours sous 30 jours", "icon": "↩️" } },
