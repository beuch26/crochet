        { "value": "curve", "label": "Courbe" },
        { "value": "curve-asymmetric", "label": "Courbe asymétrique" },
        { "value": "diagonal", "label": "Diagonale" },
        { "value": "diagonal-reverse", "label": "Diagonale inversée" },
        { "value": "triangle", "label": "Triangle" },
        { "value": "arrow", "label": "Flèche" },
        { "value": "zigzag", "label": "Zigzag" },
        { "value": "clouds", "label": "Nuages" }
      ],
      "default": "wave-1"
    },
    {
      "type": "color",
      "id": "bottom_divider_color",
      "label": "Couleur du séparateur",
      "default": "#f3f4f6"
    },
    {
      "type": "range",
      "id": "bottom_divider_height",
      "label": "Hauteur",
      "min": 50,
      "max": 200,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "bottom_divider_flip_h",
      "label": "Retourner horizontalement",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_divider_flip_v",
      "label": "Retourner verticalement",
      "default": false
    },
    {
      "type": "header",
      "content": "Espacement de la section"
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "label": "Marge en haut (px)",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "label": "Marge en bas (px)",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Comparateur Avant/Après"
    }
  ]
}
{% endschema %}
