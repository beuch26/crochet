{%- comment -%}
  FAQ Produit - Section dynamique basée sur les métaobjets
  Affiche les FAQ définies dans le metafield custom.faq du produit
  À utiliser uniquement sur les templates produit
{%- endcomment -%}

{%- assign faq_items = product.metafields.custom.faq.value -%}
{%- assign has_faq = false -%}
{%- if faq_items != blank and faq_items.size > 0 -%}
  {%- assign has_faq = true -%}
{%- endif -%}

{%- comment -%} Afficher en mode éditeur OU si FAQ présentes {%- endcomment -%}
{%- if has_faq or request.design_mode -%}
<div class="faq-product section" id="faq-product-{{ section.id }}">
  <div class="container">

    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      {%- liquid
        assign heading_tag = section.settings.heading_tag | default: 'h2'
      -%}
      <header class="section-header text-center">
        {%- if section.settings.subtitle != blank -%}
          <p class="section-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          {%- if section.settings.enable_heading_style -%}
            {%- render 'heading-styles',
              text: section.settings.title,
              tag: heading_tag,
              style: section.settings.heading_style,
              color: section.settings.heading_style_color,
              align: 'center',
              size: 'xl',
              typing_texts: section.settings.typing_texts
            -%}
          {%- else -%}
            <{{ heading_tag }} class="section-title">{{ section.settings.title }}</{{ heading_tag }}>
          {%- endif -%}
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if has_faq -%}
      <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
        {%- for item in faq_items -%}
          <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <button
              type="button"
              class="faq-item__question"
              data-faq-product-toggle
              aria-expanded="false"
              aria-controls="faq-product-{{ section.id }}-{{ forloop.index }}"
            >
              <span itemprop="name">{{ item.question.value }}</span>
              <span class="faq-item__icon">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                  <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>

            <div
              class="faq-item__answer"
              id="faq-product-{{ section.id }}-{{ forloop.index }}"
              itemscope itemprop="acceptedAnswer"
              itemtype="https://schema.org/Answer"
              style="display:none;"
            >
              <div class="faq-item__answer-content rte" itemprop="text">
                {{ item.reponse | metafield_tag }}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- if request.design_mode -%}
        <p class="text-center" style="color: var(--color-text-light); padding: 2rem;">
          Aucune FAQ configurée pour ce produit.<br>
          <small>Ajoutez des FAQ via le metafield <code>custom.faq</code> du produit.</small>
        </p>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>
{%- endif -%}

<style>
.faq-product {
  padding: clamp(3rem, 8vw, 5rem) 0;
  background: linear-gradient(180deg, var(--color-background) 0%, var(--color-background-light) 100%);
}

.faq-product .faq-list {
  max-width: 800px;
  margin: 0 auto;
}

.faq-product .faq-item {
  margin-bottom: 1rem;
  background-color: var(--color-background);
  border: 2px solid var(--color-border);
  border-radius: 1rem;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.faq-product .faq-item:hover {
  border-color: var(--color-primary);
  box-shadow: 0 4px 20px rgba(80, 183, 241, 0.1);
}

.faq-product .faq-item.active {
  border-color: var(--color-primary);
  box-shadow: 0 8px 32px rgba(80, 183, 241, 0.15);
}

.faq-product .faq-item__question {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.5rem;
  padding: 1.5rem;
  background: none;
  border: none;
  text-align: left;
  font-size: clamp(1rem, 2.5vw, 1.125rem);
  font-weight: 600;
  color: var(--color-text);
  cursor: pointer;
  transition: all 0.3s ease;
}

.faq-product .faq-item__question:hover {
  color: var(--color-primary);
}

.faq-product .faq-item__question:focus {
  outline: none;
}

.faq-product .faq-item__question:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: -2px;
}

.faq-product .faq-item__icon {
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary), #38BDF8);
  border-radius: 50%;
  color: white;
  transition: transform 0.3s ease;
}

.faq-product .faq-item__icon svg {
  width: 16px;
  height: 16px;
}

.faq-product .faq-item.active .faq-item__icon {
  transform: rotate(180deg);
}

.faq-product .faq-item__answer {
  overflow: hidden;
  transition: all 0.3s ease;
}

.faq-product .faq-item__answer-content {
  padding: 0 1.5rem 1.5rem 1.5rem;
  color: var(--color-text-light);
  line-height: 1.7;
  font-size: 0.9375rem;
  border-top: 1px dashed var(--color-border);
  margin: 0 1.5rem;
  padding-top: 1.25rem;
}

.faq-product .faq-item__answer-content p {
  margin: 0 0 1rem 0;
}

.faq-product .faq-item__answer-content p:last-child {
  margin-bottom: 0;
}

.faq-product .faq-item__answer-content ul,
.faq-product .faq-item__answer-content ol {
  margin: 1rem 0;
  padding-left: 1.5rem;
}

.faq-product .faq-item__answer-content li {
  margin-bottom: 0.5rem;
}

.faq-product .faq-item__answer-content a {
  color: var(--color-primary);
  text-decoration: none;
  font-weight: 500;
}

.faq-product .faq-item__answer-content a:hover {
  text-decoration: underline;
}

@media (prefers-reduced-motion: reduce) {
  .faq-product .faq-item,
  .faq-product .faq-item__question,
  .faq-product .faq-item__icon {
    transition: none;
  }
}
</style>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var openFirstItem = {{ section.settings.open_first | json }};

  function initFAQProduct() {
    var faqSection = document.getElementById('faq-product-' + sectionId);
    if (!faqSection) return;

    if (faqSection.dataset.initialized) return;
    faqSection.dataset.initialized = 'true';

    faqSection.addEventListener('click', function(e) {
      var button = e.target.closest('[data-faq-product-toggle]');
      if (!button) return;

      var faqItem = button.closest('.faq-item');
      var answerId = button.getAttribute('aria-controls');
      var answer = document.getElementById(answerId);
      if (!answer) return;

      var isExpanded = button.getAttribute('aria-expanded') === 'true';

      if (isExpanded) {
        button.setAttribute('aria-expanded', 'false');
        faqItem.classList.remove('active');
        answer.style.display = 'none';
      } else {
        button.setAttribute('aria-expanded', 'true');
        faqItem.classList.add('active');
        answer.style.display = 'block';
      }
    });

    if (openFirstItem) {
      var firstButton = faqSection.querySelector('[data-faq-product-toggle]');
      if (firstButton) {
        firstButton.click();
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFAQProduct);
  } else {
    initFAQProduct();
  }

  if (typeof Shopify !== 'undefined' && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.querySelector('#faq-product-' + sectionId)) {
        var section = e.target.querySelector('#faq-product-' + sectionId);
        if (section) section.dataset.initialized = '';
        initFAQProduct();
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "FAQ Produit",
  "class": "section-faq-product",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "Cette section affiche automatiquement les FAQ définies dans le metafield 'custom.faq' du produit. Si le produit n'a pas de FAQ, la section ne s'affiche pas."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Besoin d'aide ?"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Questions fréquentes"
    },
    {
      "type": "header",
      "content": "Style du titre"
    },
    {
      "type": "checkbox",
      "id": "enable_heading_style",
      "label": "Activer le style du titre",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Style",
      "options": [
        { "value": "signature-1", "label": "Signature 1 (manuscrit)" },
        { "value": "signature-2", "label": "Signature 2 (swoosh)" },
        { "value": "signature-3", "label": "Signature 3 (double)" },
        { "value": "signature-4", "label": "Signature 4 (gribouillis)" },
        { "value": "signature-5", "label": "Signature 5 (courbe)" },
        { "value": "underline-1", "label": "Soulignement 1 (pinceau)" },
        { "value": "underline-2", "label": "Soulignement 2 (ligne)" },
        { "value": "underline-3", "label": "Soulignement 3 (surligneur)" },
        { "value": "highlight", "label": "Surligné" },
        { "value": "reflection", "label": "Reflet brillant" },
        { "value": "typing", "label": "Animation frappe" }
      ],
      "default": "signature-1"
    },
    {
      "type": "color",
      "id": "heading_style_color",
      "label": "Couleur de l'effet",
      "default": "#dc2626"
    },
    {
      "type": "text",
      "id": "typing_texts",
      "label": "Textes pour animation frappe",
      "info": "Séparés par des virgules"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "SEO: Niveau de titre",
      "options": [
        {"value": "h2", "label": "H2 (Recommandé)"},
        {"value": "h3", "label": "H3"},
        {"value": "h4", "label": "H4"}
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Ouvrir la première question par défaut",
      "default": true
    }
  ],
  "templates": ["product"],
  "presets": [
    {
      "name": "FAQ Produit"
    }
  ]
}
{% endschema %}
