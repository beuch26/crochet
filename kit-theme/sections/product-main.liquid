<script>
(function() {
  const productForm = document.querySelector('[data-product-form]');
  if (!productForm) return;

  const variantIdInput = productForm.querySelector('[data-variant-id]');
  const optionSelects = productForm.querySelectorAll('[data-option-select]');
  const optionButtons = productForm.querySelectorAll('[data-option-button]');
  const priceElement = productForm.querySelector('[data-price]');
  const skuElement = document.querySelector('[data-sku]');
  const addToCartButton = productForm.querySelector('[data-add-to-cart]');
  const addToCartText = productForm.querySelector('[data-add-to-cart-text]');
  const stockStatus = document.querySelector('[data-stock-status]');

  const quantityInput = productForm.querySelector('[data-quantity-input]');
  const quantityMinus = productForm.querySelector('[data-quantity-minus]');
  const quantityPlus = productForm.querySelector('[data-quantity-plus]');

  // Product data from Shopify
  const productData = {{ product | json }};
  let selectedOptions = {};

  // Initialize selected options
  if (productData.options_with_values && productData.options_with_values.length > 0) {
    productData.options_with_values.forEach((option, index) => {
      selectedOptions[option.position] = option.selected_value || option.values[0];
    });
  }

  // Option select change
  optionSelects.forEach(select => {
    select.addEventListener('change', (e) => {
      const position = parseInt(e.target.dataset.optionPosition);
      selectedOptions[position] = e.target.value;
      updateVariant();
    });
  });

  // Option button click
  optionButtons.forEach(button => {
    button.addEventListener('click', (e) => {
      const position = parseInt(e.currentTarget.dataset.optionPosition);
      const value = e.currentTarget.dataset.optionValue;

      // Update active state
      const siblings = e.currentTarget.parentElement.querySelectorAll('[data-option-button]');
      siblings.forEach(btn => btn.classList.remove('active'));
      e.currentTarget.classList.add('active');

      // Update option value display
      const optionValueDisplay = e.currentTarget.closest('.product-option').querySelector('[data-option-value]');
      if (optionValueDisplay) {
        optionValueDisplay.textContent = value;
      }

      selectedOptions[position] = value;
      updateVariant();
    });
  });

  function updateVariant() {
    // Find matching variant
    const variant = productData.variants.find(v => {
      return v.options.every((option, index) => {
        return option === selectedOptions[index + 1];
      });
    });

    if (variant) {
      // Update hidden input
      variantIdInput.value = variant.id;

      // Update price
      if (priceElement) {
        priceElement.textContent = formatMoney(variant.price);
      }

      // Update SKU
      if (skuElement && variant.sku) {
        skuElement.textContent = variant.sku;
      }

      // Update add to cart button
      if (addToCartButton && addToCartText) {
        if (variant.available) {
          addToCartButton.disabled = false;
          addToCartText.textContent = {{ 'products.product.add_to_cart' | t | json }};
        } else {
          addToCartButton.disabled = true;
          addToCartText.textContent = {{ 'products.product.sold_out' | t | json }};
        }
      }

      // Dispatch event for gallery update
      window.dispatchEvent(new CustomEvent('variantChange', {
        detail: { variant: variant }
      }));
    }
  }

  // Quantity controls
  if (quantityMinus) {
    quantityMinus.addEventListener('click', () => {
      const currentValue = parseInt(quantityInput.value) || 1;
      if (currentValue > 1) {
        quantityInput.value = currentValue - 1;
      }
    });
  }

  if (quantityPlus) {
    quantityPlus.addEventListener('click', () => {
      const currentValue = parseInt(quantityInput.value) || 1;
      quantityInput.value = currentValue + 1;
    });
  }

  // Format money (simple version)
  function formatMoney(cents) {
    const amount = (cents / 100).toFixed(2);
    return '{{ cart.currency.symbol }}' + amount;
  }

  // Buy Now functionality
  const buyNowButton = document.querySelector('[data-buy-now]');
  if (buyNowButton) {
    buyNowButton.addEventListener('click', async (e) => {
      e.preventDefault();

      const button = e.currentTarget;
      const originalText = button.innerHTML;

      // Disable button and show loading state
      button.disabled = true;
      button.innerHTML = '<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" style="display: inline-block; vertical-align: middle; margin-right: 0.5rem; animation: spin 1s linear infinite;" aria-hidden="true"><circle cx="10" cy="10" r="8" stroke-width="2" opacity="0.25"/><path d="M10 2a8 8 0 018 8" stroke-width="2" stroke-linecap="round"/></svg>{{ 'products.product.processing' | t | default: 'Traitement...' }}';

      try {
        // Get variant ID and quantity
        const variantId = variantIdInput.value;
        const quantity = quantityInput ? parseInt(quantityInput.value) : 1;

        // Add to cart
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            items: [{
              id: variantId,
              quantity: quantity
            }]
          })
        });

        if (!response.ok) {
          throw new Error('Failed to add to cart');
        }

        // Redirect to checkout
        window.location.href = '/checkout';

      } catch (error) {
        console.error('Buy Now error:', error);
        alert({{ 'products.product.buy_now_error' | t | default: "Une erreur s'est produite. Veuillez réessayer." | json }});

        // Restore button
        button.disabled = false;
        button.innerHTML = originalText;
      }
    });
  }
})();

// Buy With Inline - Cross-sell
(function() {
  var container = document.querySelector('[data-buy-with-inline]');
  if (!container) return;

  var checkboxes = container.querySelectorAll('[data-buy-with-item]');
  var addBtn = container.querySelector('[data-buy-with-add]');
  var totalEl = container.querySelector('[data-buy-with-total]');
  var textEl = container.querySelector('[data-buy-with-text]');

  function formatMoney(cents) {
    return (cents / 100).toFixed(2).replace('.', ',') + ' €';
  }

  function updateTotal() {
    var total = 0;
    var count = 0;
    checkboxes.forEach(function(cb) {
      if (cb.checked) {
        total += parseInt(cb.dataset.price, 10);
        count++;
      }
    });
    if (totalEl) {
      totalEl.textContent = count > 0 ? formatMoney(total) : '';
      totalEl.style.display = count > 0 ? '' : 'none';
    }
    if (addBtn) addBtn.disabled = count === 0;
  }

  checkboxes.forEach(function(cb) {
    cb.addEventListener('change', updateTotal);
  });

  updateTotal();

  if (addBtn) {
    addBtn.addEventListener('click', function() {
      var items = [];
      checkboxes.forEach(function(cb) {
        if (cb.checked) {
          items.push({ id: parseInt(cb.dataset.variantId, 10), quantity: 1 });
        }
      });
      if (items.length === 0) return;

      addBtn.classList.add('loading');
      addBtn.disabled = true;

      fetch((window.Shopify && window.Shopify.routes && window.Shopify.routes.root || '/') + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: items })
      })
      .then(function(r) {
        if (!r.ok) throw new Error('Cart add failed');
        return fetch((window.Shopify && window.Shopify.routes && window.Shopify.routes.root || '/') + 'cart.js');
      })
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cart } }));
        if (typeof Cart !== 'undefined' && Cart.openDrawer) {
          Cart.openDrawer();
          Cart.refreshDrawer();
        }
      })
      .catch(function(err) {
        console.error('Buy-with error:', err);
      })
      .finally(function() {
        addBtn.classList.remove('loading');
        addBtn.disabled = false;
      });
    });
  }
})();

// Sticky Buy Box (Desktop only)
(function() {
  // Only run on desktop
  if (window.innerWidth < 1024) return;

  const buyBox = document.querySelector('.product-main__info');
  if (!buyBox) return;

  const productTabs = document.querySelector('.product-tabs');
  const buyBoxTop = buyBox.getBoundingClientRect().top + window.pageYOffset;

  function handleSticky() {
    const scrollY = window.pageYOffset;
    const buyBoxHeight = buyBox.offsetHeight;
    const viewportHeight = window.innerHeight;

    // Check if tabs exist and get their position
    let stopPosition = document.body.scrollHeight; // Default: end of page
    if (productTabs) {
      const tabsTop = productTabs.getBoundingClientRect().top + window.pageYOffset;
      stopPosition = tabsTop - buyBoxHeight - 40; // Stop 40px before tabs
    }

    // Add sticky class when scrolled
    if (scrollY > buyBoxTop - 20) {
      buyBox.classList.add('is-sticky');
    } else {
      buyBox.classList.remove('is-sticky');
    }

    // Stop sticky before tabs (if exists)
    if (scrollY > stopPosition) {
      buyBox.style.position = 'absolute';
      buyBox.style.top = (stopPosition - buyBoxTop + 20) + 'px';
    } else {
      buyBox.style.position = 'sticky';
      buyBox.style.top = '20px';
    }
  }

  // Listen to scroll
  let ticking = false;
  window.addEventListener('scroll', function() {
    if (!ticking) {
      window.requestAnimationFrame(function() {
        handleSticky();
        ticking = false;
      });
      ticking = true;
    }
  });

  // Initial check
  handleSticky();

  // Re-check on window resize
  let resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() {
      if (window.innerWidth >= 1024) {
        handleSticky();
      } else {
        // Reset on mobile
        buyBox.classList.remove('is-sticky');
        buyBox.style.position = '';
        buyBox.style.top = '';
      }
    }, 250);
  });
})();
</script>

<script>
// Sticky Add to Cart Button with Visibility Detection
(function() {
  if (window.innerWidth >= 1024) return; // Only for mobile/tablet

  const stickyAtc = document.querySelector('[data-sticky-atc]');
  const stickyButton = document.querySelector('[data-sticky-atc-button]');
  const mainAddToCart = document.querySelector('[data-add-to-cart]');
  const productForm = document.querySelector('[data-product-form]');

  if (!stickyAtc || !stickyButton || !mainAddToCart) return;

  // Intersection Observer to detect main button visibility
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        // Main button is visible, hide sticky button
        stickyAtc.classList.remove('is-visible');
        document.body.classList.remove('has-sticky-atc');
      } else {
        // Main button is not visible, show sticky button
        stickyAtc.classList.add('is-visible');
        document.body.classList.add('has-sticky-atc');
      }
    });
  }, {
    threshold: 0.1,
    rootMargin: '0px 0px -100px 0px' // Trigger a bit earlier
  });

  observer.observe(mainAddToCart);

  // Handle sticky button click
  stickyButton.addEventListener('click', function() {
    if (productForm) {
      // Trigger the main add to cart button
      mainAddToCart.click();

      // Optionally scroll to the top to show feedback
      setTimeout(() => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      }, 300);
    }
  });

  // Update sticky button state when variant changes
  if (productForm) {
    const variantIdInput = productForm.querySelector('[data-variant-id]');
    if (variantIdInput) {
      const updateStickyButton = () => {
        const currentVariant = window.productVariants?.find(v => v.id == variantIdInput.value);
        if (currentVariant) {
          const stickyButtonText = stickyButton.querySelector('[data-sticky-atc-text]');
          const stickyPrice = document.querySelector('[data-sticky-price]');

          // Update button text
          if (stickyButtonText) {
            stickyButtonText.textContent = currentVariant.available ? 'Ajouter' : 'Épuisé';
          }

          // Update button disabled state
          stickyButton.disabled = !currentVariant.available;

          // Update price
          if (stickyPrice) {
            let priceHTML = '';
            if (currentVariant.compare_at_price && currentVariant.compare_at_price > currentVariant.price) {
              priceHTML += `<span class="price-compare">${formatMoney(currentVariant.compare_at_price)}</span>`;
            }
            priceHTML += `<span class="price-current">${formatMoney(currentVariant.price)}</span>`;
            stickyPrice.innerHTML = priceHTML;
          }
        }
      };

      // Helper function to format money (basic version)
      function formatMoney(cents) {
        return (cents / 100).toFixed(2).replace('.', ',') + ' €';
      }

      // Listen for variant changes
      productForm.addEventListener('change', updateStickyButton);
    }
  }
})();
</script>

