{%- comment -%}
  Related Blog Articles Section
  Displays blog articles related to the current product
{%- endcomment -%}

<div class="product-blog-articles section">
  <div class="container">
    <header class="section-header text-center">
      {%- if section.settings.enable_heading_style -%}
        {%- render 'heading-styles',
          text: section.settings.heading,
          tag: 'h2',
          style: section.settings.heading_style,
          color: section.settings.heading_style_color,
          align: 'center',
          size: 'xl',
          typing_texts: section.settings.typing_texts
        -%}
      {%- else -%}
        <h2 class="section-title">
          {{ section.settings.heading | default: 'Articles Liés' }}
        </h2>
      {%- endif -%}
      <div class="section-title-underline"></div>
    </header>

    {%- assign blog_handle = section.settings.blog | default: 'news' -%}
    {%- assign blog = blogs[blog_handle] -%}

    {%- if blog and blog.articles_count > 0 -%}
      <div class="blog-articles-grid" data-columns="{{ section.settings.columns_desktop }}">
        {%- for article in blog.articles limit: section.settings.articles_to_show -%}
          <article class="blog-article-card">
            <a href="{{ article.url }}" class="blog-article-card__link">
              {%- if article.image -%}
                <div class="blog-article-card__image">
                  <img
                    src="{{ article.image | image_url: width: 600 }}"
                    alt="{{ article.image.alt | default: article.title }}"
                    width="600"
                    height="auto"
                    loading="lazy"
                  >
                  {%- if article.tags.size > 0 -%}
                    <div class="blog-article-card__tag">
                      {{ article.tags.first }}
                    </div>
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="blog-article-card__image blog-article-card__image--placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                  {%- if article.tags.size > 0 -%}
                    <div class="blog-article-card__tag">
                      {{ article.tags.first }}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="blog-article-card__content">
                <h3 class="blog-article-card__title">{{ article.title }}</h3>

                {%- if section.settings.show_excerpt -%}
                  <p class="blog-article-card__excerpt">
                    {{ article.excerpt_or_content | strip_html | truncatewords: 20 }}
                  </p>
                {%- endif -%}

                <div class="blog-article-card__meta">
                  <span class="blog-article-card__author">
                    {{ 'blog.general.by' | t }} {{ article.author }}
                  </span>
                  <span class="blog-article-card__date">
                    {{ article.published_at | date: '%d %B %Y' }}
                  </span>
                </div>

                <div class="blog-article-card__read-more">
                  {{ 'blog.general.read_more' | t }}
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M6 12l4-4-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </div>
              </div>
            </a>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all -%}
        <div class="blog-articles-footer">
          <a href="{{ blog.url }}" class="btn btn--secondary">
            {{ section.settings.view_all_text | default: 'Voir Tous les Articles' }}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="blog-articles-empty">
        <p>{{ 'blog.general.no_articles' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
.product-blog-articles {
  padding: var(--spacing-xl) 0;
  background-color: var(--color-background-light);
}

.section-header {
  text-align: center;
}

.section-title {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--spacing-md);
}

.section-title-underline {
  width: 60px;
  height: 4px;
  background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
  border-radius: 2px;
  margin: 0 auto;
}

.blog-articles-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: var(--spacing-xl);
}

.blog-articles-grid[data-columns="2"] {
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
}

.blog-articles-grid[data-columns="3"] {
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
}

.blog-article-card {
  background: white;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  transition: all var(--transition-speed);
}

.blog-article-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}

.blog-article-card__link {
  display: block;
  text-decoration: none;
  color: inherit;
}

.blog-article-card__image {
  position: relative;
  aspect-ratio: 16/9;
  overflow: hidden;
  background-color: var(--color-background-light);
}

.blog-article-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-speed);
}

.blog-article-card:hover .blog-article-card__image img {
  transform: scale(1.05);
}

.blog-article-card__image--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.blog-article-card__image--placeholder svg {
  width: 60%;
  height: 60%;
  opacity: 0.3;
}

.blog-article-card__tag {
  position: absolute;
  top: var(--spacing-sm);
  left: var(--spacing-sm);
  background: var(--color-primary);
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: var(--radius-sm);
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.blog-article-card__content {
  padding: var(--spacing-lg);
}

.blog-article-card__title {
  font-size: 1.25rem;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: var(--spacing-sm);
  color: var(--color-text);
}

.blog-article-card__excerpt {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--color-text-light);
  margin-bottom: var(--spacing-md);
}

.blog-article-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  font-size: 0.8125rem;
  color: var(--color-text-light);
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-md);
  border-bottom: 1px solid var(--color-border);
}

.blog-article-card__author,
.blog-article-card__date {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.blog-article-card__read-more {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  color: var(--color-primary);
  font-weight: 600;
  font-size: 0.9375rem;
  transition: gap var(--transition-speed);
}

.blog-article-card:hover .blog-article-card__read-more {
  gap: 0.625rem;
}

.blog-article-card__read-more svg {
  transition: transform var(--transition-speed);
}

.blog-article-card:hover .blog-article-card__read-more svg {
  transform: translateX(2px);
}

.blog-articles-footer {
  text-align: center;
  margin-top: var(--spacing-xl);
}

.blog-articles-empty {
  text-align: center;
  padding: var(--spacing-2xl);
  color: var(--color-text-light);
}

@media (max-width: 768px) {
  .blog-articles-grid {
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }

  .blog-article-card__content {
    padding: var(--spacing-md);
  }

  .blog-article-card__title {
    font-size: 1.125rem;
  }
}
</style>

{% schema %}
{
  "name": "Produit - Articles blog",
  "class": "section-product-blog-articles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Articles Liés"
    },
    {
      "type": "header",
      "content": "Style du titre"
    },
    {
      "type": "checkbox",
      "id": "enable_heading_style",
      "label": "Activer le style du titre",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Style",
      "options": [
        { "value": "signature-1", "label": "Signature 1 (manuscrit)" },
        { "value": "signature-2", "label": "Signature 2 (swoosh)" },
        { "value": "signature-3", "label": "Signature 3 (double)" },
        { "value": "signature-4", "label": "Signature 4 (gribouillis)" },
        { "value": "signature-5", "label": "Signature 5 (courbe)" },
        { "value": "underline-1", "label": "Soulignement 1 (pinceau)" },
        { "value": "underline-2", "label": "Soulignement 2 (ligne)" },
        { "value": "underline-3", "label": "Soulignement 3 (surligneur)" },
        { "value": "highlight", "label": "Surligné" },
        { "value": "reflection", "label": "Reflet brillant" },
        { "value": "typing", "label": "Animation frappe" }
      ],
      "default": "signature-1"
    },
    {
      "type": "color",
      "id": "heading_style_color",
      "label": "Couleur de l'effet",
      "default": "#dc2626"
    },
    {
      "type": "text",
      "id": "typing_texts",
      "label": "Textes pour animation frappe",
      "info": "Séparés par des virgules"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Sélectionner le blog à afficher"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Nombre d'articles à afficher",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Colonnes sur bureau",
      "options": [
        {
          "value": "2",
          "label": "2 colonnes"
        },
        {
          "value": "3",
          "label": "3 colonnes"
        }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Afficher l'extrait de l'article",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Afficher le bouton 'Voir tout'",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Texte du bouton 'Voir tout'",
      "default": "Voir Tous les Articles"
    }
  ],
  "presets": [
    {
      "name": "Produit - Articles blog"
    }
  ]
}
{% endschema %}
