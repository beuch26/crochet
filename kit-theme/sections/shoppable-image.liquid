  font-weight: 600;
  margin-bottom: var(--spacing-sm);
}

.si__products-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
  scrollbar-color: var(--color-border) transparent;
  padding-bottom: var(--spacing-xs);
}

.si__products-scroll::-webkit-scrollbar {
  height: 4px;
}

.si__products-scroll::-webkit-scrollbar-track {
  background: transparent;
}

.si__products-scroll::-webkit-scrollbar-thumb {
  background: var(--color-border);
  border-radius: 2px;
}

.si__products-grid {
  display: flex;
  gap: var(--spacing-sm);
}

.si__product-card {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  flex: 0 0 auto;
  padding: var(--spacing-xs);
  background: var(--color-background-light);
  border-radius: var(--radius-md);
  text-decoration: none;
  transition: background 0.2s, transform 0.2s;
  min-width: 180px;
}

.si__product-card:hover {
  background: var(--color-border);
  transform: translateY(-2px);
}

.si__product-image {
  position: relative;
  width: 60px;
  height: 60px;
  border-radius: var(--radius-sm);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-background);
}

.si__product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.si__product-number {
  position: absolute;
  top: 4px;
  left: 4px;
  width: 18px;
  height: 18px;
  background: var(--color-primary);
  color: white;
  font-size: 0.625rem;
  font-weight: 700;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
}

.si__product-info {
  flex: 1;
  min-width: 0;
}

.si__product-title {
  display: block;
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 120px;
}

.si__product-price {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-text);
}

.si__product-price--compare {
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--color-text-light);
  text-decoration: line-through;
}

