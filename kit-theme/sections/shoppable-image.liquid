<script>
(function() {
  'use strict';

  /**
   * Shoppable Image Component
   * Handles hotspot interactions, popups, and add-to-cart functionality
   */
  function ShoppableImage(container) {
    if (!container) return;

    this.container = container;
    this.interactionMode = container.dataset.interaction || 'click';
    this.hotspots = container.querySelectorAll('[data-hotspot]');
    this.overlay = container.querySelector('[data-si-overlay]');
    this.activeHotspot = null;
    this.hoverTimeout = null;

    this.init();
  }

  ShoppableImage.prototype = {
    init: function() {
      this.bindEvents();
      this.setupIntersectionObserver();
    },

    bindEvents: function() {
      var self = this;

      this.hotspots.forEach(function(hotspot) {
        var trigger = hotspot.querySelector('[data-hotspot-trigger]');
        var closeBtn = hotspot.querySelector('[data-hotspot-close]');
        var atcBtn = hotspot.querySelector('[data-hotspot-atc]');
        var variantSelect = hotspot.querySelector('[data-variant-select]');

        if (!trigger) return;

        // Click interaction
        trigger.addEventListener('click', function(e) {
          e.stopPropagation();
          self.toggleHotspot(hotspot, trigger);
        });

        // Hover interaction
        if (self.interactionMode === 'hover' || self.interactionMode === 'both') {
          hotspot.addEventListener('mouseenter', function() {
            clearTimeout(self.hoverTimeout);
            self.openHotspot(hotspot, trigger);
          });

          hotspot.addEventListener('mouseleave', function() {
            self.hoverTimeout = setTimeout(function() {
              if (self.interactionMode === 'hover') {
                self.closeHotspot(hotspot, trigger);
              }
            }, 300);
          });
        }

        // Close button
        if (closeBtn) {
          closeBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            self.closeHotspot(hotspot, trigger);
          });
        }

        // Add to cart
        if (atcBtn) {
          atcBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            self.addToCart(atcBtn);
          });
        }

        // Variant select
        if (variantSelect) {
          variantSelect.addEventListener('change', function() {
            var selectedOption = this.options[this.selectedIndex];
            if (atcBtn) {
              atcBtn.dataset.variantId = selectedOption.value;
              atcBtn.disabled = selectedOption.dataset.available === 'false';
            }
          });
        }

        // Keyboard navigation
        trigger.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            self.toggleHotspot(hotspot, trigger);
          }
        });
      });

      // Close on outside click
      document.addEventListener('click', function(e) {
        if (!self.container.contains(e.target) && self.activeHotspot) {
          var trigger = self.activeHotspot.querySelector('[data-hotspot-trigger]');
          self.closeHotspot(self.activeHotspot, trigger);
        }
      });

      // Close on Escape
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && self.activeHotspot) {
          var trigger = self.activeHotspot.querySelector('[data-hotspot-trigger]');
          self.closeHotspot(self.activeHotspot, trigger);
          trigger.focus();
        }
      });
    },

    toggleHotspot: function(hotspot, trigger) {
      var isOpen = trigger.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        this.closeHotspot(hotspot, trigger);
      } else {
        this.openHotspot(hotspot, trigger);
      }
    },

    openHotspot: function(hotspot, trigger) {
      var self = this;

      // Close any open hotspot first
      if (this.activeHotspot && this.activeHotspot !== hotspot) {
        var activeTrigger = this.activeHotspot.querySelector('[data-hotspot-trigger]');
        this.closeHotspot(this.activeHotspot, activeTrigger);
      }

      trigger.setAttribute('aria-expanded', 'true');
      this.activeHotspot = hotspot;

      // Add overlay active class
      var imageContainer = this.container.querySelector('.si__container');
      if (imageContainer) {
        imageContainer.classList.add('si--popup-active');
      }

      // Focus management for accessibility
      var popup = hotspot.querySelector('[data-hotspot-popup]');
      if (popup) {
        var firstFocusable = popup.querySelector('button, a, input, select');
        if (firstFocusable) {
          setTimeout(function() {
            firstFocusable.focus();
          }, 100);
        }
      }
    },

    closeHotspot: function(hotspot, trigger) {
      trigger.setAttribute('aria-expanded', 'false');
      this.activeHotspot = null;

      var imageContainer = this.container.querySelector('.si__container');
      if (imageContainer) {
        imageContainer.classList.remove('si--popup-active');
      }
    },

    addToCart: function(button) {
      var self = this;
      var variantId = button.dataset.variantId;

      if (!variantId || button.disabled) return;

      button.disabled = true;
      button.classList.add('is-loading');
      button.classList.remove('is-success');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          id: parseInt(variantId, 10),
          quantity: 1
        })
      })
      .then(function(response) {
        if (!response.ok) {
          throw new Error('Add to cart failed');
        }
        return response.json();
      })
      .then(function(data) {
        button.classList.remove('is-loading');
        button.classList.add('is-success');

        // Dispatch cart updated event
        document.dispatchEvent(new CustomEvent('cart:updated', {
          detail: { item: data }
        }));

        // Reset button after delay
        setTimeout(function() {
          button.classList.remove('is-success');
          button.disabled = false;
        }, 2000);
      })
      .catch(function(error) {
        console.error('Add to cart error:', error);
        button.classList.remove('is-loading');
        button.disabled = false;

        // Show error feedback
        var textEl = button.querySelector('.si__popup-atc-text');
        if (textEl) {
          var originalText = textEl.innerHTML;
          textEl.innerHTML = '<svg viewBox="0 0 20 20" fill="none" style="width:16px;height:16px"><path d="M10 5V11M10 14V15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg> Erreur';
          setTimeout(function() {
            textEl.innerHTML = originalText;
          }, 2000);
        }
      });
    },

    setupIntersectionObserver: function() {
      var self = this;

      // Pause animations when not in viewport
      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            var hotspots = self.container.querySelectorAll('.si__hotspot');
            hotspots.forEach(function(hotspot) {
              if (entry.isIntersecting) {
                hotspot.style.animationPlayState = 'running';
                var trigger = hotspot.querySelector('.si__trigger');
                if (trigger) trigger.style.animationPlayState = 'running';
              } else {
                hotspot.style.animationPlayState = 'paused';
                var trigger = hotspot.querySelector('.si__trigger');
                if (trigger) trigger.style.animationPlayState = 'paused';
              }
            });
          });
        }, { threshold: 0.1 });

        observer.observe(this.container);
      }
    }
  };

  // Initialize all shoppable images
  function initAll() {
    document.querySelectorAll('[data-shoppable-image]').forEach(function(el) {
      new ShoppableImage(el);
    });
  }

  // DOM Ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

  // Shopify Theme Editor support
  if (typeof Shopify !== 'undefined' && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(e) {
      var shoppable = e.target.querySelector('[data-shoppable-image]');
      if (shoppable) {
        new ShoppableImage(shoppable);
      }
    });

    document.addEventListener('shopify:block:select', function(e) {
      var hotspot = e.target.closest('[data-hotspot]');
      if (hotspot) {
        var trigger = hotspot.querySelector('[data-hotspot-trigger]');
        if (trigger) {
          trigger.setAttribute('aria-expanded', 'true');
        }
      }
    });

    document.addEventListener('shopify:block:deselect', function(e) {
      var hotspot = e.target.closest('[data-hotspot]');
      if (hotspot) {
        var trigger = hotspot.querySelector('[data-hotspot-trigger]');
        if (trigger) {
          trigger.setAttribute('aria-expanded', 'false');
        }
      }
    });
  }
})();
</script>

