{%- comment -%}
  Article Main Section - Blog Post Detail
  Optimized for SEO and User Experience
  Features: Schema markup, social sharing, reading progress, sidebar
{%- endcomment -%}

{%- comment -%} Article Schema for SEO {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "image": {
    "@type": "ImageObject",
    "url": {{ article.image | image_url: width: 1200 | json }},
    "width": 1200,
    "height": 630
  },
  "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%d' | json }},
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "logo": {
      "@type": "ImageObject",
      "url": {{ shop.brand.logo | image_url: width: 600 | json }}
    }
  },
  "description": {{ article.excerpt_or_content | strip_html | truncate: 160 | json }},
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ article.url | prepend: shop.url | json }}
  }
}
</script>

{%- comment -%} Reading Progress Bar {%- endcomment -%}
{%- if section.settings.show_reading_progress -%}
<div class="reading-progress-bar" data-reading-progress></div>
{%- endif -%}

<article class="article-page section" itemscope itemtype="https://schema.org/BlogPosting">
  <div class="container">
    <div class="article-layout{% unless section.settings.show_sidebar %} article-layout--no-sidebar{% endunless %}">

      {%- comment -%} Main Article Content {%- endcomment -%}
      <div class="article-main">

        {%- comment -%} Article Header {%- endcomment -%}
        <header class="article-header">

          {%- comment -%} Article Title (H1 for SEO) {%- endcomment -%}
          <h1 class="article-title" itemprop="headline">{{ article.title }}</h1>

          {%- comment -%} Featured Image - LCP optimized {%- endcomment -%}
          {%- if article.image -%}
            <figure class="article-featured-image">
              <img
                src="{{ article.image | image_url: width: 1200 }}"
                alt="{{ article.image.alt | default: article.title }}"
                width="1200"
                height="675"
                loading="eager"
                fetchpriority="high"
                itemprop="image"
              >
            </figure>
          {%- endif -%}

          {%- comment -%} Meta bar: date, author, reading time + share buttons - all on one line {%- endcomment -%}
          {%- assign word_count = article.content | strip_html | split: ' ' | size -%}
          {%- assign reading_time = word_count | divided_by: 200 | at_least: 1 -%}
          {%- comment -%} French date formatting {%- endcomment -%}
          {%- assign day = article.published_at | date: '%d' -%}
          {%- assign month_num = article.published_at | date: '%m' -%}
          {%- assign year = article.published_at | date: '%Y' -%}
          {%- case month_num -%}
            {%- when '01' -%}{%- assign month_fr = 'janvier' -%}
            {%- when '02' -%}{%- assign month_fr = 'février' -%}
            {%- when '03' -%}{%- assign month_fr = 'mars' -%}
            {%- when '04' -%}{%- assign month_fr = 'avril' -%}
            {%- when '05' -%}{%- assign month_fr = 'mai' -%}
            {%- when '06' -%}{%- assign month_fr = 'juin' -%}
            {%- when '07' -%}{%- assign month_fr = 'juillet' -%}
            {%- when '08' -%}{%- assign month_fr = 'août' -%}
            {%- when '09' -%}{%- assign month_fr = 'septembre' -%}
            {%- when '10' -%}{%- assign month_fr = 'octobre' -%}
            {%- when '11' -%}{%- assign month_fr = 'novembre' -%}
            {%- when '12' -%}{%- assign month_fr = 'décembre' -%}
          {%- endcase -%}
          <div class="article-meta-bar">
            <div class="article-meta">
              <time class="article-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}" itemprop="datePublished">
                {{ day }} {{ month_fr }} {{ year }}
              </time>
              <span class="article-separator">•</span>
              <span class="article-author" itemprop="author" itemscope itemtype="https://schema.org/Person">
                <span itemprop="name">{{ article.author }}</span>
              </span>
              <span class="article-separator">•</span>
              <span class="article-reading-time">{{ reading_time }} min</span>
              {%- if article.comments_count > 0 -%}
                <span class="article-separator">•</span>
                <a href="#comments" class="article-comments-link">
                  {{ article.comments_count }} commentaire{% if article.comments_count > 1 %}s{% endif %}
                </a>
              {%- endif -%}
            </div>

            {%- if section.settings.show_social_share -%}
            <div class="article-share" data-article-share>
              <span class="article-share__label">Partager</span>
              <div class="article-share__buttons">
                <a href="https://www.facebook.com/sharer/sharer.php?u={{ article.url | prepend: shop.url | url_encode }}"
                   target="_blank"
                   rel="noopener"
                   class="article-share__button"
                   aria-label="Partager sur Facebook">
                  <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M20 10c0-5.523-4.477-10-10-10S0 4.477 0 10c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V10h2.54V7.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V10h2.773l-.443 2.89h-2.33v6.988C16.343 19.128 20 14.991 20 10z"/>
                  </svg>
                </a>
                <a href="https://twitter.com/intent/tweet?url={{ article.url | prepend: shop.url | url_encode }}&text={{ article.title | url_encode }}"
                   target="_blank"
                   rel="noopener"
                   class="article-share__button"
                   aria-label="Partager sur X">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>
                <a href="https://pinterest.com/pin/create/button/?url={{ article.url | prepend: shop.url | url_encode }}&description={{ article.title | url_encode }}"
                   target="_blank"
                   rel="noopener"
                   class="article-share__button"
                   aria-label="Épingler sur Pinterest">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
                  </svg>
                </a>
                <button type="button"
                        class="article-share__button"
                        data-copy-url="{{ article.url | prepend: shop.url }}"
                        aria-label="Copier le lien">
                  <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 4H6a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-2M12 2h6m0 0v6m0-6L10 10" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            </div>
            {%- endif -%}
          </div>

        </header>

        {%- comment -%} Table of Contents / Sommaire {%- endcomment -%}
        {%- if section.settings.show_table_of_contents -%}
          {%- render 'article-table-of-contents', content: article.content -%}
        {%- endif -%}

        {%- comment -%} Article Content {%- endcomment -%}
        <div class="article-content rte" data-article-content itemprop="articleBody">
          {{ article.content }}
        </div>

        {%- comment -%} Author Bio - Configurable {%- endcomment -%}
        {%- if section.settings.show_author_bio -%}
        {%- liquid
          assign author_name = section.settings.author_name | default: article.author
          assign author_description = section.settings.author_description | default: 'Auteur chez ' | append: shop.name
          assign author_image = section.settings.author_image
        -%}
        <div class="article-author-bio">
          <div class="article-author-bio__avatar">
            {%- if author_image != blank -%}
              <img
                src="{{ author_image | image_url: width: 120 }}"
                alt="{{ author_name }}"
                width="60"
                height="60"
                loading="lazy"
              >
            {%- else -%}
              <div class="article-author-bio__avatar-placeholder">
                <span>{{ author_name | slice: 0 | upcase }}</span>
              </div>
            {%- endif -%}
          </div>
          <div class="article-author-bio__content">
            <div class="article-author-bio__name">{{ author_name }}</div>
            <div class="article-author-bio__description">{{ author_description }}</div>
            {%- liquid
              assign author_instagram = section.settings.author_instagram
              assign author_facebook = section.settings.author_facebook
              assign author_twitter = section.settings.author_twitter
              assign author_tiktok = section.settings.author_tiktok
              assign author_youtube = section.settings.author_youtube
              assign author_pinterest = section.settings.author_pinterest
              assign author_website = section.settings.author_website
            -%}
            {%- if author_instagram != blank or author_facebook != blank or author_twitter != blank or author_tiktok != blank or author_youtube != blank or author_pinterest != blank or author_website != blank -%}
              <div class="article-author-bio__social">
                {%- if author_instagram != blank -%}
                  <a href="{{ author_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M10 0C7.284 0 6.944.012 5.877.06 4.813.11 4.086.278 3.45.525a4.893 4.893 0 00-1.771 1.154A4.893 4.893 0 00.525 3.45C.278 4.086.11 4.813.06 5.877.012 6.944 0 7.284 0 10s.012 3.056.06 4.123c.05 1.064.218 1.791.465 2.427a4.893 4.893 0 001.154 1.771 4.893 4.893 0 001.771 1.154c.636.247 1.363.415 2.427.465C6.944 19.988 7.284 20 10 20s3.056-.012 4.123-.06c1.064-.05 1.791-.218 2.427-.465a4.893 4.893 0 001.771-1.154 4.893 4.893 0 001.154-1.771c.247-.636.415-1.363.465-2.427.048-1.067.06-1.407.06-4.123s-.012-3.056-.06-4.123c-.05-1.064-.218-1.791-.465-2.427a4.893 4.893 0 00-1.154-1.771A4.893 4.893 0 0016.55.525C15.914.278 15.187.11 14.123.06 13.056.012 12.716 0 10 0zm0 1.802c2.67 0 2.986.01 4.04.058.976.045 1.505.207 1.858.344.466.182.8.399 1.15.748.35.35.566.684.748 1.15.137.353.3.882.344 1.857.048 1.055.058 1.37.058 4.04 0 2.672-.01 2.987-.058 4.042-.045.975-.207 1.504-.344 1.857a3.097 3.097 0 01-.748 1.15c-.35.35-.684.566-1.15.748-.353.137-.882.3-1.857.344-1.054.048-1.37.058-4.041.058-2.67 0-2.987-.01-4.04-.058-.976-.045-1.505-.207-1.858-.344a3.097 3.097 0 01-1.15-.748 3.097 3.097 0 01-.748-1.15c-.137-.353-.3-.882-.344-1.857-.048-1.055-.058-1.37-.058-4.041 0-2.67.01-2.986.058-4.04.045-.976.207-1.505.344-1.858.182-.466.399-.8.748-1.15.35-.35.684-.566 1.15-.748.353-.137.882-.3 1.857-.344 1.055-.048 1.37-.058 4.041-.058zm0 3.063a5.135 5.135 0 100 10.27 5.135 5.135 0 000-10.27zm0 8.468a3.333 3.333 0 110-6.666 3.333 3.333 0 010 6.666zm6.538-8.671a1.2 1.2 0 11-2.4 0 1.2 1.2 0 012.4 0z"/></svg>
                  </a>
                {%- endif -%}
                {%- if author_facebook != blank -%}
                  <a href="{{ author_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M20 10C20 4.477 15.523 0 10 0S0 4.477 0 10c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V10h2.54V7.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V10h2.773l-.443 2.89h-2.33v6.988C16.343 19.128 20 14.991 20 10z"/></svg>
                  </a>
                {%- endif -%}
                {%- if author_twitter != blank -%}
                  <a href="{{ author_twitter }}" target="_blank" rel="noopener" aria-label="X (Twitter)">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M11.903 8.471L19.347 0h-1.764l-6.465 7.353L5.955 0H0l7.808 11.12L0 20h1.764l6.828-7.765L14.045 20H20L11.903 8.471zm-2.417 2.749l-.791-1.108L2.4 1.3h2.712l5.082 7.112.791 1.108 6.604 9.243h-2.712l-5.39-7.543z"/></svg>
                  </a>
                {%- endif -%}
                {%- if author_tiktok != blank -%}
                  <a href="{{ author_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M14.125 0h-3.05v13.622c0 1.623-1.3 2.932-2.912 2.932a2.92 2.92 0 01-2.913-2.932 2.92 2.92 0 012.913-2.932c.3 0 .587.044.862.125V7.7a6.087 6.087 0 00-.862-.063C3.663 7.637 0 11.32 0 15.84 0 20.36 3.663 22 8.163 22c4.5 0 8.162-1.64 8.162-6.16V7.475A9.393 9.393 0 0020 9.1V6.037a5.842 5.842 0 01-5.875-6.037z" transform="translate(0 -1)"/></svg>
                  </a>
                {%- endif -%}
                {%- if author_youtube != blank -%}
                  <a href="{{ author_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M19.582 3.186A2.506 2.506 0 0017.82 1.41C16.254 1 10 1 10 1S3.746 1 2.18 1.41A2.506 2.506 0 00.418 3.186C0 4.768 0 8.1 0 8.1s0 3.332.418 4.914a2.506 2.506 0 001.762 1.776C3.746 15.2 10 15.2 10 15.2s6.254 0 7.82-.41a2.506 2.506 0 001.762-1.776C20 11.432 20 8.1 20 8.1s0-3.332-.418-4.914zM7.955 11.471V4.729L13.182 8.1 7.955 11.47z" transform="translate(0 2)"/></svg>
                  </a>
                {%- endif -%}
                {%- if author_pinterest != blank -%}
                  <a href="{{ author_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M10 0C4.477 0 0 4.477 0 10c0 4.237 2.636 7.855 6.356 9.312-.088-.791-.166-2.005.035-2.868.182-.78 1.172-4.97 1.172-4.97s-.299-.598-.299-1.482c0-1.388.805-2.425 1.808-2.425.853 0 1.264.64 1.264 1.408 0 .858-.546 2.14-.828 3.33-.236.995.499 1.806 1.48 1.806 1.778 0 3.144-1.874 3.144-4.58 0-2.393-1.72-4.068-4.177-4.068-2.845 0-4.515 2.134-4.515 4.34 0 .859.331 1.781.744 2.282a.3.3 0 01.07.287c-.076.316-.245.995-.278 1.134-.044.183-.145.222-.335.134-1.249-.581-2.03-2.407-2.03-3.874 0-3.154 2.292-6.052 6.608-6.052 3.469 0 6.165 2.473 6.165 5.776 0 3.447-2.173 6.22-5.19 6.22-1.013 0-1.965-.527-2.291-1.148l-.623 2.378c-.225.869-.834 1.956-1.241 2.62A10 10 0 0010 20c5.523 0 10-4.477 10-10S15.523 0 10 0z"/></svg>
                  </a>
                {%- endif -%}
                {%- if author_website != blank -%}
                  <a href="{{ author_website }}" target="_blank" rel="noopener" aria-label="Site web">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
        {%- endif -%}

        {%- comment -%} Article Navigation {%- endcomment -%}
        {%- if section.settings.show_article_navigation -%}
        <nav class="article-navigation" aria-label="Article Navigation">
          {%- if blog.previous_article -%}
            <a href="{{ blog.previous_article.url }}" class="article-navigation__link article-navigation__link--prev">
              <span class="article-navigation__label">← Article précédent</span>
              <span class="article-navigation__title">{{ blog.previous_article.title | truncate: 50 }}</span>
            </a>
          {%- endif -%}

          {%- if blog.next_article -%}
            <a href="{{ blog.next_article.url }}" class="article-navigation__link article-navigation__link--next">
              <span class="article-navigation__label">Article suivant →</span>
              <span class="article-navigation__title">{{ blog.next_article.title | truncate: 50 }}</span>
            </a>
          {%- endif -%}
        </nav>
        {%- endif -%}

        {%- comment -%} Comments Section {%- endcomment -%}
        {%- if section.settings.show_comments and blog.comments_enabled? -%}
        <div class="article-comments" id="comments">
          <h2 class="article-comments__title">
            Commentaires
            {%- if article.comments_count > 0 -%}
              ({{ article.comments_count }})
            {%- endif -%}
          </h2>

          {%- if article.comments_count > 0 -%}
            {%- paginate article.comments by 50 -%}
              <div class="comments-list">
                {%- for comment in article.comments -%}
                  <div class="comment" id="comment-{{ comment.id }}">
                    <div class="comment__header">
                      <strong class="comment__author">{{ comment.author }}</strong>
                      <time class="comment__date" datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                        {{ comment.created_at | date: '%d %B %Y à %H:%M' }}
                      </time>
                    </div>
                    <div class="comment__content">
                      {{ comment.content }}
                    </div>
                  </div>
                {%- endfor -%}
              </div>

              {%- if paginate.pages > 1 -%}
                {%- render 'pagination', paginate: paginate -%}
              {%- endif -%}
            {%- endpaginate -%}
          {%- endif -%}

          {%- comment -%} Comment Form {%- endcomment -%}
          <div class="comment-form">
            <h3 class="comment-form__title">Laisser un commentaire</h3>
            {%- form 'new_comment', article -%}
              {%- if form.posted_successfully? -%}
                <div class="form-success">
                  {%- if blog.moderated? -%}
                    Votre commentaire a été soumis avec succès. Il sera publié après modération.
                  {%- else -%}
                    Votre commentaire a été publié avec succès.
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if form.errors -%}
                <div class="form-error">
                  Erreur lors de l'envoi du commentaire. Veuillez vérifier les champs.
                </div>
              {%- endif -%}

              <div class="form-group">
                <label for="comment-author">Nom *</label>
                <input
                  type="text"
                  id="comment-author"
                  name="comment[author]"
                  value="{{ form.author }}"
                  required
                  placeholder="Votre nom"
                >
              </div>

              <div class="form-group">
                <label for="comment-email">Email *</label>
                <input
                  type="email"
                  id="comment-email"
                  name="comment[email]"
                  value="{{ form.email }}"
                  required
                  placeholder="votre@email.com"
                >
              </div>

              <div class="form-group">
                <label for="comment-body">Commentaire *</label>
                <textarea
                  id="comment-body"
                  name="comment[body]"
                  required
                  rows="5"
                  placeholder="Votre commentaire..."
                >{{ form.body }}</textarea>
              </div>

              <button type="submit" class="btn btn--primary">
                Publier le commentaire
              </button>
            {%- endform -%}
          </div>
        </div>
        {%- endif -%}

      </div>

      {%- comment -%} Sidebar {%- endcomment -%}
      {%- if section.settings.show_sidebar -%}
      <aside class="article-sidebar">

        {%- comment -%} Related Articles Widget {%- endcomment -%}
        {%- assign related_articles = blog.articles | where_exp: "a", "a.id != article.id" | limit: 5 -%}
        {%- if related_articles.size > 0 -%}
          <div class="sidebar-widget">
            <h3 class="sidebar-widget__title">Articles récents</h3>
            <ul class="sidebar-recent-posts">
              {%- for related in related_articles -%}
                {%- assign rel_day = related.published_at | date: '%d' -%}
                {%- assign rel_month_num = related.published_at | date: '%m' -%}
                {%- assign rel_year = related.published_at | date: '%Y' -%}
                {%- case rel_month_num -%}
                  {%- when '01' -%}{%- assign rel_month_fr = 'janvier' -%}
                  {%- when '02' -%}{%- assign rel_month_fr = 'février' -%}
                  {%- when '03' -%}{%- assign rel_month_fr = 'mars' -%}
                  {%- when '04' -%}{%- assign rel_month_fr = 'avril' -%}
                  {%- when '05' -%}{%- assign rel_month_fr = 'mai' -%}
                  {%- when '06' -%}{%- assign rel_month_fr = 'juin' -%}
                  {%- when '07' -%}{%- assign rel_month_fr = 'juillet' -%}
                  {%- when '08' -%}{%- assign rel_month_fr = 'août' -%}
                  {%- when '09' -%}{%- assign rel_month_fr = 'septembre' -%}
                  {%- when '10' -%}{%- assign rel_month_fr = 'octobre' -%}
                  {%- when '11' -%}{%- assign rel_month_fr = 'novembre' -%}
                  {%- when '12' -%}{%- assign rel_month_fr = 'décembre' -%}
                {%- endcase -%}
                <li>
                  <a href="{{ related.url }}" class="sidebar-recent-post">
                    {%- if related.image -%}
                      <img
                        src="{{ related.image | image_url: width: 160, height: 90, crop: 'center' }}"
                        alt="{{ related.title }}"
                        width="160"
                        height="90"
                        loading="lazy"
                      >
                    {%- endif -%}
                    <div class="sidebar-recent-post__content">
                      <h4>{{ related.title | truncate: 50 }}</h4>
                      <time datetime="{{ related.published_at | date: '%Y-%m-%d' }}">
                        {{ rel_day }} {{ rel_month_fr }} {{ rel_year }}
                      </time>
                    </div>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- comment -%} Free Pattern Widget {%- endcomment -%}
        <div class="sidebar-widget sidebar-widget--gift">
          <div class="sidebar-gift__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M20 12v10H4V12M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 110-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 100-5C13 2 12 7 12 7z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
