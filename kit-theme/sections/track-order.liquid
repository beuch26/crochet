{%- comment -%}
  Track Order Section
  Allows customers to track their order status

  Usage: Add to a page template via Theme Editor
{%- endcomment -%}

{%- liquid
  assign section_id = section.id
  assign heading = section.settings.heading | default: 'Track Your Order'
  assign subheading = section.settings.subheading
-%}

<section class="track-order section section--{{ section_id }}" id="track-order-{{ section_id }}">
  <div class="container container--narrow">
    {%- if heading != blank -%}
      <div class="section-header section-header--center">
        <h1 class="section-header__title">{{ heading }}</h1>
        {%- if subheading != blank -%}
          <p class="section-header__subtitle">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="track-order__form-wrapper" data-track-order>
      <form class="track-order__form" data-track-form>
        <div class="track-order__field">
          <label for="order-number" class="track-order__label">
            {{ 'general.track_order.order_number' | t | default: 'Numéro de commande' }}
          </label>
          <input
            type="text"
            id="order-number"
            name="order_number"
            class="track-order__input"
            placeholder="{{ 'general.track_order.order_placeholder' | t | default: 'ex: #1001' }}"
            required
            autocomplete="off"
          >
        </div>

        <div class="track-order__field">
          <label for="order-email" class="track-order__label">
            {{ 'general.track_order.email' | t | default: 'Adresse e-mail' }}
          </label>
          <input
            type="email"
            id="order-email"
            name="email"
            class="track-order__input"
            placeholder="{{ 'general.track_order.email_placeholder' | t | default: 'E-mail utilisé pour la commande' }}"
            required
            autocomplete="email"
          >
        </div>

        <button type="submit" class="track-order__submit btn btn--primary btn--full">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M9 17A8 8 0 109 1a8 8 0 000 16z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M19 19l-4.35-4.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          {{ 'general.track_order.track_button' | t | default: 'Suivre la commande' }}
        </button>
      </form>

      {%- comment -%} Results Area {%- endcomment -%}
      <div class="track-order__results" data-track-results style="display: none;">
        <div class="track-order__order-info" data-order-info>
          <div class="track-order__order-header">
            <h2 class="track-order__order-title">
              {{ 'general.track_order.order' | t | default: 'Commande' }} <span data-order-name></span>
            </h2>
            <span class="track-order__order-status" data-order-status></span>
          </div>
          <p class="track-order__order-date">
            {{ 'general.track_order.placed_on' | t | default: 'Passée le' }} <span data-order-date></span>
          </p>
        </div>

        {%- comment -%} Timeline {%- endcomment -%}
        <div class="track-order__timeline" data-order-timeline>
          <div class="track-order__timeline-item" data-step="confirmed">
            <div class="track-order__timeline-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M16.5 5.5L7.5 14.5L3.5 10.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="track-order__timeline-content">
              <span class="track-order__timeline-title">{{ 'general.track_order.confirmed' | t | default: 'Commande confirmée' }}</span>
              <span class="track-order__timeline-date" data-step-date></span>
            </div>
          </div>

          <div class="track-order__timeline-item" data-step="processing">
            <div class="track-order__timeline-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M17 10a7 7 0 11-14 0 7 7 0 0114 0z" stroke="currentColor" stroke-width="1.5"/>
                <path d="M10 6v4l2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="track-order__timeline-content">
              <span class="track-order__timeline-title">{{ 'general.track_order.processing' | t | default: 'En préparation' }}</span>
              <span class="track-order__timeline-date" data-step-date></span>
            </div>
          </div>

          <div class="track-order__timeline-item" data-step="shipped">
            <div class="track-order__timeline-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M13 3H3v10h10V3z" stroke="currentColor" stroke-width="1.5"/>
                <path d="M13 7h4l2 3v3h-6V7z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <circle cx="6" cy="16" r="2" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="16" cy="16" r="2" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </div>
            <div class="track-order__timeline-content">
              <span class="track-order__timeline-title">{{ 'general.track_order.shipped' | t | default: 'Expédiée' }}</span>
              <span class="track-order__timeline-date" data-step-date></span>
            </div>
          </div>

          <div class="track-order__timeline-item" data-step="delivered">
            <div class="track-order__timeline-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M3 10l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M17 3v14H3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="track-order__timeline-content">
              <span class="track-order__timeline-title">{{ 'general.track_order.delivered' | t | default: 'Livrée' }}</span>
              <span class="track-order__timeline-date" data-step-date></span>
            </div>
          </div>
        </div>

        {%- comment -%} Tracking Link {%- endcomment -%}
        <div class="track-order__tracking" data-tracking-info style="display: none;">
          <p class="track-order__tracking-label">{{ 'general.track_order.tracking_number' | t | default: 'Numéro de suivi' }}:</p>
          <a href="#" class="track-order__tracking-link" data-tracking-link target="_blank" rel="noopener">
            <span data-tracking-number></span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M6 2H2v12h12v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M8 8l6-6M14 6V2h-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <button type="button" class="track-order__back" data-track-back>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {{ 'general.track_order.track_another' | t | default: 'Suivre une autre commande' }}
        </button>
      </div>

      {%- comment -%} Error State {%- endcomment -%}
      <div class="track-order__error" data-track-error style="display: none;">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
          <circle cx="24" cy="24" r="20" stroke="var(--color-error)" stroke-width="2"/>
          <path d="M24 16v10M24 32h.02" stroke="var(--color-error)" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <h3>{{ 'general.track_order.not_found_title' | t | default: 'Commande introuvable' }}</h3>
        <p>{{ 'general.track_order.not_found_message' | t | default: "Nous n'avons pas trouvé de commande correspondant à ces informations. Veuillez vérifier et réessayer." }}</p>
        <button type="button" class="btn btn--outline" data-try-again>
          {{ 'general.track_order.try_again' | t | default: 'Réessayer' }}
        </button>
      </div>
    </div>

    {%- comment -%} Help Section {%- endcomment -%}
    {%- if section.settings.show_help -%}
      <div class="track-order__help">
        <h3>{{ 'general.track_order.need_help' | t | default: "Besoin d'aide ?" }}</h3>
        <p>{{ 'general.track_order.help_text' | t | default: 'Si vous avez des questions sur votre commande, contactez notre service client.' }}</p>
        {%- if section.settings.contact_link != blank -%}
          <a href="{{ section.settings.contact_link }}" class="btn btn--outline">
            {{ 'general.track_order.contact_us' | t | default: 'Nous contacter' }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .track-order {
    padding: var(--spacing-2xl) 0;
  }

  .container--narrow {
    max-width: 600px;
    margin: 0 auto;
  }

  .track-order__form-wrapper {
    background-color: var(--color-background-light);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
  }

  .track-order__form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .track-order__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .track-order__label {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .track-order__input {
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 1rem;
    transition: border-color 0.2s ease;
  }

  .track-order__input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .track-order__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: var(--spacing-sm);
  }

  .track-order__results {
    text-align: center;
  }

  .track-order__order-info {
    margin-bottom: var(--spacing-lg);
  }

  .track-order__order-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .track-order__order-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
  }

  .track-order__order-status {
    padding: 0.25rem 0.75rem;
    background-color: var(--color-success);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    text-transform: uppercase;
  }

  .track-order__order-status[data-status="unfulfilled"] {
    background-color: var(--color-warning);
    color: #1a1a1a;
  }

  .track-order__order-status[data-status="cancelled"] {
    background-color: var(--color-error);
  }

  .track-order__order-date {
    font-size: 0.875rem;
    color: var(--color-text-light);
    margin-top: 0.5rem;
  }

  .track-order__timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    padding: var(--spacing-md) 0;
    text-align: left;
  }

  .track-order__timeline::before {
    content: '';
    position: absolute;
    left: 18px;
    top: 28px;
    bottom: 28px;
    width: 2px;
    background-color: var(--color-border);
  }

  .track-order__timeline-item {
    display: flex;
    gap: var(--spacing-sm);
    position: relative;
    opacity: 0.4;
  }

  .track-order__timeline-item.is-complete {
    opacity: 1;
  }

  .track-order__timeline-item.is-complete .track-order__timeline-icon {
    background-color: var(--color-success);
    color: white;
    border-color: var(--color-success);
  }

  .track-order__timeline-item.is-current {
    opacity: 1;
  }

  .track-order__timeline-item.is-current .track-order__timeline-icon {
    background-color: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(var(--color-primary-rgb, 37, 99, 235), 0.4); }
    50% { box-shadow: 0 0 0 8px rgba(var(--color-primary-rgb, 37, 99, 235), 0); }
  }

  .track-order__timeline-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    border: 2px solid var(--color-border);
    background-color: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    z-index: 1;
  }

  .track-order__timeline-content {
    display: flex;
    flex-direction: column;
    padding-top: 8px;
  }

  .track-order__timeline-title {
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .track-order__timeline-date {
    font-size: 0.8125rem;
    color: var(--color-text-light);
  }

  .track-order__tracking {
    margin-top: var(--spacing-md);
    padding: var(--spacing-sm);
    background-color: var(--color-background);
    border-radius: var(--radius-md);
  }

  .track-order__tracking-label {
    font-size: 0.8125rem;
    color: var(--color-text-light);
    margin-bottom: 0.25rem;
  }

  .track-order__tracking-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .track-order__tracking-link:hover {
    text-decoration: underline;
  }

  .track-order__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--spacing-lg);
    padding: 0;
    background: none;
    border: none;
    color: var(--color-text-light);
    font-size: 0.875rem;
    cursor: pointer;
  }

  .track-order__back:hover {
    color: var(--color-text);
  }

  .track-order__error {
    text-align: center;
    padding: var(--spacing-lg) 0;
  }

  .track-order__error svg {
    margin-bottom: var(--spacing-sm);
  }

  .track-order__error h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .track-order__error p {
    color: var(--color-text-light);
    margin-bottom: var(--spacing-md);
  }

  .track-order__help {
    margin-top: var(--spacing-xl);
    text-align: center;
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border);
  }

  .track-order__help h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .track-order__help p {
    font-size: 0.875rem;
    color: var(--color-text-light);
    margin-bottom: var(--spacing-sm);
  }
</style>

<script>
  (function() {
    'use strict';

    function initTrackOrder(container) {
      const form = container.querySelector('[data-track-form]');
      const results = container.querySelector('[data-track-results]');
      const error = container.querySelector('[data-track-error]');
      const backBtn = container.querySelector('[data-track-back]');
      const tryAgainBtn = container.querySelector('[data-try-again]');

      if (!form) return;

      function showForm() {
        form.style.display = 'flex';
        results.style.display = 'none';
        error.style.display = 'none';
        form.reset();
      }

      function showResults(order) {
        form.style.display = 'none';
        error.style.display = 'none';
        results.style.display = 'block';

        // Populate order info
        container.querySelector('[data-order-name]').textContent = order.name;
        container.querySelector('[data-order-date]').textContent = order.created_at;

        const statusEl = container.querySelector('[data-order-status]');
        statusEl.textContent = order.fulfillment_status || 'Processing';
        statusEl.dataset.status = order.fulfillment_status || 'unfulfilled';

        // Update timeline
        const timeline = container.querySelector('[data-order-timeline]');
        const steps = timeline.querySelectorAll('[data-step]');

        steps.forEach(step => {
          step.classList.remove('is-complete', 'is-current');
        });

        const currentStep = order.fulfillment_status === 'fulfilled' ? 'delivered' :
                           order.fulfillment_status === 'partial' ? 'shipped' : 'processing';

        const stepOrder = ['confirmed', 'processing', 'shipped', 'delivered'];
        const currentIndex = stepOrder.indexOf(currentStep);

        steps.forEach((step, index) => {
          if (index < currentIndex) {
            step.classList.add('is-complete');
          } else if (index === currentIndex) {
            step.classList.add('is-current');
          }
        });

        // Show tracking info if available
        const trackingInfo = container.querySelector('[data-tracking-info]');
        if (order.tracking_number && order.tracking_url) {
          trackingInfo.style.display = 'block';
          container.querySelector('[data-tracking-number]').textContent = order.tracking_number;
          container.querySelector('[data-tracking-link]').href = order.tracking_url;
        } else {
          trackingInfo.style.display = 'none';
        }
      }

      function showError() {
        form.style.display = 'none';
        results.style.display = 'none';
        error.style.display = 'block';
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const orderNumber = form.querySelector('[name="order_number"]').value.trim().replace('#', '');
        const email = form.querySelector('[name="email"]').value.trim();

        const submitBtn = form.querySelector('[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner"></span> Recherche...';

        try {
          // Note: Shopify doesn't have a public API to look up orders by number + email
          // This would require a backend/app or Shopify Flow integration
          // For demo purposes, we'll show the error state
          await new Promise(resolve => setTimeout(resolve, 1500));

          // In production, you would call your backend API:
          // const response = await fetch('/apps/track-order?order=' + orderNumber + '&email=' + email);
          // const order = await response.json();
          // if (order) showResults(order); else showError();

          showError();
        } catch (err) {
          showError();
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M9 17A8 8 0 109 1a8 8 0 000 16z" stroke="currentColor" stroke-width="1.5"/><path d="M19 19l-4.35-4.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg> Suivre la commande';
        }
      });

      if (backBtn) {
        backBtn.addEventListener('click', showForm);
      }

      if (tryAgainBtn) {
        tryAgainBtn.addEventListener('click', showForm);
      }
    }

    document.querySelectorAll('[data-track-order]').forEach(initTrackOrder);

    if (Shopify.designMode) {
      document.addEventListener('shopify:section:load', (e) => {
        const tracker = e.target.querySelector('[data-track-order]');
        if (tracker) initTrackOrder(tracker);
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Suivi de Commande",
  "tag": "section",
  "class": "section-track-order",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Suivre votre commande"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Entrez votre numéro de commande et votre e-mail pour voir l'état de votre livraison"
    },
    {
      "type": "checkbox",
      "id": "show_help",
      "label": "Afficher la section d'aide",
      "default": true
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Lien vers la page contact"
    }
  ],
  "presets": [
    {
      "name": "Suivi de Commande"
    }
  ]
}
{% endschema %}
