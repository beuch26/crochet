{%- comment -%}
  Collection Bubbles Section
  Display related/sister collections in circular bubble format
{%- endcomment -%}

{%- render 'section-spacing', id: section.id, margin_top: section.settings.section_margin_top, margin_bottom: section.settings.section_margin_bottom -%}

{%- if section.blocks.size > 0 -%}
<div class="collection-bubbles section">
  <div class="container">

    {%- if section.settings.title != blank -%}
      {%- liquid
        assign heading_tag = section.settings.heading_tag | default: 'h2'
      -%}
      <div class="collection-bubbles__header">
        {%- if section.settings.subtitle != blank -%}
          <p class="collection-bubbles__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.enable_heading_style -%}
          {%- render 'heading-styles',
            text: section.settings.title,
            tag: 'h2',
            style: section.settings.heading_style,
            color: section.settings.heading_style_color,
            align: 'center',
            size: 'xl',
            typing_texts: section.settings.typing_texts
          -%}
        {%- else -%}
          <{{ heading_tag }} class="collection-bubbles__title">{{ section.settings.title }}</{{ heading_tag }}>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collection-bubbles__wrapper">
      <div class="collection-bubbles__grid">
        {%- for block in section.blocks -%}
          {%- assign collection = collections[block.settings.collection] -%}
          {%- if collection != blank -%}
            <div class="collection-bubble" {{ block.shopify_attributes }}>
              <a href="{{ collection.url }}" class="collection-bubble__link">
                <div class="collection-bubble__image-wrapper">
                  <div class="collection-bubble__image">
                    {%- if collection.image -%}
                      <img
                        src="{{ collection.image | image_url: width: 200 }}"
                        srcset="{{ collection.image | image_url: width: 100 }} 100w,
                                {{ collection.image | image_url: width: 200 }} 200w"
                        sizes="100px"
                        alt="{{ collection.image.alt | default: collection.title }}"
                        width="200"
                        height="200"
                        loading="lazy"
                      >
                    {%- elsif collection.products.first and collection.products.first.featured_image -%}
                      <img
                        src="{{ collection.products.first.featured_image | image_url: width: 200 }}"
                        alt="{{ collection.title }}"
                        width="200"
                        height="200"
                        loading="lazy"
                      >
                    {%- else -%}
                      <div class="collection-bubble__placeholder">
                        {{ 'collection-1' | placeholder_svg_tag }}
                      </div>
                    {%- endif -%}
                  </div>
                </div>

                <div class="collection-bubble__content">
                  <h3 class="collection-bubble__title">{{ collection.title }}</h3>
                  {%- if section.settings.show_product_count -%}
                    <p class="collection-bubble__count">{{ collection.products_count }}</p>
                  {%- endif -%}
                </div>
              </a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</div>
{%- endif -%}

<style>
.collection-bubbles {
  padding: var(--spacing-2xl) 0;
  background-color: var(--color-background);
}

.collection-bubbles__header {
  text-align: center;
  margin-bottom: var(--spacing-xl);
}

.collection-bubbles__subtitle {
  font-size: 0.875rem;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--color-primary-dark);
  font-weight: 600;
  margin: 0 0 var(--spacing-xs);
}

.collection-bubbles__title {
  font-size: clamp(1.5rem, 3vw, 2rem);
  margin: 0;
  color: var(--color-text);
}

.collection-bubbles__wrapper {
  position: relative;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
  scrollbar-color: var(--color-border) transparent;
}

.collection-bubbles__wrapper::-webkit-scrollbar {
  height: 6px;
}

.collection-bubbles__wrapper::-webkit-scrollbar-track {
  background: transparent;
  margin: 0 var(--spacing-md);
}

.collection-bubbles__wrapper::-webkit-scrollbar-thumb {
  background: var(--color-border);
  border-radius: 3px;
}

.collection-bubbles__wrapper::-webkit-scrollbar-thumb:hover {
  background: var(--color-primary);
}

.collection-bubbles__grid {
  display: flex;
  gap: var(--spacing-lg);
  padding: var(--spacing-sm) 0;
  min-width: min-content;
}

.collection-bubble {
  flex: 0 0 auto;
  width: 120px;
}

.collection-bubble__link {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  color: inherit;
  transition: transform var(--transition-speed) var(--transition-ease);
}

.collection-bubble__link:hover {
  transform: translateY(-4px);
}

.collection-bubble__image-wrapper {
  width: 100%;
  margin-bottom: var(--spacing-sm);
}

.collection-bubble__image {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--color-background-light);
  border: 3px solid var(--color-border);
  transition: all var(--transition-speed) var(--transition-ease);
}

.collection-bubble__link:hover .collection-bubble__image {
  border-color: var(--color-primary);
  box-shadow: 0 8px 24px rgba(37, 99, 235, 0.2);
}

.collection-bubble__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.collection-bubble__link:hover .collection-bubble__image img {
  transform: scale(1.1);
}

.collection-bubble__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-secondary-light));
}

.collection-bubble__placeholder svg {
  width: 50%;
  height: 50%;
  opacity: 0.5;
}

.collection-bubble__content {
  text-align: center;
  width: 100%;
}

.collection-bubble__title {
  font-size: 0.875rem;
  font-weight: 600;
  margin: 0 0 0.25rem;
  color: var(--color-text);
  line-height: 1.3;
  transition: color var(--transition-speed);
  word-wrap: break-word;
  overflow-wrap: break-word;
  hyphens: auto;
}

.collection-bubble__link:hover .collection-bubble__title {
  color: var(--color-primary);
}

.collection-bubble__count {
  font-size: 0.75rem;
  color: var(--color-text-light);
  margin: 0;
}

@media (min-width: 768px) {
  .collection-bubble {
    width: 140px;
  }

  .collection-bubbles__grid {
    gap: var(--spacing-xl);
  }
}

@media (min-width: 1024px) {
  .collection-bubbles__grid {
    justify-content: center;
    flex-wrap: wrap;
  }
}
</style>

{% schema %}
{
  "name": "Bulles de Collections",
  "class": "section-collection-bubbles",
  "settings": [
    {
      "type": "header",
      "content": "En-tête de section"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Explorer"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Collections Similaires"
    },
    {
      "type": "header",
      "content": "Style du titre"
    },
    {
      "type": "checkbox",
      "id": "enable_heading_style",
      "label": "Activer le style du titre",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Style",
      "options": [
        { "value": "signature-1", "label": "Signature 1 (manuscrit)" },
        { "value": "signature-2", "label": "Signature 2 (swoosh)" },
        { "value": "signature-3", "label": "Signature 3 (double)" },
        { "value": "signature-4", "label": "Signature 4 (gribouillis)" },
        { "value": "signature-5", "label": "Signature 5 (courbe)" },
        { "value": "underline-1", "label": "Soulignement 1 (pinceau)" },
        { "value": "underline-2", "label": "Soulignement 2 (ligne)" },
        { "value": "underline-3", "label": "Soulignement 3 (surligneur)" },
        { "value": "highlight", "label": "Surligné" },
        { "value": "reflection", "label": "Reflet brillant" },
        { "value": "typing", "label": "Animation frappe" }
      ],
      "default": "signature-1"
    },
    {
      "type": "color",
      "id": "heading_style_color",
      "label": "Couleur de l'effet",
      "default": "#dc2626"
    },
    {
      "type": "text",
      "id": "typing_texts",
      "label": "Textes pour animation frappe",
      "info": "Séparés par des virgules"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "SEO : Niveau de titre",
      "options": [
        {"value": "h1", "label": "H1"},
        {"value": "h2", "label": "H2 (Recommandé)"},
        {"value": "h3", "label": "H3"},
        {"value": "h4", "label": "H4"}
      ],
      "default": "h2",
      "info": "Choisissez le niveau de titre pour cette section."
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Afficher le nombre de produits",
      "default": false,
      "info": "Affiche le nombre de produits sous chaque bulle de collection"
    },
    {
      "type": "header",
      "content": "Espacement de la section"
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "label": "Marge en haut (px)",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "label": "Marge en bas (px)",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bulles de Collections",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
