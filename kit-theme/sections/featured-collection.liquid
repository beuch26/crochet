{%- comment -%}
  Featured Collection Section
  Display products from a selected collection
{%- endcomment -%}

{%- render 'section-spacing', id: section.id, margin_top: section.settings.section_margin_top, margin_bottom: section.settings.section_margin_bottom -%}

<div class="featured-collection section {% if section.settings.background_color %}section--{{ section.settings.background_color }}{% endif %}">
  <div class="container">

    <header class="section-header text-center">
      {%- liquid
        assign heading_tag = section.settings.heading_tag | default: 'h2'
      -%}
      {%- if section.settings.title != blank -%}
        {%- if section.settings.enable_heading_style -%}
          {%- render 'heading-styles',
            text: section.settings.title,
            tag: heading_tag,
            style: section.settings.heading_style,
            color: section.settings.heading_style_color,
            align: 'center',
            size: 'xl',
            typing_texts: section.settings.typing_texts
          -%}
        {%- else -%}
          <{{ heading_tag }} class="section-title">{{ section.settings.title }}</{{ heading_tag }}>
        {%- endif -%}
      {%- elsif section.settings.collection != blank -%}
        {%- if section.settings.enable_heading_style -%}
          {%- render 'heading-styles',
            text: collections[section.settings.collection].title,
            tag: heading_tag,
            style: section.settings.heading_style,
            color: section.settings.heading_style_color,
            align: 'center',
            size: 'xl',
            typing_texts: section.settings.typing_texts
          -%}
        {%- else -%}
          <{{ heading_tag }} class="section-title">{{ collections[section.settings.collection].title }}</{{ heading_tag }}>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {%- elsif section.settings.collection != blank and collections[section.settings.collection].description != blank -%}
        <p class="section-subtitle">{{ collections[section.settings.collection].description | strip_html | truncate: 200 }}</p>
      {%- endif -%}
    </header>

    {%- if section.settings.collection != blank -%}
      {%- assign collection = collections[section.settings.collection] -%}

      {%- if collection.products.size > 0 -%}
        <div class="grid {% if section.settings.columns_desktop == 2 %}grid--2{% elsif section.settings.columns_desktop == 3 %}grid--3{% else %}grid--4{% endif %}">
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            {%- render 'product-card', product: product, show_vendor: section.settings.show_vendor -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.show_view_all -%}
          <div class="section-footer text-center mt-xl">
            <a href="{{ collection.url }}" class="btn btn--primary btn--large">
              {{ 'collections.general.view_all' | t | default: 'View All' }}
            </a>
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="placeholder-collection">
          <p>{{ 'sections.featured_collection.no_products' | t | default: 'This collection has no products' }}</p>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="placeholder-collection">
        <p>{{ 'sections.featured_collection.select_collection' | t | default: 'Select a collection in the theme editor' }}</p>
      </div>
    {%- endif -%}

  </div>
</div>

<style>
.placeholder-collection {
  padding: var(--spacing-2xl);
  text-align: center;
  background-color: var(--color-background-light);
  border: 2px dashed var(--color-border);
  border-radius: var(--radius-lg);
  color: var(--color-text-light);
}
</style>

{% schema %}
{
  "name": "Collection en vedette",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "info": "Laissez vide pour utiliser le titre de la collection"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "SEO : Niveau de titre",
      "options": [
        {"value": "h1", "label": "H1"},
        {"value": "h2", "label": "H2 (Recommande)"},
        {"value": "h3", "label": "H3"},
        {"value": "h4", "label": "H4"}
      ],
      "default": "h2",
      "info": "Choisissez le niveau de titre pour cette section."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "info": "Laissez vide pour utiliser la description de la collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Produits a afficher",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Colonnes (Bureau)",
      "options": [
        {
          "value": "2",
          "label": "2 colonnes"
        },
        {
          "value": "3",
          "label": "3 colonnes"
        },
        {
          "value": "4",
          "label": "4 colonnes"
        }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Afficher la marque/vendeur du produit",
      "default": false,
      "info": "Afficher la marque (vendeur) au-dessus du titre du produit"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Afficher le bouton 'Voir tout'",
      "default": true
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Couleur de fond",
      "options": [
        {
          "value": "default",
          "label": "Par defaut"
        },
        {
          "value": "light",
          "label": "Claire"
        }
      ],
      "default": "light"
    },
    {
      "type": "header",
      "content": "Style du titre"
    },
    {
      "type": "checkbox",
      "id": "enable_heading_style",
      "label": "Activer le style du titre",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Style",
      "options": [
        { "value": "signature-1", "label": "Signature 1 (manuscrit)" },
        { "value": "signature-2", "label": "Signature 2 (swoosh)" },
        { "value": "signature-3", "label": "Signature 3 (double)" },
        { "value": "signature-4", "label": "Signature 4 (gribouillis)" },
        { "value": "signature-5", "label": "Signature 5 (courbe)" },
        { "value": "underline-1", "label": "Soulignement 1 (pinceau)" },
        { "value": "underline-2", "label": "Soulignement 2 (ligne)" },
        { "value": "underline-3", "label": "Soulignement 3 (surligneur)" },
        { "value": "highlight", "label": "Surligne" },
        { "value": "reflection", "label": "Reflet brillant" },
        { "value": "typing", "label": "Animation frappe" }
      ],
      "default": "signature-1"
    },
    {
      "type": "color",
      "id": "heading_style_color",
      "label": "Couleur de l'effet",
      "default": "#dc2626"
    },
    {
      "type": "text",
      "id": "typing_texts",
      "label": "Textes pour animation frappe",
      "info": "Separes par des virgules"
    },
    {
      "type": "header",
      "content": "Espacement de la section"
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "label": "Marge en haut (px)",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "label": "Marge en bas (px)",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Collection en vedette"
    }
  ]
}
{% endschema %}
