# Configuration pour le script d'installation des metafields
# Copier ce fichier vers .env et remplir les valeurs

# Domaine de votre boutique Shopify (sans https://)
SHOPIFY_SHOP_DOMAIN=votre-boutique.myshopify.com

# Token d'accès Admin API
# Obtenir dans: Shopify Admin > Settings > Apps > Develop apps
# Permissions requises: write_metafield_definitions, read_metafield_definitions
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
