  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Font Settings"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "assistant_n4",
        "info": "Used for all headings (H1, H2, H3, etc.)"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "assistant_n4",
        "info": "Used for body text and paragraphs"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "Base Font Size (px)",
        "min": 14,
        "max": 20,
        "step": 1,
        "default": 16
      },
      {
        "type": "select",
        "id": "line_height_base",
        "label": "Base Line Height",
        "options": [
          {
            "value": "1.4",
            "label": "Tight (1.4)"
          },
          {
            "value": "1.6",
            "label": "Normal (1.6)"
          },
          {
            "value": "1.8",
            "label": "Relaxed (1.8)"
          }
        ],
        "default": "1.6"
      },
      {
        "type": "header",
        "content": "Espacement des titres de section"
      },
      {
        "type": "range",
        "id": "section_title_margin_bottom",
        "label": "Espace apres les titres de section (px)",
        "min": 8,
        "max": 60,
        "step": 4,
        "default": 24,
        "unit": "px",
        "info": "Espacement uniforme sous les titres H2 de chaque section"
      },
      {
        "type": "header",
        "content": "Custom Fonts / Polices Personnalisées"
      },
      {
        "type": "checkbox",
        "id": "use_custom_font_heading",
        "label": "Use custom heading font / Utiliser police personnalisée pour titres",
        "default": false,
        "info": "Override the Heading Font with a custom font"
      },
      {
        "type": "text",
        "id": "custom_font_heading_name",
        "label": "Custom Heading Font Name / Nom de la police",
        "info": "Example: 'Montserrat', 'Open Sans', 'MyCustomFont'",
        "placeholder": "Montserrat"
      },
      {
        "type": "url",
        "id": "custom_font_heading_url",
        "label": "Google Fonts URL / URL Google Fonts",
        "info": "Get URL from fonts.google.com - Example: https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap"
      },
      {
        "type": "checkbox",
        "id": "use_custom_font_body",
        "label": "Use custom body font / Utiliser police personnalisée pour texte",
        "default": false,
        "info": "Override the Body Font with a custom font"
      },
      {
        "type": "text",
        "id": "custom_font_body_name",
        "label": "Custom Body Font Name / Nom de la police",
        "info": "Example: 'Roboto', 'Lato', 'MyCustomFont'",
        "placeholder": "Roboto"
      },
      {
        "type": "url",
        "id": "custom_font_body_url",
        "label": "Google Fonts URL / URL Google Fonts",
        "info": "Get URL from fonts.google.com - Example: https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap"
      },
      {
        "type": "header",
        "content": "Advanced: Upload Custom Font Files"
      },
      {
        "type": "paragraph",
        "content": "Pour uploader vos propres fichiers de police (.woff2, .woff):\n1. Allez dans 'Content > Files' dans Shopify Admin\n2. Uploadez vos fichiers .woff2 et .woff\n3. Copiez les URLs des fichiers\n4. Ajoutez le code CSS dans 'Custom CSS' ci-dessous avec @font-face"
      },
      {
        "type": "textarea",
        "id": "custom_font_css",
        "label": "Custom Font CSS (@font-face)",
        "info": "Add @font-face declarations here for uploaded font files",
        "placeholder": "@font-face {\n  font-family: 'MyCustomFont';\n  src: url('https://cdn.shopify.com/.../font.woff2') format('woff2'),\n       url('https://cdn.shopify.com/.../font.woff') format('woff');\n  font-weight: 400;\n  font-style: normal;\n}"
      }
    ]
  },
  {
    "name": "Logo & Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo Image",
        "info": "Recommended: 400x100px, transparent PNG"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo Width (px)",
        "min": 100,
        "max": 300,
        "step": 10,
        "default": 180
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Recommended: 32x32px PNG"
