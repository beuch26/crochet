{%- comment -%}
  Customer Reset Password Template
{%- endcomment -%}

<div class="customer-reset-password section">
  <div class="container">
    <div class="customer-form-wrapper">

      <header class="customer-header">
        <h1>{{ 'customer.reset_password.title' | t }}</h1>
        <p>{{ 'customer.reset_password.subtext' | t }}</p>
      </header>

      <div class="customer-form customer-form--centered">
        {%- form 'reset_customer_password', novalidate: 'novalidate', class: 'form' -%}
          {%- if form.errors -%}
            <div class="form-errors">
              <h3 class="form-errors__title">
                {{ 'customer.reset_password.error' | t }}
              </h3>
              <ul class="form-errors__list">
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="form-group">
            <label for="reset-password">
              {{ 'customer.reset_password.password' | t }} <span class="required">*</span>
            </label>
            <input
              type="password"
              name="customer[password]"
              id="reset-password"
              autocomplete="new-password"
              required
              {%- if form.errors contains 'password' %}aria-invalid="true"{% endif %}
            >
            <p class="form-help">
              {{ 'customer.reset_password.password_help' | t | default: 'Must be at least 5 characters' }}
            </p>
          </div>

          <div class="form-group">
            <label for="reset-password-confirmation">
              {{ 'customer.reset_password.password_confirm' | t }} <span class="required">*</span>
            </label>
            <input
              type="password"
              name="customer[password_confirmation]"
              id="reset-password-confirmation"
              autocomplete="new-password"
              required
              {%- if form.errors contains 'password_confirmation' %}aria-invalid="true"{% endif %}
            >
          </div>

          <button type="submit" class="btn btn--primary btn--full btn--large">
            {{ 'customer.reset_password.submit' | t }}
          </button>

          <div class="form-footer">
            <a href="{{ routes.account_login_url }}">{{ 'customer.reset_password.cancel' | t }}</a>
          </div>
        {%- endform -%}
      </div>

    </div>
  </div>
</div>

<style>
.customer-reset-password {
  padding: var(--spacing-2xl) 0;
  min-height: 60vh;
}

.customer-header p {
  color: var(--color-text-light);
  font-size: 1rem;
  margin-top: 0.5rem;
}
</style>
