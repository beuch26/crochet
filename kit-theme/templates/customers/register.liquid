{%- comment -%}
  Customer Registration Template
{%- endcomment -%}

<div class="customer-register section">
  <div class="container">
    <div class="customer-form-wrapper">

      <header class="customer-header">
        <h1>{{ 'customer.register.title' | t }}</h1>
      </header>

      <div class="customer-form customer-form--centered">
        {%- form 'create_customer', novalidate: 'novalidate', class: 'form' -%}
          {%- if form.errors -%}
            <div class="form-errors">
              <h3 class="form-errors__title">
                {{ 'customer.register.error' | t }}
              </h3>
              <ul class="form-errors__list">
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      <a href="#{{ field }}">
                        {{ form.errors.translated_fields[field] | capitalize }}
                        {{ form.errors.messages[field] }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="form-group">
            <label for="register-first-name">
              {{ 'customer.register.first_name' | t }} <span class="required">*</span>
            </label>
            <input
              type="text"
              name="customer[first_name]"
              id="register-first-name"
              autocomplete="given-name"
              required
              {%- if form.errors contains 'first_name' %}aria-invalid="true"{% endif %}
              value="{{ form.first_name }}"
            >
          </div>

          <div class="form-group">
            <label for="register-last-name">
              {{ 'customer.register.last_name' | t }} <span class="required">*</span>
            </label>
            <input
              type="text"
              name="customer[last_name]"
              id="register-last-name"
              autocomplete="family-name"
              required
              {%- if form.errors contains 'last_name' %}aria-invalid="true"{% endif %}
              value="{{ form.last_name }}"
            >
          </div>

          <div class="form-group">
            <label for="register-email">
              {{ 'customer.register.email' | t }} <span class="required">*</span>
            </label>
            <input
              type="email"
              name="customer[email]"
              id="register-email"
              autocomplete="email"
              autocapitalize="off"
              required
              {%- if form.errors contains 'email' %}aria-invalid="true"{% endif %}
              value="{{ form.email }}"
            >
          </div>

          <div class="form-group">
            <label for="register-password">
              {{ 'customer.register.password' | t }} <span class="required">*</span>
            </label>
            <input
              type="password"
              name="customer[password]"
              id="register-password"
              autocomplete="new-password"
              required
              {%- if form.errors contains 'password' %}aria-invalid="true"{% endif %}
            >
            <p class="form-help">
              {{ 'customer.register.password_help' | t | default: 'Must be at least 5 characters' }}
            </p>
          </div>

          <div class="form-group form-group--checkbox">
            <label>
              <input
                type="checkbox"
                name="customer[accepts_marketing]"
                id="register-accepts-marketing"
              >
              {{ 'customer.register.accepts_marketing' | t }}
            </label>
          </div>

          <button type="submit" class="btn btn--primary btn--full btn--large">
            {{ 'customer.register.submit' | t }}
          </button>

          <div class="form-footer">
            <p>
              {{ 'customer.register.already_have_account' | t }}
              <a href="{{ routes.account_login_url }}">{{ 'customer.register.sign_in' | t }}</a>
            </p>
          </div>
        {%- endform -%}
      </div>

    </div>
  </div>
</div>

<style>
.customer-register {
  padding: var(--spacing-2xl) 0;
  min-height: 60vh;
}

.customer-form--centered {
  max-width: 500px;
  margin: 0 auto;
}

.form-group--checkbox {
  display: flex;
  align-items: center;
}

.form-group--checkbox label {
  display: flex;
  align-items: center;
  font-weight: 400;
  cursor: pointer;
}

.form-group--checkbox input[type="checkbox"] {
  width: auto;
  margin-right: 0.5rem;
}

.form-help {
  font-size: 0.75rem;
  color: var(--color-text-light);
  margin-top: 0.25rem;
}

.form-footer {
  margin-top: var(--spacing-lg);
  text-align: center;
  padding-top: var(--spacing-md);
  border-top: 1px solid var(--color-border);
}

.form-footer p {
  font-size: 0.875rem;
  color: var(--color-text-light);
  margin: 0;
}

.form-footer a {
  color: var(--color-primary);
  text-decoration: none;
  font-weight: 600;
}

.form-footer a:hover {
  text-decoration: underline;
}
</style>
